{
  "name": "@cssints/tokens",
  "version": "0.3.0",
  "description": "Token sets for cssints as DTCG data: open-props, Radix colors, Flexoki, Reasonable Colors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./open-props": {
      "types": "./dist/open-props.d.mts",
      "development": {
        "types": "./src/open-props.ts",
        "default": "./src/open-props.ts"
      },
      "default": "./dist/open-props.mjs"
    },
    "./radix": {
      "types": "./dist/radix.d.mts",
      "development": {
        "types": "./src/radix.ts",
        "default": "./src/radix.ts"
      },
      "default": "./dist/radix.mjs"
    },
    "./flexoki": {
      "types": "./dist/flexoki.d.mts",
      "development": {
        "types": "./src/flexoki.ts",
        "default": "./src/flexoki.ts"
      },
      "default": "./dist/flexoki.mjs"
    },
    "./reasonable-colors": {
      "types": "./dist/reasonable-colors.d.mts",
      "development": {
        "types": "./src/reasonable-colors.ts",
        "default": "./src/reasonable-colors.ts"
      },
      "default": "./dist/reasonable-colors.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./open-props": {
        "types": "./dist/open-props.d.mts",
        "default": "./dist/open-props.mjs"
      },
      "./radix": {
        "types": "./dist/radix.d.mts",
        "default": "./dist/radix.mjs"
      },
      "./flexoki": {
        "types": "./dist/flexoki.d.mts",
        "default": "./dist/flexoki.mjs"
      },
      "./reasonable-colors": {
        "types": "./dist/reasonable-colors.d.mts",
        "default": "./dist/reasonable-colors.mjs"
      }
    },
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "generate": "node scripts/generate.ts && vp fmt src",
    "test": "node test/tokens.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "@radix-ui/colors": "3.0.0",
    "cssints": "workspace:*",
    "open-props": "1.7.23",
    "reasonable-colors": "0.4.0",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
