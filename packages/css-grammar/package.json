{
  "name": "@cssints/css-grammar",
  "version": "0.19.0",
  "description": "Type-level and runtime recognizer of CSS values over mdn-data grammars (the engine of cssints)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/css-grammar"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "development": {
        "types": "./src/*.ts",
        "default": "./src/*.ts"
      },
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/check.ts && node test/check-typed.ts && node test/check-queries.ts && node test/check-selector.ts && node test/check-support.ts && node ../../node_modules/typescript/bin/tsc -p tsconfig.tsc.json",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "bench": "node bench/budget.mjs",
    "extract": "node scripts/extract.mjs && node scripts/keywords.ts",
    "webref": "node scripts/webref-rule.mjs",
    "longhands": "node scripts/longhands.mjs",
    "diff": "node test/diff.ts",
    "diff:support": "node test/diff-support.ts",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "@mdn/browser-compat-data": "8.1.3",
    "browserslist": "4.29.1",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@webref/css": "8.7.5",
    "fast-check": "^4.10.2",
    "mdn-data": "2.27.1",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=22"
  }
}
