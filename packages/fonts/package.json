{
  "name": "@cssints/fonts",
  "version": "0.4.0",
  "description": "Fonts for cssints: @font-face rules with a metric-matched fallback face, and cap-height trimming",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/fonts.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "fontkitten": "^1.0.3"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/unpack": "^4.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
