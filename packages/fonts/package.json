{
  "name": "@cssints/fonts",
  "version": "0.1.0",
  "private": true,
  "description": "Fonts for cssints: @font-face rules with a metric-matched fallback face, and cap-height trimming",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/fonts.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "pack:tgz": "node ../../scripts/pack.mjs"
  },
  "dependencies": {
    "fontkitten": "^1.0.3"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/unpack": "^4.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
