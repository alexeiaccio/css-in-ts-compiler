{
  "name": "@cssints/tui",
  "version": "0.10.0",
  "description": "Deprecated: the terminal target in the cssints repository's native/ replaces this. Kept for existing apps: the runtime of cssints/tui styles (states, cursors, themes) and its OpenTUI and @bomb.sh/tty adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/tui"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./opentui": {
      "development": {
        "types": "./src/opentui.ts",
        "default": "./src/opentui.ts"
      },
      "types": "./dist/opentui.d.mts",
      "default": "./dist/opentui.mjs"
    },
    "./bomb": {
      "development": {
        "types": "./src/bomb.ts",
        "default": "./src/bomb.ts"
      },
      "types": "./dist/bomb.d.mts",
      "default": "./dist/bomb.mjs"
    },
    "./system": {
      "development": {
        "types": "./src/system.ts",
        "default": "./src/system.ts"
      },
      "types": "./dist/system.d.mts",
      "default": "./dist/system.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./opentui": {
        "types": "./dist/opentui.d.mts",
        "default": "./dist/opentui.mjs"
      },
      "./bomb": {
        "types": "./dist/bomb.d.mts",
        "default": "./dist/bomb.mjs"
      },
      "./system": {
        "types": "./dist/system.d.mts",
        "default": "./dist/system.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/system.ts && node --conditions=development test/tui.mjs && bun test/render.ts && node test/bomb.ts",
    "example": "node examples/run.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@bomb.sh/tty": "0.9.0",
    "@opentui/core": "0.5.17",
    "@types/culori": "^4.0.1",
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@bomb.sh/tty": ">=0.9.0",
    "@opentui/core": ">=0.5.17",
    "cssints": "^0.10.0"
  },
  "peerDependenciesMeta": {
    "@bomb.sh/tty": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
