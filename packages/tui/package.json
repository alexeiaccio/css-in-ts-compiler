{
  "name": "@cssints/tui",
  "version": "0.1.0",
  "private": true,
  "description": "cssints in a terminal: the runtime of cssints/tui styles (states, cursors, themes) and its OpenTUI and @bomb.sh/tty adapters",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./opentui": {
      "development": {
        "types": "./src/opentui.ts",
        "default": "./src/opentui.ts"
      },
      "types": "./dist/opentui.d.mts",
      "default": "./dist/opentui.mjs"
    },
    "./bomb": {
      "development": {
        "types": "./src/bomb.ts",
        "default": "./src/bomb.ts"
      },
      "types": "./dist/bomb.d.mts",
      "default": "./dist/bomb.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./opentui": {
        "types": "./dist/opentui.d.mts",
        "default": "./dist/opentui.mjs"
      },
      "./bomb": {
        "types": "./dist/bomb.d.mts",
        "default": "./dist/bomb.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node --conditions=development test/tui.mjs && bun test/render.ts && node test/bomb.ts",
    "example": "node examples/run.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "pack:tgz": "node ../../scripts/pack.mjs"
  },
  "devDependencies": {
    "@bomb.sh/tty": "0.9.0",
    "@opentui/core": "0.5.17",
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@bomb.sh/tty": ">=0.9.0",
    "@opentui/core": ">=0.5.17",
    "cssints": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@bomb.sh/tty": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
