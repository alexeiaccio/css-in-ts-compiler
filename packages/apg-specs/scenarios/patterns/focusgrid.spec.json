{
  "pattern": "focusgrid",
  "source": "spec",
  "commit": null,
  "license": "MIT",
  "notes": "Written from specs/patterns/focusgrid.qnt: the platform contract of focusgroup=\"grid\" (V2). Parts are grid (the owner) and cell:<row>,<col> (the twelve cell targets of the 3x4 body). Keys are dispatched to the focused element, so a key step names grid and never a cell; focus/click on a cell is the model's click, and blur/focus on the grid are focus_out/focus_in. Config keys: rowEdge and colEdge (none|wrap|flow, the RESOLVED per-axis edges), memory, manual, start (the focusgroupstart cell).",
  "skipped": [
    {
      "id": "focusgrid.spec.spans-and-ragged-rows",
      "reason": "the V2 initial model is rectangular and spanless; an invalid body contributes no behaviour at all, which is the runtime's validity check and the browser test's ragged fixture, not a state"
    },
    {
      "id": "focusgrid.spec.virtualisation",
      "reason": "where the rows are mounted is the host's window (grid.qnt's rowWindow); the contract only sees coordinates"
    },
    {
      "id": "focusgrid.spec.edit-selection-activation",
      "reason": "V2 navigation moves focus only; edit (Enter/F2/Escape), aria-selected and activation stay the widget's, and grid.qnt keeps them"
    },
    {
      "id": "focusgrid.spec.itemcontrols",
      "reason": "a grid owner has itemcontrols by default and it is unsupported in the polyfill's main (PR #66); nested controls are not filtered and are not modelled"
    },
    {
      "id": "focusgrid.spec.tab-and-shift-tab",
      "reason": "HTML sequential navigation, not a spatial relationship: the grid only sees the focusout/focusin pair, which the blur/focus steps model"
    },
    {
      "id": "focusgrid.spec.page-up-and-down",
      "reason": "a grid defines no page movement (the APG data grid's PageUp/PageDown is a widget extra, grid.qnt's PAGE)"
    },
    {
      "id": "focusgrid.spec.key-conflict-controls",
      "reason": "a native key-conflict cell target (input, textarea, select, contenteditable, iframe, object) keeps the command its native behaviour claims: a property of an element, checked by the runtime's guard in the browser test"
    },
    {
      "id": "focusgrid.spec.writing-modes-and-rtl",
      "reason": "the explainer resolves inline/block through the owner's computed writing mode and direction; this contract assumes left-to-right, horizontal-tb"
    },
    {
      "id": "focusgrid.spec.aria-roles-and-indices",
      "reason": "role inference (grid, row, gridcell) and aria-rowindex/aria-colindex are ARIA, not focus; authored ARIA never configures topology"
    },
    {
      "id": "focusgrid.spec.token-conflicts",
      "reason": "the definition takes resolved per-axis edges, so the token grammar's conflicts (wrap flow, nowrap with either) cannot arise; the attribute we emit is canonical"
    }
  ],
  "scenarios": [
    {
      "id": "focusgrid.spec.initial",
      "apg": "extension",
      "config": {},
      "steps": [
        {
          "expect": {
            "focus": null,
            "attrs": {
              "grid": { "focusgroup": "grid" },
              "cell:0,0": { "tabindex": "0", "focusgroupstart": "true" },
              "cell:0,1": { "tabindex": "-1", "focusgroupstart": null },
              "cell:2,3": { "tabindex": "-1" }
            }
          }
        },
        {
          "event": "focus",
          "target": "grid"
        },
        {
          "expect": {
            "focus": "cell:0,0",
            "attrs": { "cell:0,0": { "tabindex": "0" } }
          }
        }
      ]
    },
    {
      "id": "focusgrid.spec.hard-edges",
      "apg": "extension",
      "config": {},
      "steps": [
        { "event": "focus", "target": "grid" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        {
          "expect": {
            "focus": "cell:0,3",
            "attrs": { "cell:0,3": { "tabindex": "0" }, "cell:0,2": { "tabindex": "-1" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:0,3" } },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        {
          "expect": {
            "focus": "cell:2,3",
            "attrs": { "cell:2,3": { "tabindex": "0" } }
          }
        }
      ]
    },
    {
      "id": "focusgrid.spec.row-ends-and-grid-ends",
      "apg": "extension",
      "config": {},
      "steps": [
        { "event": "click", "target": "cell:1,2" },
        { "event": "key", "key": "Home", "target": "grid" },
        { "expect": { "focus": "cell:1,0" } },
        { "event": "key", "key": "End", "target": "grid" },
        { "expect": { "focus": "cell:1,3" } },
        { "event": "key", "key": "Control+Home", "target": "grid" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "key", "key": "Control+End", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } },
        { "event": "key", "key": "Control+End", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } }
      ]
    },
    {
      "id": "focusgrid.spec.rowwrap",
      "apg": "extension",
      "config": { "rowEdge": "wrap" },
      "steps": [
        {
          "expect": {
            "attrs": { "grid": { "focusgroup": "grid rowwrap" } }
          }
        },
        { "event": "click", "target": "cell:0,3" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "key", "key": "ArrowLeft", "target": "grid" },
        { "expect": { "focus": "cell:0,3" } },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:1,3" } },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } }
      ]
    },
    {
      "id": "focusgrid.spec.rowflow",
      "apg": "extension",
      "config": { "rowEdge": "flow" },
      "steps": [
        {
          "expect": {
            "attrs": { "grid": { "focusgroup": "grid rowflow" } }
          }
        },
        { "event": "click", "target": "cell:0,3" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:1,0" } },
        { "event": "click", "target": "cell:0,0" },
        { "event": "key", "key": "ArrowLeft", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } },
        { "event": "click", "target": "cell:2,3" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:0,0" } }
      ]
    },
    {
      "id": "focusgrid.spec.colwrap",
      "apg": "extension",
      "config": { "colEdge": "wrap" },
      "steps": [
        {
          "expect": {
            "attrs": { "grid": { "focusgroup": "grid colwrap" } }
          }
        },
        { "event": "click", "target": "cell:2,1" },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:0,1" } },
        { "event": "key", "key": "ArrowUp", "target": "grid" },
        { "expect": { "focus": "cell:2,1" } },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:2,2" } }
      ]
    },
    {
      "id": "focusgrid.spec.colflow",
      "apg": "extension",
      "config": { "colEdge": "flow" },
      "steps": [
        {
          "expect": {
            "attrs": { "grid": { "focusgroup": "grid colflow" } }
          }
        },
        { "event": "click", "target": "cell:2,1" },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:0,2" } },
        { "event": "click", "target": "cell:0,2" },
        { "event": "key", "key": "ArrowUp", "target": "grid" },
        { "expect": { "focus": "cell:2,1" } },
        { "event": "click", "target": "cell:2,3" },
        { "event": "key", "key": "ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:0,0" } }
      ]
    },
    {
      "id": "focusgrid.spec.memory",
      "apg": "extension",
      "config": {},
      "steps": [
        { "event": "focus", "target": "grid" },
        { "event": "click", "target": "cell:1,2" },
        { "event": "blur", "target": "grid" },
        {
          "expect": {
            "focus": null,
            "attrs": { "cell:1,2": { "tabindex": "0" }, "cell:0,0": { "tabindex": "-1" } }
          }
        },
        { "event": "focus", "target": "grid" },
        { "expect": { "focus": "cell:1,2" } }
      ]
    },
    {
      "id": "focusgrid.spec.nomemory",
      "apg": "extension",
      "config": { "memory": false },
      "steps": [
        {
          "expect": { "attrs": { "grid": { "focusgroup": "grid nomemory" } } }
        },
        { "event": "click", "target": "cell:1,2" },
        { "event": "blur", "target": "grid" },
        {
          "expect": {
            "focus": null,
            "attrs": { "cell:0,0": { "tabindex": "0" }, "cell:1,2": { "tabindex": "-1" } }
          }
        },
        { "event": "focus", "target": "grid" },
        { "expect": { "focus": "cell:0,0" } }
      ]
    },
    {
      "id": "focusgrid.spec.focusgroupstart",
      "apg": "extension",
      "config": { "start": 5 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "cell:1,1": { "tabindex": "0", "focusgroupstart": "true" },
              "cell:0,0": { "tabindex": "-1", "focusgroupstart": null }
            }
          }
        },
        { "event": "focus", "target": "grid" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "blur", "target": "grid" },
        { "event": "click", "target": "cell:2,2" },
        { "event": "blur", "target": "grid" },
        { "event": "focus", "target": "grid" },
        { "expect": { "focus": "cell:2,2" } }
      ]
    },
    {
      "id": "focusgrid.spec.manual-follows-the-same-contract",
      "apg": "extension",
      "config": { "manual": true },
      "steps": [
        {
          "expect": { "attrs": { "grid": { "focusgroup": "grid manual" } } }
        },
        { "event": "click", "target": "cell:1,1" },
        { "event": "key", "key": "ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:1,2" } },
        { "event": "key", "key": "End", "target": "grid" },
        { "expect": { "focus": "cell:1,3" } }
      ]
    },
    {
      "id": "focusgrid.spec.modified-keys-are-ignored",
      "apg": "extension",
      "config": {},
      "steps": [
        { "event": "click", "target": "cell:1,1" },
        { "event": "key", "key": "Shift+ArrowRight", "target": "grid" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "key", "key": "Alt+Home", "target": "grid" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "key", "key": "Meta+ArrowDown", "target": "grid" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "key", "key": "Control+End", "target": "grid" },
        { "expect": { "focus": "cell:2,3" } }
      ]
    }
  ]
}
