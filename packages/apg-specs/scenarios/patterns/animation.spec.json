      "apg": "extension",
      "config": {},
      "notes": "CancelledFinishIgnored and StaleCarriesCancelled: the opening effect is cancelled by a close, and its late completion carries the cancelled handle (1) and moves nothing; only the live effect's completion settles",
      "steps": [
        {
          "event": "click",
          "target": "trigger"
        },
        {
          "event": "prop",
          "prop": "open",
          "value": false
        },
        {
          "event": "finishStale"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closing",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "content": {
                "data-state": "closing",
                "hidden": null
              }
            }
          }
        },
        {
          "event": "finish"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closed",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            }
          }
        }
      ]
    },
    {
      "id": "animation.spec.reversal-keeps-position",
      "apg": "extension",
      "config": {},
      "notes": "ReversalKeepsPosition: after two frames the box is at 2; the close starts from 2, not from 4 (it does not finish the opening) and not from 0 (it does not start over), and the next frame walks down from there",
      "steps": [
        {
          "event": "click",
          "target": "trigger"
        },
        {
          "event": "frame"
        },
        {
          "event": "frame"
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "opening",
              "committed": "closed",
              "progress": 2,
              "optimistic": true
            }
          }
        },
        {
          "event": "prop",
          "prop": "open",
          "value": false
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closing",
              "committed": "closed",
              "progress": 2,
              "optimistic": false
            }
          }
        },
        {
          "event": "frame"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closing",
              "committed": "closed",
              "progress": 1,
              "optimistic": false
            }
          }
        },
        {
          "event": "finish"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closed",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "content": {
                "data-state": "closed",
                "hidden": "true"
              }
            }
          }
        }
      ]
    },
    {
      "id": "animation.spec.reversal-flips-direction",
      "apg": "extension",
      "config": {},
      "notes": "ReversalKeepsPosition and NoStaleOptimistic: a close interrupted at progress 2 by an open flips the direction to opening (the box is at 2, not at the committed end) and the live effect settles at open",
      "steps": [
        {
          "event": "click",
          "target": "trigger"
        },
        {
          "event": "finish"
        },
        {
          "event": "prop",
          "prop": "open",
          "value": false
