    },
    {
      "id": "animation.spec.a-burst-ending-in-leave",
      "apg": "extension",
      "config": {},
      "notes": "DebounceKeepsLast from open: the burst's last intent is a leave, so the coalesced commit closes, not opens (the first enter of the burst is not the one that lands)",
