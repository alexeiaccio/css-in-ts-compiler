        {
          "expect": {
            "value": {
              "open": true,
              "state": "opening",
              "committed": "open",
              "progress": 2,
              "optimistic": false
            }
          }
        },
        {
          "event": "finish"
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "open",
              "committed": "open",
              "progress": 4,
              "optimistic": false
            },
            "attrs": {
              "content": {
                "data-state": "open",
                "hidden": null
              }
            }
          }
