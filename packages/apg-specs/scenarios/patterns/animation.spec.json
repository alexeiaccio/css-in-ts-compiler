      ]
    },
    {
      "id": "animation.spec.debounce-keeps-the-last-intent",
      "apg": "extension",
      "config": {},
      "notes": "CoalescingHolds and DebounceKeepsLast: a burst that ends on pointerEnter holds its intent (the box never moves while the window is open) and the commit is the burst's last intent, so the disclosure opens",
      "steps": [
        {
          "event": "pointerEnter",
          "target": "trigger"
        },
        {
          "event": "pointerLeave",
          "target": "trigger"
        },
        {
          "event": "pointerEnter",
          "target": "trigger"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closed",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "content": {
                "data-state": "closed",
                "hidden": "true"
              }
            }
          }
        },
        {
          "event": "debounce"
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "opening",
              "committed": "closed",
              "progress": 0,
              "optimistic": true
            },
            "attrs": {
              "trigger": {
                "aria-expanded": "true"
              }
