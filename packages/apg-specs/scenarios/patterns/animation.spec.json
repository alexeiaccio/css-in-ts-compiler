{
  "pattern": "animation",
  "source": "spec",
  "commit": null,
  "license": "MIT",
  "notes": "No APG pattern and no CSS specification: the source of truth is the protocol of an animated disclosure (specs/patterns/animation.qnt), the five things its `open` signal cannot hold — the race of two intents in one frame, the cancellation of a superseded effect and the ignored completion of it, the reversal that keeps the box where it is, one effect per transition, and the debounce window whose last intent always wins — plus the optimistic split between the state the host exposes (`aria-expanded`, set at the intent) and the state the machine has committed (moved only by a settle). The vocabulary is the protocol's own: `click` on the trigger toggles; `pointerEnter`/`pointerLeave` add an intent to the debounce window and `debounce` is its timer firing; `finish` is the live effect's completion and `finishStale` a cancelled effect's late one; `frame` is one animation frame; a `prop` write of `open` is a controlled host's intent and `prop reducedMotion` the media preference. Values are the spec's five-point sample of the box (`progress` 0 closed .. 4 open), not a duration.",
  "skipped": [
    {
      "id": "animation.spec.real-timing",
      "reason": "durations, easing and frame pacing: `frame` is one arbitrary frame, the grid saturates at five points, and every debounce delay is the same machine"
    },
    {
      "id": "animation.spec.waapi-completion-ordering",
      "reason": "WAAPI's own ordering — `Animation.finished` resolving after `cancel()`, a rejected promise, `transitionend` for one property of several — is the browser's; `finish`/`finishStale` are its reduced form"
    },
    {
      "id": "animation.spec.css-properties",
      "reason": "grid-template-rows, opacity, translate, @starting-style and transition-behavior are the sheet's; the model knows `hidden`, not how the content paints"
    },
    {
      "id": "animation.spec.hover-plumbing",
      "reason": "pointerenter/pointerleave capture, touch and a hover that is really a focus arrive as hover_in/hover_out; the primitive's listeners are the DOM test's"
    },
    {
      "id": "animation.spec.focus-and-nesting",
      "reason": "focus and inert on the closed content, aria-controls (fixed here), nested disclosures and the host's createOptimisticStore calls are other layers"
    }
  ],
  "scenarios": [
    {
      "id": "animation.spec.initial",
      "apg": "extension",
      "config": {},
      "notes": "before any intent: closed, committed closed, hidden, no effect",
      "steps": [
        {
          "expect": {
            "focus": null,
            "value": {
              "open": false,
              "state": "closed",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "trigger": {
                "aria-expanded": "false"
              },
              "content": {
                "data-state": "closed",
                "hidden": "true"
              }
            }
          }
        }
      ]
    },
    {
      "id": "animation.spec.race-open-then-close",
      "apg": "extension",
      "config": {},
      "notes": "LastIntentWins and OneEffectPerState: two intents in one frame end at the last one; the second replaces the first effect's handle, so one effect runs, and the box never left progress 0",
      "steps": [
        {
          "event": "prop",
          "prop": "open",
          "value": true
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "opening",
              "committed": "closed",
              "progress": 0,
              "optimistic": true
            },
            "attrs": {
              "trigger": {
                "aria-expanded": "true"
              },
              "content": {
                "data-state": "opening",
                "hidden": null
              }
            }
          }
        },
        {
          "event": "prop",
          "prop": "open",
          "value": false
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closing",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "trigger": {
                "aria-expanded": "false"
              },
              "content": {
                "data-state": "closing",
                "hidden": null
              }
            }
          }
        },
        {
          "event": "finish"
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closed",
              "committed": "closed",
              "progress": 0,
              "optimistic": false
            },
            "attrs": {
              "content": {
                "data-state": "closed",
                "hidden": "true"
              }
            }
          }
        }
      ]
    },
    {
      "id": "animation.spec.race-close-then-open",
      "apg": "extension",
      "config": {},
      "notes": "LastIntentWins the other way round: from open, a close and then an open in one frame settle open again, from the box's end (progress 4), not from closed",
      "steps": [
        {
          "event": "prop",
          "prop": "open",
          "value": true
        },
        {
          "event": "finish"
        },
        {
          "event": "prop",
          "prop": "open",
          "value": false
        },
        {
          "expect": {
            "value": {
              "open": false,
              "state": "closing",
              "committed": "open",
              "progress": 4,
              "optimistic": true
            }
          }
        },
        {
          "event": "prop",
          "prop": "open",
          "value": true
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "opening",
              "committed": "open",
              "progress": 4,
              "optimistic": false
            },
            "attrs": {
              "trigger": {
                "aria-expanded": "true"
              },
              "content": {
                "data-state": "opening",
                "hidden": null
              }
            }
          }
        },
        {
          "event": "finish"
        },
        {
          "expect": {
            "value": {
              "open": true,
              "state": "open",
              "committed": "open",
              "progress": 4,
              "optimistic": false
            }
          }
        }
      ]
    },
    {
