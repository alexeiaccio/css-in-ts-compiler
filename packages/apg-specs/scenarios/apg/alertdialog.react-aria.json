      "upstreamTest": "AlertDialog > autofocus its cancel button",
      "apg": "focus",
      "config": {
        "variant": "confirmation",
        "cancelLabel": "cancel",
        "autoFocusButton": "cancel"
      },
      "steps": [{ "expect": { "focus": "cancel" } }]
    },
    {
