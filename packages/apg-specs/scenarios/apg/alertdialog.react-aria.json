      "reason": "React-API-only props that do not change observed behaviour (title/data-testid plumbing asserted purely structurally)"
    }
  ],
  "scenarios": [
    {
      "id": "alertdialog.react-aria.primary-action-callback",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L21",
      "upstreamTest": "AlertDialog > renders alert dialog with onPrimaryAction",
      "apg": "wai-aria",
      "config": { "variant": "confirmation" },
      "steps": [
        { "expect": { "visible": ["dialog"], "focus": "dialog" } },
        { "event": "click", "target": "confirm" },
        { "expect": { "events": { "onPrimaryAction": [1] } } }
      ]
    },
    {
      "id": "alertdialog.react-aria.two-button-cancel-and-confirm",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L45",
      "upstreamTest": "AlertDialog > renders 2 button alert dialog with onPrimaryAction / onCancel",
      "apg": "wai-aria",
      "config": { "variant": "confirmation", "cancelLabel": "cancel" },
      "steps": [
        { "expect": { "visible": ["dialog"], "focus": "dialog" } },
        { "event": "click", "target": "cancel" },
        { "expect": { "events": { "onCancel": [1], "onPrimaryAction": [] } } },
        { "event": "click", "target": "confirm" },
        { "expect": { "events": { "onPrimaryAction": [1], "onCancel": [1] } } }
      ]
    },
    {
      "id": "alertdialog.react-aria.three-button-callbacks",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L79",
      "upstreamTest": "AlertDialog > renders a 3 button alert dialog with onPrimaryAction / onCancel",
      "apg": "wai-aria",
      "config": {
        "variant": "confirmation",
        "secondaryActionLabel": "secondary",
        "cancelLabel": "cancel"
      },
      "steps": [
        { "expect": { "focus": "dialog" } },
        { "event": "click", "target": "secondary" },
        {
          "expect": { "events": { "onSecondaryAction": [1], "onCancel": [] } }
        },
        { "event": "click", "target": "confirm" },
        { "expect": { "events": { "onPrimaryAction": [1], "onCancel": [] } } },
        { "event": "click", "target": "cancel" },
        { "expect": { "events": { "onCancel": [1], "onPrimaryAction": [1] } } }
      ]
    },
    {
      "id": "alertdialog.react-aria.disabled-confirm-not-fired",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L122",
      "upstreamTest": "AlertDialog > disable its confirm button",
      "apg": "extension",
      "config": { "variant": "confirmation", "isPrimaryActionDisabled": true },
      "steps": [
        { "expect": { "focus": "dialog" } },
        { "event": "click", "target": "confirm" },
        { "expect": { "events": { "onPrimaryAction": [] } } }
      ]
    },
    {
      "id": "alertdialog.react-aria.autofocus-confirm-button",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L146",
      "upstreamTest": "AlertDialog > autofocus its confirm button",
      "apg": "focus",
      "config": { "variant": "confirmation", "autoFocusButton": "primary" },
      "steps": [{ "expect": { "focus": "confirm" } }]
    },
    {
