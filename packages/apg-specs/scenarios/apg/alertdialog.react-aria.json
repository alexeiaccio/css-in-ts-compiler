      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L181",
      "upstreamTest": "AlertDialog > disable its secondary button",
      "apg": "extension",
      "config": {
        "variant": "confirmation",
        "isSecondaryActionDisabled": true
      },
      "steps": [
        { "expect": { "focus": "dialog" } },
        { "event": "click", "target": "secondary" },
        { "expect": { "events": { "onPrimaryAction": [] } } }
      ]
    },
    {
      "id": "alertdialog.react-aria.autofocus-secondary-button",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L206",
      "upstreamTest": "AlertDialog > autofocus its secondary button",
      "apg": "focus",
      "config": {
        "variant": "confirmation",
        "secondaryActionLabel": "secondary",
        "autoFocusButton": "secondary"
      },
      "steps": [{ "expect": { "focus": "secondary" } }]
    },
    {
      "id": "alertdialog.react-aria.aria-describedby-points-to-content",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L250",
      "upstreamTest": "AlertDialog > should have aria-describedby pointing to the content",
      "apg": "wai-aria",
      "config": { "variant": "confirmation" },
      "steps": [
        {
          "expect": {
            "attrs": {
              "dialog": { "role": "alertdialog", "aria-describedby": "content" }
            }
          }
        }
      ]
    },
    {
      "id": "alertdialog.react-aria.aria-describedby-custom",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/dialog/AlertDialog.test.js#L267",
      "upstreamTest": "AlertDialog > accepts custom aria-describedby",
      "apg": "wai-aria",
      "config": { "variant": "confirmation", "ariaDescribedby": "content-id" },
      "steps": [
        {
          "expect": {
            "attrs": { "dialog": { "aria-describedby": "content-id" } }
          }
        }
      ]
    },
    {
      "id": "alertdialog.react-aria.components-role-alertdialog",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Dialog.test.js#L54",
      "upstreamTest": "Dialog > works with modal",
      "apg": "wai-aria",
      "config": { "modal": true, "role": "alertdialog" },
      "steps": [
        { "event": "click", "target": "trigger" },
        {
          "expect": {
            "visible": ["dialog"],
            "attrs": {
              "dialog": { "role": "alertdialog", "aria-labelledby": "title" }
            }
          }
        },
        { "event": "click", "target": "dismiss" },
        { "expect": { "hidden": ["dialog"] } }
      ]
    },
    {
      "id": "alertdialog.react-aria.use-dialog-describedby-from-content",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/dialog/useDialog.test.js#L73",
      "upstreamTest": "useDialog > should set aria-describedby on alertdialog when content is rendered",
      "apg": "wai-aria",
      "config": { "role": "alertdialog", "showContent": true },
      "steps": [
        {
          "expect": {
            "attrs": {
              "dialog": { "role": "alertdialog", "aria-describedby": "content" }
            }
          }
        }
      ]
    },
