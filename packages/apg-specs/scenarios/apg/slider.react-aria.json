  "scenarios": [
    {
      "id": "slider.react-aria.orientation-vertical-sets-aria-orientation",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Slider.test.js#L238",
      "upstreamTest": "Slider > should support orientation",
      "apg": "aria",
      "config": { "thumbs": 1, "value": 0, "orientation": "vertical" },
      "steps": [
        {
          "expect": {
            "attrs": { "thumb:0": { "aria-orientation": "vertical" } }
          }
        }
      ],
      "notes": "The slider group carries data-orientation; only the thumb's aria-orientation is asserted here."
    },
    {
      "id": "slider.react-aria.thumb-native-bounds-and-step",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/slider/useSliderThumb.test.js#L20",
      "upstreamTest": "useSliderThumb > aria labels > should have the right labels with Slider-level label",
      "apg": "aria",
      "config": { "thumbs": 1, "value": 50, "min": 10, "max": 200, "step": 2 },
      "steps": [
        {
          "expect": {
            "value": 50,
            "attrs": {
              "thumb:0": {
                "type": "range",
                "min": "10",
                "max": "200",
                "step": "2"
              }
            }
          }
        }
      ],
      "notes": "react-aria drives a native input[type=range]; bounds and step surface as HTML attributes, unlike base-ui which also exposes aria-valuenow."
    },
    {
      "id": "slider.react-aria.arrow-right-increments-arrow-left-decrements",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L313",
      "upstreamTest": "Slider > keyboard interactions > (left/right arrows, ltr) moves the slider in the correct direction",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 50, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        { "expect": { "value": 51 } },
        { "event": "key", "target": "thumb:0", "key": "ArrowLeft" },
        { "expect": { "value": 50 } }
      ]
    },
    {
