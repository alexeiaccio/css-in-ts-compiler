    {
      "id": "slider.react-aria.page-up-page-down-use-page-size",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L318",
      "upstreamTest": "Slider > keyboard interactions > (page up/down, ltr) moves the slider in the correct direction",
