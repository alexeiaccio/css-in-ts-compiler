    },
    {
      "id": "slider.react-aria.home-and-end-jump-to-extremes",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L320",
      "upstreamTest": "Slider > keyboard interactions > (home/end, ltr) moves the slider in the correct direction",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 50, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "Home" },
