    {
      "id": "slider.react-aria.step-size-respected-for-arrows-and-page-keys",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L362",
      "upstreamTest": "Slider > keyboard interactions > (left/right arrows, ltr) respects the step size",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 40, "step": 20, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        { "expect": { "value": 60 } },
        { "event": "key", "target": "thumb:0", "key": "ArrowLeft" },
        { "expect": { "value": 40 } },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "expect": { "value": 60 } },
        { "event": "key", "target": "thumb:0", "key": "PageDown" },
        { "expect": { "value": 40 } }
      ],
      "notes": "Page size is snapped to a multiple of the step, so PageUp moves 20, not 10."
    },
    {
      "id": "slider.react-aria.page-size-snaps-to-multiple-of-step",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L378",
      "upstreamTest": "Slider > keyboard interactions > (left/right arrows, ltr) sets page size to a multiple of step",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 50, "min": 0, "max": 230, "step": 10 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        { "expect": { "value": 60 } },
        { "event": "key", "target": "thumb:0", "key": "ArrowLeft" },
        { "expect": { "value": 50 } },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "expect": { "value": 70 } },
        { "event": "key", "target": "thumb:0", "key": "PageDown" },
        { "expect": { "value": 50 } }
      ],
      "notes": "Raw page size 230/10 = 23 snaps down to 20."
    },
    {
      "id": "slider.react-aria.page-size-snaps-when-step-below-min",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L395",
      "upstreamTest": "Slider > keyboard interactions > sets page size to a multiple of step (scenario: step is less than min)",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 60, "min": 50, "max": 75, "step": 2 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        { "expect": { "value": 62 } },
        { "event": "key", "target": "thumb:0", "key": "ArrowLeft" },
        { "expect": { "value": 60 } },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "expect": { "value": 62 } },
        { "event": "key", "target": "thumb:0", "key": "PageDown" },
        { "expect": { "value": 60 } }
      ],
      "notes": "Raw page size 25/10 = 2.5 snaps to 2."
    },
    {
      "id": "slider.react-aria.page-size-snaps-when-step-above-max",
