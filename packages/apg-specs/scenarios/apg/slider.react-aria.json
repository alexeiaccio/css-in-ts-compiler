        { "event": "pointermove", "target": "thumb:0", "position": 1.2 },
        { "expect": { "value": 100 } },
        { "event": "pointerup", "target": "thumb:0", "position": 1.2 },
        { "expect": { "events": { "onChangeEnd": [[100]] } } }
      ]
    },
    {
      "id": "slider.react-aria.disabled-blocks-pointer-and-focus",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L488",
      "upstreamTest": "Slider > mouse interactions > cannot click and drag handle when disabled",
      "apg": "extension",
      "config": {
        "thumbs": 1,
        "value": 50,
        "min": 0,
        "max": 100,
        "disabled": true
      },
      "steps": [
        { "event": "pointerdown", "target": "thumb:0", "position": 0.5 },
        { "event": "pointermove", "target": "thumb:0", "position": 0.1 },
        { "event": "pointerup", "target": "thumb:0", "position": 0.1 },
        {
          "expect": { "value": 50, "focus": null, "events": { "onChange": [] } }
        }
      ]
    },
    {
      "id": "slider.react-aria.touch-ignores-second-pointer-during-drag",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L578",
      "upstreamTest": "Slider > touch interactions > doesn't jump to second touch on track while already dragging",
      "apg": "pointer",
      "config": { "thumbs": 1, "value": 50, "min": 0, "max": 100 },
      "steps": [
        {
          "event": "pointerdown",
          "target": "thumb:0",
          "position": 0.5,
          "pointerId": 1
        },
        {
          "event": "pointerdown",
          "target": "track",
          "position": 0.6,
          "pointerId": 2
        },
        {
          "event": "pointermove",
          "target": "track",
          "position": 0.7,
          "pointerId": 2
        },
        {
          "event": "pointerup",
          "target": "track",
          "position": 0.7,
          "pointerId": 2
        },
        { "expect": { "value": 50 } },
        {
          "event": "pointermove",
          "target": "thumb:0",
          "position": 0.3,
          "pointerId": 1
        },
        { "expect": { "value": 30 } }
      ],
      "notes": "Upstream uses touch identifiers; ported as pointer ids, second pointer is ignored while the first drag is active."
    },
    {
      "id": "slider.react-aria.thumb-drag-emits-change-and-change-end",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/slider/useSliderThumb.test.js#L375",
      "upstreamTest": "useSliderThumb > interactions on thumbs, where track contains thumbs > using PointerEvents > can be moved by dragging",
      "apg": "pointer",
      "config": { "thumbs": 1, "value": 10, "min": 0, "max": 100 },
      "steps": [
        { "event": "pointerdown", "target": "thumb:0", "position": 0.1 },
        { "event": "pointermove", "target": "thumb:0", "position": 0.2 },
        { "expect": { "value": 20, "events": { "onChange": [[20]] } } },
        { "event": "pointermove", "target": "thumb:0", "position": 0.4 },
        { "event": "pointerup", "target": "thumb:0", "position": 0.4 },
        {
          "expect": {
            "value": 40,
            "events": { "onChange": [[20], [40]], "onChangeEnd": [[40]] }
          }
        }
      ]
    },
    {
      "id": "slider.react-aria.keyboard-at-min-no-change-but-change-end",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/slider/useSliderThumb.test.js#L506",
      "upstreamTest": "useSliderThumb > using KeyEvents > can be moved with keys at the beginning of the slider",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 0, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowLeft" },
        {
          "expect": {
            "value": 0,
            "events": { "onChange": [], "onChangeEnd": [[0]] }
          }
        },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        {
          "expect": {
            "value": 1,
            "events": { "onChange": [[1]], "onChangeEnd": [[0], [1]] }
          }
        }
      ]
    },
    {
      "id": "slider.react-aria.keyboard-at-max-no-change-but-change-end",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/slider/useSliderThumb.test.js#L532",
      "upstreamTest": "useSliderThumb > using KeyEvents > can be moved with keys at the end of the slider",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 100, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        {
          "expect": {
            "value": 100,
