    {
      "id": "slider.react-aria.page-up-page-down-repeat",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Slider.test.js#L352",
      "upstreamTest": "Slider > should support repeat keydown events when holding Page Up/Page Down",
      "apg": "keyboard",
      "config": { "thumbs": 1, "value": 20, "min": 0, "max": 100 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "event": "key", "target": "thumb:0", "key": "PageUp" },
        { "expect": { "value": 50 } },
        { "event": "key", "target": "thumb:0", "key": "PageDown" },
