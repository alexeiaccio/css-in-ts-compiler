      "steps": [
        { "event": "pointerdown", "target": "track", "position": 0.2 },
        { "event": "pointerup", "target": "track", "position": 0.2 },
        { "expect": { "value": 20, "events": { "onChange": [[20]] } } }
      ]
    },
    {
      "id": "slider.react-aria.pointer-drag-thumb-clamps-to-bounds",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/slider/Slider.test.tsx#L463",
      "upstreamTest": "Slider > mouse interactions > can click and drag handle",
      "apg": "pointer",
      "config": { "thumbs": 1, "value": 50, "min": 0, "max": 100 },
      "steps": [
        { "event": "pointerdown", "target": "thumb:0", "position": 0.5 },
