    {
      "id": "slider.react-aria.pointer-track-click-moves-thumb",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Slider.test.js#L367",
