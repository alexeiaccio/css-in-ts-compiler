    {
      "id": "accordion.base-ui.aria-expanded-and-controls",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/accordion/root/AccordionRoot.test.tsx#L41",
      "upstreamTest": "<Accordion.Root /> > ARIA attributes > renders correct ARIA attributes",
      "apg": "aria",
      "config": {
        "items": 1,
        "defaultExpanded": [0]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "true",
                "aria-controls": "panel:0"
              },
              "panel:0": {
                "role": "region",
                "aria-labelledby": "trigger:0"
              }
            },
            "visible": ["panel:0"]
          }
        }
      ],
      "notes": "Auto-generated ids are normalised to part tokens (trigger:0 / panel:0). All accordion callbacks take a single argument; in events a sub-array is an array-valued argument."
    },
