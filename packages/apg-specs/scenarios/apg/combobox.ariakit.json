          "Sandwich",
          "Steak",
          "Strawberry",
          "Tomato",
          "Watermelon"
        ],
        "defaultSelectedValue": "Apple"
      },
      "steps": [
        { "event": "click", "target": "trigger" },
        { "event": "type", "text": "gr", "target": "input" },
