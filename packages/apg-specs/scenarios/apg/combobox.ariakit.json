        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "Enter", "target": "input" },
        { "expect": { "value": "Green apple", "visible": [] } },
        { "event": "key", "key": "Enter", "target": "trigger" },
        { "expect": { "value": "", "focus": "option:0" } },
        { "event": "type", "text": "o", "target": "input" },
        { "expect": { "focus": "option:0" } }
      ],
      "notes": "Typing filters and auto-selects the first match; committing writes the label into the trigger. Reopening clears the query and restores the selected item."
