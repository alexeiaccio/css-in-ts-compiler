{
  "pattern": "combobox",
  "source": "ariakit",
  "commit": "404c72257b879569feb08465da4ff9915fd873da",
  "license": "MIT",
  "scenarios": [
    {
      "id": "combobox.ariakit.show-on-click",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L8",
      "upstreamTest": "show on click",
      "apg": "pointer",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "expect": { "visible": [] } },
        { "event": "click", "target": "input" },
        { "expect": { "visible": ["popup", "option:0"], "focus": "input" } }
      ],
      "notes": "Clicking the input opens the listbox but does not move focus to any option."
    },
    {
      "id": "combobox.ariakit.label-click-does-not-open",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L15",
      "upstreamTest": "label click",
      "apg": "extension",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "click", "target": "label" },
        { "expect": { "visible": [] } }
      ],
      "notes": "Pressing the associated label does not open the popup."
    },
    {
      "id": "combobox.ariakit.arrow-down-opens",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L21",
      "upstreamTest": "show on arrow down key",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "visible": [] } },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "visible": ["popup", "option:0"], "focus": "input" } }
      ],
      "notes": "ArrowDown opens the popup without focusing the first option."
    },
    {
      "id": "combobox.ariakit.arrow-up-opens",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L29",
      "upstreamTest": "show on arrow up key",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowUp", "target": "input" },
        { "expect": { "visible": ["popup", "option:4"], "focus": "input" } }
      ],
      "notes": "ArrowUp opens the popup without focusing the last option."
    },
    {
      "id": "combobox.ariakit.typing-opens",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L37",
      "upstreamTest": "show on change",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "type", "text": "a", "target": "input" },
        { "expect": { "visible": ["popup", "option:0"], "focus": "input" } }
      ],
      "notes": "Typing opens the popup but leaves focus in the input."
    },
    {
      "id": "combobox.ariakit.navigate-with-arrows",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L45",
      "upstreamTest": "navigate through items with keyboard",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "focus": "option:0" } },
        { "event": "key", "key": "ArrowDown", "target": "option:0" },
        { "expect": { "focus": "option:1" } },
        { "event": "key", "key": "ArrowDown", "target": "option:1" },
        { "expect": { "focus": "option:2" } }
      ],
      "notes": "The first ArrowDown only opens the list; the next moves DOM focus to the first option, then down the list. This is ariakit's focus-based active item rather than aria-activedescendant."
    },
    {
      "id": "combobox.ariakit.typing-moves-caret-not-selection",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L56",
      "upstreamTest": "type",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "type", "text": "a", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "focus": "option:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "option:0" },
        { "expect": { "focus": "option:0" } },
        { "event": "type", "text": "b", "target": "input" },
        { "expect": { "value": "ba", "focus": "input" } }
      ],
      "notes": "Horizontal keys move the caret without leaving the highlighted item; typing edits the query. Upstream also checks selectionStart, which is input-internal."
    },
    {
      "id": "combobox.ariakit.mouse-select-commits-and-closes",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L68",
      "upstreamTest": "set value and hide on item click with mouse",
      "apg": "pointer",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "click", "target": "input" },
        { "event": "click", "target": "option:2" },
        { "expect": { "value": "Orange", "focus": "input", "visible": [] } }
      ]
    },
    {
      "id": "combobox.ariakit.keyboard-select-commits-and-closes",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L77",
      "upstreamTest": "set value and hide on item click with keyboard",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "value": "" } },
        { "event": "key", "key": "Enter", "target": "option:1" },
        { "expect": { "value": "Grape", "focus": "input", "visible": [] } }
      ],
      "notes": "Enter on the focused Grape option commits its value and closes the popup."
    },
    {
      "id": "combobox.ariakit.space-does-not-select",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L89",
      "upstreamTest": "do not set value and hide by pressing space",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "type", "text": " ", "target": "input" },
        { "expect": { "value": " ", "focus": "input", "visible": ["popup"] } }
      ],
      "notes": "Space is typed into the input, not treated as option activation; the popup stays open and no option keeps focus."
    },
    {
      "id": "combobox.ariakit.escape-closes-keeps-focus",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L102",
      "upstreamTest": "hide listbox by pressing escape",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "click", "target": "input" },
        { "expect": { "visible": ["popup"] } },
        { "event": "key", "key": "Escape", "target": "input" },
        { "expect": { "visible": [], "focus": "input" } }
      ]
    },
    {
      "id": "combobox.ariakit.click-outside-closes-and-blurs",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L110",
      "upstreamTest": "hide listbox by clicking outside",
      "apg": "pointer",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "click", "target": "input" },
        { "event": "click", "target": "body" },
        { "expect": { "visible": [], "focus": null } }
      ],
      "notes": "Clicking outside closes the popup and lets focus leave the combobox."
    },
    {
      "id": "combobox.ariakit.backspace-reopens-after-escape",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L118",
      "upstreamTest": "re-open listbox when deleting content",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "type", "text": "a", "target": "input" },
        { "expect": { "visible": ["popup"] } },
        { "event": "key", "key": "Escape", "target": "input" },
        { "expect": { "visible": [] } },
        { "event": "key", "key": "Backspace", "target": "input" },
        { "expect": { "visible": ["popup"] } }
      ],
      "notes": "Editing after dismissal reopens the popup."
    },
    {
      "id": "combobox.ariakit.click-input-removes-option-focus",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L128",
      "upstreamTest": "clicking on combobox input removes focus from item",
      "apg": "pointer",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "focus": "option:1" } },
        { "event": "click", "target": "input" },
        { "expect": { "focus": "input" } }
      ],
      "notes": "Pressing the input drops the option's DOM focus back to the input."
    },
    {
      "id": "combobox.ariakit.horizontal-keys-then-arrows",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox/test.ts#L138",
      "upstreamTest": "move cursor on combobox with horizontal keys",
      "apg": "keyboard",
      "config": {
        "items": ["Apple", "Grape", "Orange", "Strawberry", "Watermelon"]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "type", "text": "abc", "target": "input" },
        { "event": "key", "key": "ArrowLeft", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "expect": { "focus": "option:0" } },
        { "event": "key", "key": "ArrowRight", "target": "input" },
        { "event": "key", "key": "Home", "target": "input" }
      ],
      "notes": "Caret movement on the input (selectionStart 3->2->3->0 upstream) is input-internal; only the arrow transition to the option is restated."
    },
    {
      "id": "combobox.ariakit.select-only.pointer-and-keyboard-open-close",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/combobox-select/test.ts#L10",
      "upstreamTest": "Provider favorite fruit > opens and closes with the pointer and keyboard",
      "apg": "keyboard",
      "config": {
        "variant": "select-only",
        "items": [
          "Apple",
          "Bacon",
          "Banana",
          "Broccoli",
          "Burger",
          "Cake",
          "Candy",
          "Carrot",
          "Cherry",
          "Chocolate",
          "Cookie",
          "Cucumber",
          "Donut",
          "Fish",
          "Fries",
          "Grape",
          "Green apple",
          "Hot dog",
          "Ice cream",
          "Kiwi",
          "Lemon",
          "Lollipop",
          "Onion",
          "Orange",
          "Pasta",
          "Pineapple",
          "Pizza",
          "Potato",
          "Salad",
          "Sandwich",
          "Steak",
          "Strawberry",
          "Tomato",
          "Watermelon"
        ],
        "defaultSelectedValue": "Apple"
      },
      "steps": [
        { "expect": { "visible": [] } },
        { "event": "click", "target": "trigger" },
        { "expect": { "visible": ["popup", "option:0"], "focus": "input" } },
        { "event": "click", "target": "trigger" },
        { "expect": { "visible": [], "focus": "trigger" } },
        { "event": "key", "key": "Enter", "target": "trigger" },
        { "expect": { "visible": ["popup"], "focus": "input" } },
        { "event": "key", "key": "Shift+Tab", "target": "input" },
        { "expect": { "focus": "trigger" } },
        { "event": "key", "key": "Enter", "target": "trigger" },
        { "expect": { "visible": [] } }
      ],
      "notes": "Select-only: the trigger carries the value, the search input lives in the popup and is focused on open; Shift+Tab returns to the trigger."
    },
    {
      "id": "combobox.ariakit.select-only.filter-commit-restore",
