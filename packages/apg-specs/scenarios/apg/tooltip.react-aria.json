    {
      "id": "tooltip.react-aria.hover-shows-and-unhover-hides",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/tooltip/useTooltip.test.js#L24",
      "upstreamTest": "useTooltip > opens tooltip on hover after delay",
      "apg": "pointer",
      "config": { "delay": 1500 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 750 },
        { "expect": { "visible": [] } },
        { "event": "wait", "ms": 750 },
        { "expect": { "visible": ["tooltip:0"] } },
        { "event": "unhover", "target": "trigger:0" },
        { "event": "wait", "ms": 350 },
        { "expect": { "visible": ["tooltip:0"] } },
        { "event": "wait", "ms": 350 },
        { "expect": { "visible": [] } }
      ],
      "notes": "Default delay is 1500ms and the close grace is 350-500ms; the halved waits bracket both."
    },
