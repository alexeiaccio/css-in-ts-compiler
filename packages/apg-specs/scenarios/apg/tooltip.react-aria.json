  "skipped": [
    {
      "reason": "styling, class and placement assertions (react-aria-Tooltip class, data-placement, position: absolute, OverlayArrow, style overrides, data-entering / data-exiting)"
    },
    {
      "reason": "portal container tests (UNSAFE_PortalProvider / UNSTABLE_portalContainer) and React refs"
    },
    {
      "reason": "custom trigger render APIs (Focusable, Pressable, slot/context, render props) and excludeFromTabOrder / tabindex pass-through"
    },
    {
      "reason": "scroll-dismissal tests - the scroll event is not part of the scenario vocabulary"
    },
    {
      "reason": "instant warm-up animation (`animates the first, swaps subsequent instantly, and animates out the last`) - data-instant animation lifecycle"
    },
    {
      "reason": "controlled open/hidden and the manual warmup-timeout tests that call state.open()/state.close() directly through a test harness"
    },
    {
      "reason": "@adobe/react-spectrum TooltipTrigger 'can be disabled from the TooltipTrigger'/'from the trigger' variants - duplicated disabled semantics"
    }
  ],
  "scenarios": [
    {
      "id": "tooltip.react-aria.hover-shows-with-describedby",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tooltip.test.js#L51",
      "upstreamTest": "Tooltip > shows on hover",
      "apg": "pointer",
      "config": { "delay": 0 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        {
          "expect": {
            "visible": ["tooltip:0"],
            "attrs": { "trigger:0": { "aria-describedby": "*" } }
          }
        }
      ],
      "notes": "The upstream also asserts class, placement, position and OverlayArrow styling, which are skipped. aria-describedby value \"*\" means any non-empty IDREF matching the tooltip id."
    },
    {
      "id": "tooltip.react-aria.focus-shows-with-describedby",
