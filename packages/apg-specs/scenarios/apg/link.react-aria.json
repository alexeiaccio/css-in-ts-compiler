    {
      "id": "link.react-aria.native-anchor-needs-no-role",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/link/useLink.test.js#L23",
      "upstreamTest": "useLink > handles defaults",
      "apg": "aria",
      "config": { "native": true },
      "steps": [
        {
          "expect": {
            "attrs": { "link": { "role": null } },
            "focus": null
          }
        }
      ],
      "notes": "A native <a href> is focusable and activatable on its own; onKeyDown is still attached for react-aria press handling."
    },
    {
      "id": "link.react-aria.custom-element-gets-role-link",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/link/useLink.test.js#L30",
      "upstreamTest": "useLink > handles custom element type",
      "apg": "aria",
      "config": { "elementType": "div" },
      "steps": [
        {
          "expect": {
            "attrs": { "link": { "role": "link" } }
          }
        }
      ]
    },
    {
      "id": "link.react-aria.custom-element-is-tabbable",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/link/useLink.test.js#L30",
      "upstreamTest": "useLink > handles custom element type",
      "apg": "aria",
      "config": { "elementType": "div" },
      "steps": [
        { "event": "focus", "target": "link" },
        { "expect": { "focus": "link" } }
      ],
      "notes": "The custom element must supply focusability itself (tabindex=0); the hook only adds role and the Enter handler."
    },
    {
      "id": "link.react-aria.disabled-custom-link",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/link/useLink.test.js#L36",
      "upstreamTest": "useLink > handles isDisabled",
      "apg": "aria",
      "config": { "elementType": "span", "isDisabled": true },
      "steps": [
        {
          "expect": {
            "attrs": { "link": { "role": "link", "aria-disabled": "true" } },
            "focus": null
          }
        }
      ],
      "notes": "A disabled link role is removed from the tab order and marked aria-disabled."
