  "scenarios": [
    {
      "id": "slider.base-ui.aria-attributes",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/slider/root/SliderRoot.test.tsx#L172",
      "upstreamTest": "SliderRoot > ARIA attributes > has the correct aria attributes",
      "apg": "aria",
      "config": { "thumbs": 1, "value": 30, "labelledBy": "labelId" },
      "steps": [
        {
          "expect": {
            "attrs": {
              "thumb:0": {
                "role": "slider",
                "aria-valuenow": "30",
                "aria-orientation": "horizontal",
                "aria-labelledby": "labelId",
                "step": "1"
              }
            }
          }
        }
      ],
      "notes": "base-ui renders a hidden input[type=range] as the slider control; role/tag is implementation, the ARIA value/orientation/step contract is what is ported."
    },
    {
      "id": "slider.base-ui.aria-valuenow-updates-on-input-and-arrow",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/slider/root/SliderRoot.test.tsx#L198",
      "upstreamTest": "SliderRoot > ARIA attributes > should update aria-valuenow",
      "apg": "aria",
      "config": { "thumbs": 1, "value": 50 },
      "steps": [
        { "event": "focus", "target": "thumb:0" },
        { "event": "type", "target": "thumb:0", "value": 51 },
        { "expect": { "attrs": { "thumb:0": { "aria-valuenow": "51" } } } },
        { "event": "key", "target": "thumb:0", "key": "ArrowRight" },
        { "expect": { "attrs": { "thumb:0": { "aria-valuenow": "52" } } } }
      ]
    },
    {
      "id": "slider.base-ui.aria-valuetext-from-getAriaValueText",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/slider/thumb/SliderThumb.test.tsx#L74",
      "upstreamTest": "SliderThumb > ARIA attributes > prefers getAriaValueText over a direct aria-valuetext prop",
      "apg": "aria",
      "config": { "thumbs": 1, "value": 50, "valueText": "50 percent" },
      "steps": [
        {
          "expect": {
            "attrs": { "thumb:0": { "aria-valuetext": "50 percent" } }
          }
        }
      ],
      "notes": "The formatted text is supplied by the caller; the port asserts only that aria-valuetext reflects the derived text."
    },
