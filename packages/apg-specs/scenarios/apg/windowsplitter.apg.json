      "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/#keyboardinteraction",
      "upstreamTest": "Keyboard Interaction: Enter restores the splitter to its previous position when the pane is collapsed",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "value": 2,
        "min": 0,
        "max": 6,
        "step": 2,
        "prev": 2
      },
      "steps": [
        { "event": "focus", "target": "separator" },
        { "event": "key", "key": "Enter", "target": "separator" },
        { "expect": { "attrs": { "separator": { "aria-valuenow": "0" } } } },
        { "event": "key", "key": "Enter", "target": "separator" },
        { "expect": { "attrs": { "separator": { "aria-valuenow": "2" } } } }
      ],
      "notes": "The remembered position is the value at the moment of collapse; moving to value 2 first makes the restore distinguishable from the initial 4."
    },
