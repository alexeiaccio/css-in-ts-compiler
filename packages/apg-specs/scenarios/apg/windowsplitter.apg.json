{
  "pattern": "windowsplitter",
  "source": "apg",
  "commit": null,
  "license": "W3C Software and Document License",
  "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/",
  "notes": "No upstream implementation of the window splitter pattern exists in ariakit, base-ui or react-aria. Searched all *test* files under ariakit/app/src, base-ui/packages and react-spectrum/packages for separator/splitter/resiz: ariakit and base-ui ship only a static role=separator element (base-ui Separator.test.tsx, ariakit examples/separator and toolbar separators) that has no size control; react-aria's useSeparator is likewise static. react-aria's ColumnResizer (react-aria-components Table) is a table-column resizer, not a splitter: it renders an <input type=range> with role=slider (so not role=separator), Enter starts keyboard resizing rather than collapsing, arrows move the slider, and there is no F6 pane cycle - it does not follow the window splitter keyboard model, so it is not ported. Scenarios are therefore derived from the APG Window Splitter Pattern page: About This Pattern, Keyboard Interaction, and WAI-ARIA Roles, States, and Properties, licensed W3C Software and Document License. There is no functional APG example for this pattern (tracked upstream as issue 130), so no example-derived scenarios exist.",
  "skipped": [
    {
      "reason": "ariakit static separators (app/src/sandbox/separator-semantics, app/src/examples/separator/_component/test.ts, app/src/sandbox/toolbar-separator-6302, app/src/sandbox/role-7455): role=separator elements that are not focusable and do not resize a pane"
    },
    {
      "reason": "base-ui static separators (packages/react/src/separator/Separator.test.tsx, packages/react/src/toolbar/separator/ToolbarSeparator.test.tsx): role=separator + aria-orientation conformance only, no size control"
    },
    {
      "reason": "react-aria static separators (packages/react-aria-components/test/Separator.test.js, packages/@adobe/react-spectrum/test/divider/Divider.test.js): render/class/DOM-prop assertions on a static separator; useSeparator is not focusable and does not resize"
    },
    {
      "reason": "react-aria table column resizing (packages/react-aria-components/test/Table.test.js resizeCol, packages/@adobe/react-spectrum/test/table/TableSizing.test.tsx, packages/react-aria/test/table/ariaTableResizing.test.tsx, packages/react-aria/test/table/tableResizingTests.tsx): ColumnResizer/Resizer render an <input type=range> with role=slider and resize table columns; this is the Slider pattern, not the window splitter keyboard model (Enter starts keyboard resize, no collapse/restore, no F6 cycle)"
    },
    {
      "reason": "@adobe/spectrum-css-temp/components/splitview/*.css: CSS custom-property styles with no React component or test"
    }
  ],
  "scenarios": [
    {
      "id": "windowsplitter.apg.about.vertical-splitter-between-left-and-right-panes",
      "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/#aboutthispattern",
      "upstreamTest": "About This Pattern: a vertical splitter divides left and right panes",
      "apg": "about",
      "config": {
        "orientation": "vertical",
        "value": 4,
        "min": 0,
        "max": 6,
        "step": 2
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "separator": {
                "role": "separator",
                "aria-orientation": "vertical",
                "aria-valuenow": "4"
              }
            }
          }
        }
      ]
    },
    {
      "id": "windowsplitter.apg.about.horizontal-splitter-between-top-and-bottom-panes",
      "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/#aboutthispattern",
      "upstreamTest": "About This Pattern: a horizontal splitter divides top and bottom panes",
      "apg": "about",
      "config": {
        "orientation": "horizontal",
        "value": 4,
        "min": 0,
        "max": 6,
        "step": 2
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "separator": {
                "role": "separator",
                "aria-orientation": "horizontal",
                "aria-valuenow": "4"
              }
            }
          }
        }
      ]
    },

