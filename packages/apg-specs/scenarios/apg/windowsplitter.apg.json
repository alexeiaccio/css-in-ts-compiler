      ],
      "notes": "APG says aria-valuemax is typically 100; this scenario pins the range end of the modelled widget (maximum 6)."
    },
    {
      "id": "windowsplitter.apg.roles.aria-label-names-primary-pane",
      "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/#wai-ariaroles,states,andproperties",
