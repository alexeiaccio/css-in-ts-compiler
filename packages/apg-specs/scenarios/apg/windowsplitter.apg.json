    {
      "id": "windowsplitter.apg.keyboard.f6-cycles-focus-through-panes",
      "upstream": "https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/#keyboardinteraction",
      "upstreamTest": "Keyboard Interaction (optional): F6 cycles through window panes",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "value": 4,
        "min": 0,
        "max": 6,
        "step": 2
      },
      "steps": [
        { "event": "focus", "target": "separator" },
        { "event": "key", "key": "F6", "target": "separator" },
        { "expect": { "focus": "secondary" } },
        { "event": "key", "key": "F6", "target": "secondary" },
        { "expect": { "focus": "primary" } },
        { "event": "key", "key": "F6", "target": "primary" },
        { "expect": { "focus": "separator" } }
      ],
      "notes": "APG does not fix the cycle order; the order asserted here is the one modelled by specs/apg/windowsplitter.qnt (splitter -> secondary -> primary -> splitter)."
    },
    {
