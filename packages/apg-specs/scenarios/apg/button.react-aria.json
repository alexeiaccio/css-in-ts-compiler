    },
    {
      "id": "button.react-aria.s1-button-keyboard-activates-non-submit",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/button/Button.test.js#L255",
      "upstreamTest": "Button > prevents default for non-submit types",
      "apg": "keyboard",
      "config": { "part": "button", "type": "button" },
      "steps": [
        { "event": "focus", "target": "button" },
        { "event": "key", "key": "Enter", "target": "button" },
        {
          "expect": {
            "events": {
              "onKeyDown": [{ "defaultPrevented": true }],
              "onKeyUp": [{ "defaultPrevented": true }]
            }
          }
        },
        { "event": "key", "key": " ", "target": "button" },
        {
          "expect": {
            "events": {
              "onKeyDown": [{ "defaultPrevented": true }],
              "onKeyUp": [{ "defaultPrevented": true }]
            }
          }
        }
      ],
      "notes": "Non-submit buttons prevent the default Enter/Space actions so no implicit form submission occurs."
    }
  ]
}
