        { "event": "key", "key": "ArrowLeft", "target": "button:1" },
        { "expect": { "focus": "button:0" } }
      ],
      "notes": "Horizontal single-select group uses Left/Right arrows."
    },
    {
      "id": "button.react-aria.toggle-button-group-vertical-keyboard",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/ToggleButtonGroup.test.js#L191",
      "upstreamTest": "ToggleButtonGroup > should support vertical keyboard navigation",
      "apg": "keyboard",
      "config": {
        "groupRole": "radiogroup",
        "orientation": "vertical",
        "items": 2
      },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": { "attrs": { "group": { "aria-orientation": "vertical" } } }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button:0" } },
