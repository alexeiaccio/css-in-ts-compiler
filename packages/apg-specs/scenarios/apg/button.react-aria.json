    },
    {
      "id": "button.react-aria.s1-toggle-button-onpress-and-onchange",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/button/ToggleButton.test.js#L19",
      "upstreamTest": "ToggleButton > handles defaults",
