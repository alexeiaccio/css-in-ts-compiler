          }
        }
      ],
      "notes": "S1 ToggleButton: onPress fires alongside onChange."
    },
    {
      "id": "button.react-aria.s1-toggle-button-controlled-selected",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/button/ToggleButton.test.js#L57",
      "upstreamTest": "ToggleButton > supports isSelected",
      "apg": "aria",
      "config": { "part": "button", "isSelected": true },
      "steps": [
        { "event": "prop", "set": {} },
        { "expect": { "attrs": { "button": { "aria-pressed": "true" } } } },
        { "event": "click", "target": "button" },
        {
