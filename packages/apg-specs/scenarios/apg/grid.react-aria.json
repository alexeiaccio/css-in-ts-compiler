    {
      "id": "grid.react-aria.gridlist-layout-grid-arrow-navigation",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/GridList.test.js#L554",
      "upstreamTest": "GridList > should support grid layout",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "orientation": "horizontal"
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "row:0" } },
        { "event": "key", "key": "ArrowRight", "target": "row:0" },
        { "expect": { "focus": "row:1" } },
        { "event": "key", "key": "ArrowRight", "target": "row:1" },
        { "expect": { "focus": "row:2" } },
        { "event": "key", "key": "ArrowLeft", "target": "row:2" },
        { "expect": { "focus": "row:1" } },
        { "event": "key", "key": "Tab", "target": "row:1" },
        { "expect": { "focus": "row:1/child:0" } },
        { "event": "key", "key": "Tab", "target": "row:1/child:0" },
        { "expect": { "focus": "body" } }
      ],
      "notes": "layout=\"grid\" gives the list a grid role and makes rows laid out horizontally navigable with Left/Right."
    },
