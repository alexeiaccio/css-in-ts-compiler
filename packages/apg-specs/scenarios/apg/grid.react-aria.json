    {
      "id": "grid.react-aria.gridlist-selection-replace-checkboxes",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/GridList.test.js#L653",
      "upstreamTest": "GridList > should support selectionMode=\"replace\" with checkboxes",
      "apg": "selection",
      "config": {
        "layout": "list",
        "rows": 3,
        "selectionMode": "multiple",
        "selectionBehavior": "replace"
      },
      "steps": [
        { "event": "click", "target": "row:0" },
        { "event": "click", "target": "row:1" },
        {
          "expect": {
            "attrs": {
              "row:0": { "aria-selected": "false" },
              "row:1": { "aria-selected": "true" },
              "row:2": { "aria-selected": "false" }
            }
          }
        },
        { "event": "click", "target": "row:2/checkbox" },
        {
          "expect": {
            "attrs": {
              "row:0": { "aria-selected": "false" },
              "row:1": { "aria-selected": "true" },
              "row:2": { "aria-selected": "true" }
            }
          }
        }
      ],
      "notes": "selecting a row replaces the selection; the row checkbox adds to an existing selection."
    },
    {
      "id": "grid.react-aria.gridlist-selection-replace-single-keyboard",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/GridList.test.js#L777",
      "upstreamTest": "GridList > selectionBehavior=\"replace\" > keyboard > should perform selection with single selection",
      "apg": "selection",
      "config": {
        "layout": "list",
        "rows": 3,
        "selectionMode": "single",
        "selectionBehavior": "replace",
        "noCheckboxes": true
      },
      "steps": [
        { "event": "focus", "target": "row:2" },
        { "event": "key", "key": "Enter", "target": "row:2" },
        {
          "expect": {
            "attrs": {
              "row:2": { "aria-selected": "true", "data-selected": "true" }
            }
          }
        },
        { "event": "focus", "target": "row:1" },
        { "event": "key", "key": "Enter", "target": "row:1" },
        {
          "expect": {
            "attrs": {
              "row:1": { "aria-selected": "true", "data-selected": "true" },
              "row:2": { "aria-selected": "false", "data-selected": null }
            }
          }
        },
        { "event": "key", "key": "Enter", "target": "row:1" },
        {
          "expect": {
            "attrs": {
              "row:1": { "aria-selected": "false", "data-selected": null }
            }
          }
        }
      ],
      "notes": "No checkboxes are rendered when selectionBehavior=replace. Keyboard selection starts on the focused row, which is why the first focus also fires a change upstream."
    },
