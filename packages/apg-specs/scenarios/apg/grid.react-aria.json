    {
      "id": "grid.react-aria.use-grid-restores-last-focused-child",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/grid/useGrid.test.js#L161",
      "upstreamTest": "useGrid > should restore focus to the child that was last focused within a cell, not the first child",
      "apg": "focus",
      "config": {
        "layout": "grid",
