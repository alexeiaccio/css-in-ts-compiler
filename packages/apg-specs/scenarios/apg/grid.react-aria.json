  "scenarios": [
    {
      "id": "grid.react-aria.use-grid-row-mode-cell-mode",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/grid/useGrid.test.js#L53",
      "upstreamTest": "useGrid > gridFocusMode = row, cellFocusMode = cell",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "gridFocusMode": "row",
        "cellFocusMode": "cell",
        "rows": 3,
        "cellChildren": [2, 3, 2]
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "row:0" } },
        { "event": "key", "key": "ArrowRight", "target": "row:0" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "key", "key": "ArrowRight", "target": "cell:0,0" },
        { "expect": { "focus": "cell:0,0/child:0" } },
        { "event": "key", "key": "ArrowRight", "target": "cell:0,0/child:0" },
        { "expect": { "focus": "cell:0,0/child:1" } },
        { "event": "key", "key": "ArrowRight", "target": "cell:0,0/child:1" },
        { "expect": { "focus": "row:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "row:0" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "focus", "target": "cell:0,0/child:1" },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,0/child:1" },
        { "expect": { "focus": "cell:0,0/child:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,0/child:0" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,0" },
        { "expect": { "focus": "row:0" } }
      ],
      "notes": "Each Item is a row holding a single gridcell of interactive children (switches). Row mode exposes the cell element; cell mode exposes its children."
    },
