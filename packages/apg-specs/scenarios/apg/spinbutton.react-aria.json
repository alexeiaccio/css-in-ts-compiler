    {
      "id": "spinbutton.react-aria.negative-valuetext-uses-minus-sign",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/spinbutton/useSpinButton.test.js#L161",
      "upstreamTest": "useSpinButton > should substitute a minus sign for hyphen in the textValue for negative values",
      "apg": "aria",
      "config": { "value": -2, "textValue": "-2 items" },
      "steps": [
        {
          "expect": {
            "attrs": {
              "input": { "aria-valuenow": "-2", "aria-valuetext": "−2 items" }
            }
          }
        },
        { "event": "focus", "target": "input" },
        {
          "event": "prop",
          "target": "input",
          "set": { "value": -3, "textValue": "-3 items" }
        },
        {
          "expect": {
            "attrs": {
              "input": { "aria-valuenow": "-3", "aria-valuetext": "−3 items" }
            },
            "events": { "announce": ["−3 items"] }
          }
        }
      ],
      "notes": "Negative aria-valuetext uses U+2212 MINUS SIGN instead of a hyphen."
    },
    {
      "id": "spinbutton.react-aria.announce-on-value-change-while-focused",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/spinbutton/useSpinButton.test.js#L130",
      "upstreamTest": "useSpinButton > should announce on value change while focused",
      "apg": "extension",
      "config": { "value": 2 },
      "steps": [
        { "event": "focus", "target": "input" },
        { "event": "prop", "target": "input", "set": { "value": 3 } },
        { "expect": { "events": { "announce": ["3"] } } },
        { "event": "blur", "target": "input" },
        { "event": "prop", "target": "input", "set": { "value": 4 } },
        { "expect": { "events": { "announce": ["3"] } } }
      ],
      "notes": "Live-region announcement is a react-aria extension, not APG; announcements only occur while focused. announce is emitted assertively."
    },
