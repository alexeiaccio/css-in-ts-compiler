      "upstreamTest": "useSpinButton > should have role=\"spinbutton\" and aria props",
      "apg": "aria",
      "config": { "value": 2, "textValue": "2 items", "min": 1, "max": 3 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "input": {
                "role": "spinbutton",
                "aria-valuenow": "2",
                "aria-valuemin": "1",
                "aria-valuemax": "3",
                "aria-valuetext": "2 items",
                "aria-disabled": null,
                "aria-readonly": null
              }
            }
          }
        }
      ]
