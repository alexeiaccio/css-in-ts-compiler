    {
      "id": "spinbutton.react-aria.provides-slots",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/NumberField.test.js#L46",
      "upstreamTest": "NumberField > provides slots",
      "apg": "aria",
      "config": {
        "defaultValue": 1024,
        "min": 0,
        "buttons": true,
        "label": "Width",
        "description": "Description",
        "errorMessage": "Error"
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "group": { "role": "group" },
              "input": {
                "role": "textbox",
                "aria-labelledby": "label:0",
                "aria-describedby": "description:0 error:0"
              },
              "increment": { "aria-label": "Increase" },
              "decrement": { "aria-label": "Decrease" }
            },
            "value": { "input": "1,024" }
          }
        }
      ],
      "notes": "aria-labelledby/aria-describedby resolve to the Label/Text parts; the input exposes the formatted value."
    },
    {
      "id": "spinbutton.react-aria.repeat-arrow-keydown-holding",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/NumberField.test.js#L334",
      "upstreamTest": "NumberField > should support repeat keydown events when holding an arrow key",
      "apg": "keyboard",
      "config": { "defaultValue": 1024 },
      "steps": [
        { "event": "focus", "target": "input" },
        { "event": "key", "key": "ArrowUp", "target": "input" },
        { "event": "key", "key": "ArrowUp", "target": "input" },
        { "event": "key", "key": "ArrowUp", "target": "input" },
        {
          "expect": {
            "value": { "input": "1,027" },
            "events": { "onChange": [1025, 1026, 1027] }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        { "event": "key", "key": "ArrowDown", "target": "input" },
        {
          "expect": {
            "value": { "input": "1,024" },
            "events": { "onChange": [1025, 1026, 1027, 1026, 1025, 1024] }
          }
        }
      ],
      "notes": "Key auto-repeat steps once per keydown event."
    },
