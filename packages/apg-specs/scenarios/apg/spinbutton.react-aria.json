    {
      "id": "spinbutton.react-aria.paste-into-format",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/NumberField.test.js#L433",
      "upstreamTest": "NumberField > should support pasting into a format",
      "apg": "keyboard",
      "config": { "defaultValue": 200, "format": "currency:USD" },
      "steps": [
        { "event": "focus", "target": "input" },
