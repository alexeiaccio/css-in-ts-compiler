    {
      "id": "spinbutton.react-aria.controlled-rejects-unaccepted-paste",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/NumberField.test.js#L452",
      "upstreamTest": "NumberField > should not change the input value if the new value is not accepted",
      "apg": "extension",
      "config": { "controlled": true, "value": 200 },
      "steps": [
        { "event": "focus", "target": "input" },
        { "event": "type", "target": "input", "value": "" },
        { "event": "paste", "target": "input", "value": "1024" },
        { "expect": { "value": { "input": "200" } } },
        { "event": "key", "key": "Enter", "target": "input" },
        { "expect": { "value": { "input": "200" } } }
      ],
      "notes": "A controlled field whose parent does not accept the parsed value reverts the text."
    },
    {
      "id": "spinbutton.react-aria.auto-spin-stops-when-button-disabled",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/NumberField.test.js#L614",
      "upstreamTest": "NumberField > auto spinning > stops spinning if the associated button is disabled",
      "apg": "extension",
      "config": {
        "controlled": true,
        "value": 4,
        "incrementDisabledAbove": 8,
        "decrementDisabledBelow": 4
      },
      "steps": [
        { "event": "click", "target": "increment" },
        { "expect": { "value": { "input": "5" } } },
        { "event": "pointerdown", "target": "decrement", "button": 0 },
        { "event": "pointerup", "target": "decrement", "button": 0 },
        {
          "expect": {
            "value": { "input": "5" },
            "attrs": { "decrement": { "disabled": "true" } }
          }
        }
      ],
      "notes": "Once the decrement button is disabled the press-and-hold does not fire."
    }
