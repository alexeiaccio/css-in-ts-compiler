      "notes": "onLoop receives the previous and next indices and its return value selects the focused item."
    },
    {
      "id": "grid.base-ui.disabled-index-initial-tab-stop",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L939",
