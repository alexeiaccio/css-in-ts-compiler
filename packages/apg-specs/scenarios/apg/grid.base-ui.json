    {
      "id": "grid.base-ui.modifier-keys-prevent-navigation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L1219",
      "upstreamTest": "Composite > prop: modifierKeys > prevents arrow key navigation when any modifier key is pressed by default",
      "apg": "extension",
      "config": {
        "layout": "list",
        "orientation": "vertical",
        "items": 2
      },
      "steps": [
        { "event": "focus", "target": "row:0" },
        {
          "event": "key",
          "key": "ArrowDown",
          "target": "row:0",
          "modifiers": ["Shift"]
        },
        { "expect": { "focus": "row:0" } },
        {
          "event": "key",
          "key": "ArrowDown",
          "target": "row:0",
          "modifiers": ["Control"]
        },
        { "expect": { "focus": "row:0" } },
        {
          "event": "key",
          "key": "ArrowDown",
          "target": "row:0",
          "modifiers": ["Alt"]
        },
        { "expect": { "focus": "row:0" } },
        {
          "event": "key",
          "key": "ArrowDown",
          "target": "row:0",
