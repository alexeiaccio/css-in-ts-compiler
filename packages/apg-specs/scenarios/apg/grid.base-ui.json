      "upstreamTest": "Composite > list > Home and End keys > End key moves focus to the last item",
      "apg": "keyboard",
      "config": {
        "layout": "list",
        "orientation": "vertical",
        "items": 3,
        "enableHomeAndEndKeys": true
      },
      "steps": [
        { "event": "focus", "target": "row:0" },
