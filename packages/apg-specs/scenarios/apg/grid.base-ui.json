      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L965",
      "upstreamTest": "Composite > prop: disabledIndices > disables navigating item when their index is included",
