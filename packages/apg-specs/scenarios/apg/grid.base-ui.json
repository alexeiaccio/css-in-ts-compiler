{
  "pattern": "grid",
  "source": "base-ui",
  "commit": "19511bb171f3b360b006c94cf6d07e53cb446505",
  "license": "MIT",
  "scenarios": [
    {
      "id": "grid.base-ui.uniform-1x1-items",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L538",
      "upstreamTest": "Composite > grid > uniform 1x1 items",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "enableHomeAndEndKeys": true
      },
      "steps": [
        { "event": "focus", "target": "cell:0,0" },
        { "event": "key", "key": "ArrowDown", "target": "cell:0,0" },
        {
          "expect": {
            "focus": "cell:1,0",
            "attrs": { "cell:1,0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "cell:1,0" },
        {
          "expect": {
            "focus": "cell:1,1",
            "attrs": { "cell:1,1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "cell:1,1" },
        {
          "expect": {
            "focus": "cell:2,1",
            "attrs": { "cell:2,1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "cell:2,1" },
        {
          "expect": {
            "focus": "cell:2,0",
            "attrs": { "cell:2,0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "cell:2,0" },
        {
          "expect": {
            "focus": "cell:1,0",
            "attrs": { "cell:1,0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "cell:1,0" },
        {
          "expect": {
            "focus": "cell:1,2",
            "attrs": { "cell:1,2": { "tabindex": "0" } }
          }
        },
        { "event": "focus", "target": "cell:2,2" },
        { "event": "key", "key": "Home", "target": "cell:2,2" },
        {
          "expect": {
            "focus": "cell:0,0",
            "attrs": { "cell:0,0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "End", "target": "cell:0,0" },
        {
          "expect": {
            "focus": "cell:2,2",
            "attrs": { "cell:2,2": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "3x3 grid, loop enabled: ArrowLeft from the row start wraps to the row end; Home/End jump to first/last item. Each move moves the roving tabindex '0'."
    },
    {
      "id": "grid.base-ui.on-loop-grid-returns-target",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L603",
      "upstreamTest": "Composite > grid > calls onLoop while navigating through grid cells",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "onLoop": "returns-index-4"
      },
      "steps": [
        { "event": "focus", "target": "cell:1,2" },
        { "event": "key", "key": "ArrowRight", "target": "cell:1,2" },
        {
          "expect": {
            "focus": "cell:1,1",
            "events": { "onLoop": ["ArrowRight", "5", "3", "cell:1,1"] }
          }
        }
      ],
      "notes": "Right from the row end invokes onLoop with prevIndex 5, nextIndex 3; the returned index 4 decides the landing cell."
    },
    {
      "id": "grid.base-ui.on-loop-vertical-between-rows",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L639",
      "upstreamTest": "Composite > grid > calls onLoop when looping vertically between rows",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "onLoop": "returns-next-index"
      },
      "steps": [
        { "event": "focus", "target": "cell:2,2" },
        { "event": "key", "key": "ArrowDown", "target": "cell:2,2" },
        {
          "expect": {
            "focus": "cell:0,2",
            "events": { "onLoop": ["ArrowDown", "8", "2", "cell:0,2"] }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "cell:0,2" },
        {
          "expect": {
            "focus": "cell:2,2",
            "events": { "onLoop": ["ArrowUp", "2", "8", "cell:2,2"] }
          }
        }
      ],
      "notes": "Vertical loop wraps from the last row to the same column in the first row and back."
    },
    {
      "id": "grid.base-ui.on-loop-returns-prev-index-stays",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L680",
      "upstreamTest": "Composite > grid > stays on the current item when onLoop returns prevIndex",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "orientation": "horizontal",
        "onLoop": "returns-prev-index"
      },
      "steps": [
        { "event": "focus", "target": "cell:2,2" },
        { "event": "key", "key": "ArrowRight", "target": "cell:2,2" },
        {
          "expect": {
            "focus": "cell:2,2",
            "events": { "onLoop": ["ArrowRight", "8", "0", "cell:2,2"] }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "cell:2,2" },
        {
          "expect": {
            "focus": "cell:2,2",
            "events": { "onLoop": ["ArrowDown", "8", "2", "cell:2,2"] }
          }
        }
      ],
      "notes": "When onLoop returns prevIndex the tab stop is not moved."
    },
    {
      "id": "grid.base-ui.no-loop-when-loop-focus-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L713",
      "upstreamTest": "Composite > grid > does not loop or call onLoop when loopFocus is disabled",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "loopFocus": false
      },
      "steps": [
        { "event": "focus", "target": "cell:2,2" },
        { "event": "key", "key": "ArrowDown", "target": "cell:2,2" },
        { "expect": { "focus": "cell:2,2" } },
        { "event": "key", "key": "ArrowRight", "target": "cell:2,2" },
        { "expect": { "focus": "cell:2,2", "events": { "onLoop": [] } } }
      ],
      "notes": "With loopFocus=false navigation stops at the edge and onLoop is never called."
    },
    {
      "id": "grid.base-ui.skips-disabled-indices",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L744",
      "upstreamTest": "Composite > grid > skips disabled indices",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "disabledIndices": [4]
      },
      "steps": [
        { "event": "focus", "target": "cell:0,1" },
        { "event": "key", "key": "ArrowDown", "target": "cell:0,1" },
        {
          "expect": {
            "focus": "cell:2,1",
            "attrs": { "cell:2,1": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "The disabled centre cell (index 4) is skipped; focus lands on the next enabled cell in the same column."
    },
    {
      "id": "grid.base-ui.dense-packing-fills-gaps",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L764",
      "upstreamTest": "Composite > grid > packs items into earlier gaps when dense",
      "apg": "extension",
      "config": {
        "layout": "grid",
        "cols": 2,
        "dense": true,
        "itemSizes": [
          { "width": 1, "height": 1 },
          { "width": 2, "height": 1 },
          { "width": 1, "height": 1 }
        ]
      },
      "steps": [
        { "event": "focus", "target": "cell:0,0" },
        { "event": "key", "key": "ArrowRight", "target": "cell:0,0" },
        { "expect": { "focus": "cell:0,1" } },
        { "event": "key", "key": "ArrowDown", "target": "cell:0,1" },
        { "expect": { "focus": "cell:1,0" } }
      ],
      "notes": "Extension (layout packing): with dense packing the third 1x1 item backfills the gap next to the first."
    },
    {
      "id": "grid.base-ui.rtl-horizontal",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L802",
      "upstreamTest": "Composite > grid > rtl > horizontal orientation",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "orientation": "horizontal",
        "dir": "rtl",
        "enableHomeAndEndKeys": true
      },
      "steps": [
        { "event": "focus", "target": "cell:0,0" },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,0" },
        { "expect": { "focus": "cell:0,1" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,1" },
        { "expect": { "focus": "cell:0,2" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,2" },
        { "expect": { "focus": "cell:1,0" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:1,0" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "key", "key": "Home", "target": "cell:1,1" },
        { "expect": { "focus": "cell:0,0" } },
        { "event": "key", "key": "End", "target": "cell:0,0" },
        { "expect": { "focus": "cell:2,2" } }
      ],
      "notes": "In RTL ArrowLeft advances forward."
    },
    {
      "id": "grid.base-ui.rtl-both-orientation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L850",
      "upstreamTest": "Composite > grid > rtl > both horizontal and vertical orientation",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "rows": 3,
        "cols": 3,
        "orientation": "both",
        "dir": "rtl",
        "enableHomeAndEndKeys": true
      },
      "steps": [
        { "event": "focus", "target": "cell:0,0" },
        { "event": "key", "key": "ArrowDown", "target": "cell:0,0" },
        { "expect": { "focus": "cell:1,0" } },
        { "event": "key", "key": "ArrowLeft", "target": "cell:1,0" },
        { "expect": { "focus": "cell:1,1" } },
        { "event": "key", "key": "ArrowDown", "target": "cell:1,1" },
        { "expect": { "focus": "cell:2,1" } },
        { "event": "key", "key": "ArrowRight", "target": "cell:2,1" },
        { "expect": { "focus": "cell:2,0" } },
        { "event": "key", "key": "ArrowUp", "target": "cell:2,0" },
        { "expect": { "focus": "cell:1,0" } },
        { "event": "key", "key": "End", "target": "cell:1,0" },
        { "expect": { "focus": "cell:2,2" } },
        { "event": "key", "key": "Home", "target": "cell:2,2" },
        { "expect": { "focus": "cell:0,0" } }
      ],
      "notes": "RTL with orientation=both: ArrowLeft is forward, ArrowRight is backward."
    },
    {
      "id": "grid.base-ui.rtl-spanning-item-forward-edge",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L904",
      "upstreamTest": "Composite > grid > rtl > uses the forward edge when navigating from a spanning item",
      "apg": "keyboard",
      "config": {
        "layout": "grid",
        "cols": 3,
        "orientation": "both",
        "dir": "rtl",
        "itemSizes": [
          { "width": 1, "height": 1 },
          { "width": 2, "height": 1 },
          { "width": 1, "height": 1 }
        ]
      },
      "steps": [
        { "event": "focus", "target": "cell:0,1" },
        { "event": "key", "key": "ArrowLeft", "target": "cell:0,1" },
        { "expect": { "focus": "cell:0,0" } }
      ],
      "notes": "The 2-column spanning item uses its forward (RTL) edge when moving to the previous item."
    },
    {
      "id": "grid.base-ui.controlled-highlighted-index",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L60",
      "upstreamTest": "Composite > list > controlled mode",
      "apg": "keyboard",
      "config": {
        "layout": "list",
        "orientation": "vertical",
        "items": 3,
        "highlightedIndex": "controlled"
      },
      "steps": [
        { "event": "focus", "target": "row:0" },
        {
          "expect": {
            "focus": "row:0",
            "attrs": { "row:0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "row:0" },
        {
          "expect": {
            "focus": "row:1",
            "attrs": { "row:1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "row:1" },
        {
          "expect": {
            "focus": "row:2",
            "attrs": { "row:2": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "row:2" },
        {
          "expect": {
            "focus": "row:1",
            "attrs": { "row:1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "row:1" },
        {
          "expect": {
            "focus": "row:0",
            "attrs": { "row:0": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "One-column composite; roving tabindex follows the controlled highlighted index."
    },
    {
      "id": "grid.base-ui.uncontrolled-navigation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L110",
      "upstreamTest": "Composite > list > uncontrolled mode",
      "apg": "keyboard",
      "config": {
        "layout": "list",
        "orientation": "vertical",
        "items": 3
      },
      "steps": [
        { "event": "focus", "target": "row:0" },
        { "event": "key", "key": "ArrowDown", "target": "row:0" },
        {
          "expect": {
            "focus": "row:1",
            "attrs": { "row:1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "row:1" },
        {
          "expect": {
            "focus": "row:2",
            "attrs": { "row:2": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "row:2" },
        {
          "expect": {
            "focus": "row:1",
            "attrs": { "row:1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "row:1" },
        {
          "expect": {
            "focus": "row:0",
            "attrs": { "row:0": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "Same as controlled, without a highlightedIndex prop."
    },
    {
      "id": "grid.base-ui.home-key-first-item",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L303",
