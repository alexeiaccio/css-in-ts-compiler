        {
          "expect": {
            "focus": "row:2",
            "attrs": { "row:2": { "tabindex": "0" } }
          }
        }
      ]
    },
    {
      "id": "grid.base-ui.on-loop-list",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/internals/composite/root/CompositeRoot.test.tsx#L346",
      "upstreamTest": "Composite > list > calls onLoop and uses its return value",
      "apg": "keyboard",
      "config": {
        "layout": "list",
        "orientation": "vertical",
        "items": 9,
        "onLoop": "returns-index-1"
      },
      "steps": [
        { "event": "focus", "target": "row:8" },
        { "event": "key", "key": "ArrowDown", "target": "row:8" },
