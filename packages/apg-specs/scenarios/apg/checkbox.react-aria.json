  "scenarios": [
    {
      "id": "checkbox.react-aria.hover-state-and-callbacks",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Checkbox.test.js#L107",
      "upstreamTest": "Checkbox > should support hover",
      "apg": "extension",
      "config": { "part": "checkbox" },
      "steps": [
        { "event": "hover", "target": "checkbox" },
        {
          "expect": {
            "attrs": { "label": { "data-hovered": "true" } },
            "events": { "onHoverStart": [1], "onHoverChange": [1] }
          }
        },
        { "event": "unhover", "target": "checkbox" },
        {
          "expect": {
            "attrs": { "label": { "data-hovered": null } },
            "events": { "onHoverEnd": [1], "onHoverChange": [2] }
          }
        }
      ],
      "notes": "Hover state lives on the wrapping label."
    },
    {
      "id": "checkbox.react-aria.focus-visible-on-tab",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Checkbox.test.js#L138",
      "upstreamTest": "Checkbox > should support focus ring",
      "apg": "extension",
      "config": { "part": "checkbox" },
      "steps": [
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "checkbox",
            "attrs": { "label": { "data-focus-visible": "true" } }
          }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "attrs": { "label": { "data-focus-visible": null } } } }
      ],
      "notes": "Keyboard focus marks the label data-focus-visible."
    },
    {
      "id": "checkbox.react-aria.focus-events",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Checkbox.test.js#L160",
      "upstreamTest": "Checkbox > should support focus events",
