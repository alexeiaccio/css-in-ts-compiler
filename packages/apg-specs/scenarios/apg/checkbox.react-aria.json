    {
      "id": "checkbox.react-aria.group-focus-events",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/CheckboxGroup.test.js#L327",
      "upstreamTest": "should support focus events",
