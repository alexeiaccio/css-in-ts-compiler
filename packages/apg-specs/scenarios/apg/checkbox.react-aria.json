    {
      "id": "checkbox.react-aria.s1-group-defaults",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/checkbox/CheckboxGroup.test.js#L30",
      "upstreamTest": "CheckboxGroup > handles defaults",
      "apg": "states",
      "config": {
        "group": true,
        "label": "Favorite Pet",
        "values": ["dogs", "cats", "dragons"]
      },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": {
              "group": { "role": "group" },
              "checkbox:0": { "checked": "false" },
              "checkbox:2": { "checked": "false" }
            }
          }
        },
        { "event": "click", "target": "checkbox:2" },
        {
          "expect": {
            "attrs": { "checkbox:2": { "checked": "true" } },
            "events": { "onChange": [["dragons"]] }
          }
        }
      ],
      "notes": "S1 group: default value array is empty and click reports the selected value."
    },
    {
      "id": "checkbox.react-aria.s1-group-keyboard-space-toggles",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/checkbox/CheckboxGroup.test.js#L866",
      "upstreamTest": "CheckboxGroup > keyboard > should select the correct checkbox regardless of orientation and disabled checkboxes",
      "apg": "keyboard",
      "config": {
        "group": true,
        "orientation": "vertical",
        "disabledIndexes": [1, 2],
        "values": ["soccer", "baseball", "basketball", "tennis", "rugby"]
      },
      "steps": [
        { "event": "click", "target": "checkbox:0" },
        { "expect": { "attrs": { "checkbox:0": { "checked": "true" } } } },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "checkbox:3" } },
        { "event": "key", "key": " ", "target": "checkbox:3" },
        { "expect": { "attrs": { "checkbox:3": { "checked": "true" } } } },
        { "event": "focus", "target": "checkbox:4" },
        { "event": "key", "key": " ", "target": "checkbox:4" },
        { "expect": { "attrs": { "checkbox:4": { "checked": "true" } } } },
        { "event": "focus", "target": "checkbox:0" },
        { "event": "key", "key": " ", "target": "checkbox:0" },
        { "expect": { "attrs": { "checkbox:0": { "checked": "false" } } } }
      ],
      "notes": "Disabled checkboxes are skipped in the tab order; Space toggles the focused checkbox regardless of group orientation or locale."
    }
