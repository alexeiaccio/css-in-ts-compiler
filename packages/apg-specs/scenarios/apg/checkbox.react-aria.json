          }
        }
      ],
      "notes": "onFocusChange mirrors focus/blur transitions."
    },
    {
      "id": "checkbox.react-aria.press-state-pointer",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Checkbox.test.js#L191",
      "upstreamTest": "Checkbox > should support press state",
      "apg": "extension",
      "config": { "part": "checkbox" },
      "steps": [
        { "event": "pointerdown", "target": "label" },
        { "expect": { "attrs": { "label": { "data-pressed": "true" } } } },
        { "event": "pointerup", "target": "label" },
        {
          "expect": {
            "attrs": { "label": { "data-pressed": null } },
            "events": { "onPress": [1], "onClick": [1], "onClickCapture": [1] }
          }
        }
      ],
      "notes": "Press feedback on the label; toggle fires on release."
    },
    {
      "id": "checkbox.react-aria.press-state-keyboard-space",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Checkbox.test.js#L222",
      "upstreamTest": "Checkbox > should support press state with keyboard",
      "apg": "keyboard",
      "config": { "part": "checkbox" },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "checkbox" } },
        { "event": "key", "key": " ", "phase": "down", "target": "checkbox" },
        { "expect": { "attrs": { "label": { "data-pressed": "true" } } } },
        { "event": "key", "key": " ", "phase": "up", "target": "checkbox" },
        {
          "expect": {
            "attrs": { "label": { "data-pressed": null } },
            "events": { "onPress": [1], "onClick": [1] }
          }
        }
      ],
      "notes": "Space held down keeps data-pressed until keyup."
    },
