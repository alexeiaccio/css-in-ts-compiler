          }
        },
        { "event": "click", "target": "menuitem:1" },
        { "expect": { "attrs": { "menuitem:1": { "aria-checked": "true" } } } },
        { "event": "click", "target": "menuitem:1" },
        { "expect": { "attrs": { "menuitem:1": { "aria-checked": "false" } } } }
      ]
    },
