    {
      "id": "menu-button.ariakit.keyboard-navigation-between-items",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-core-interactions/test.ts#L139",
      "upstreamTest": "navigate through items with keyboard",
      "apg": "keyboard",
      "config": { "items": ["Edit", "Share", "Report"] },
      "steps": [
        { "event": "click", "target": "trigger" },
        { "event": "key", "key": "ArrowDown", "target": "menu" },
        { "expect": { "focus": "menuitem:0" } },
        { "event": "key", "key": "ArrowDown", "target": "menuitem:0" },
        { "expect": { "focus": "menuitem:1" } },
        { "event": "key", "key": "ArrowDown", "target": "menuitem:1" },
        { "expect": { "focus": "menuitem:2" } },
        { "event": "key", "key": "ArrowLeft", "target": "menuitem:2" },
        { "expect": { "focus": "menuitem:2" } },
        { "event": "key", "key": "ArrowRight", "target": "menuitem:2" },
        { "expect": { "focus": "menuitem:2" } },
        { "event": "key", "key": "Home", "target": "menuitem:2" },
        { "expect": { "focus": "menuitem:0" } },
        { "event": "key", "key": "End", "target": "menuitem:0" },
        { "expect": { "focus": "menuitem:2" } }
      ]
    },
    {
      "id": "menu-button.ariakit.hover-highlights-item-and-keeps-menu-focus",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-core-interactions/test.ts#L157",
      "upstreamTest": "navigate through items with mouse",
      "apg": "mouse",
      "config": { "items": ["Edit", "Share", "Delete"] },
      "steps": [
        { "event": "key", "key": "Enter", "target": "trigger" },
        { "event": "hover", "target": "menuitem:1" },
        {
          "expect": {
            "focus": "menu",
            "attrs": { "menuitem:1": { "data-active-item": "" } }
          }
        },
        { "event": "hover", "target": "menuitem:2" },
        {
          "expect": {
            "focus": "menu",
            "attrs": { "menuitem:2": { "data-active-item": null } }
          }
        }
      ],
      "notes": "A disabled trailing item consumes hover without becoming active."
    },
