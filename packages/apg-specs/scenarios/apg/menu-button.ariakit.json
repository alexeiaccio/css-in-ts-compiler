  "scenarios": [
    {
      "id": "menu-button.ariakit.click-opens-menu-focuses-container",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-core-interactions/test.ts#L6",
      "upstreamTest": "show/hide on click",
      "apg": "keyboard",
      "config": { "items": ["Edit", "Share", "Report"] },
      "steps": [
        { "expect": { "hidden": ["menu"] } },
        { "event": "click", "target": "trigger" },
        {
          "expect": {
            "visible": ["menu"],
            "focus": "menu",
            "attrs": {
              "trigger": { "aria-expanded": "true", "aria-haspopup": "menu" }
            }
          }
        },
        { "event": "click", "target": "trigger" },
        { "expect": { "hidden": ["menu"], "focus": "trigger" } }
      ],
      "notes": "On pointer open the popup container takes focus; the first item is not focused."
    },
    {
      "id": "menu-button.ariakit.enter-opens-and-focuses-first-item",
