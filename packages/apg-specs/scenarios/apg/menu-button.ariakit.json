      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-nested-interactions/test.ts#L4",
      "upstreamTest": "show/hide submenu on click",
      "apg": "keyboard",
      "config": {
        "items": ["Open", "Zoom"],
        "submenu": { "at": 1, "items": ["Find", "Find Next"] }
      },
      "steps": [
        { "expect": { "hidden": ["submenu:1"] } },
        { "event": "click", "target": "trigger" },
        { "event": "click", "target": "menuitem:1" },
        { "expect": { "visible": ["submenu:1"], "focus": "menuitem:1/0" } },
