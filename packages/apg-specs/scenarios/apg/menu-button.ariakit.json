    {
      "id": "menu-button.ariakit.typeahead-selects-matching-item",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-core-interactions/test.ts#L227",
      "upstreamTest": "typeahead",
      "apg": "keyboard",
      "config": { "items": ["Edit", "Report", "Share"] },
      "steps": [
        { "event": "click", "target": "trigger" },
        { "expect": { "focus": "menu" } },
        { "event": "type", "text": "d", "target": "menu" },
        { "expect": { "focus": "menu" } },
        { "event": "type", "text": "re", "target": "menu" },
        { "expect": { "focus": "menuitem:1" } }
      ],
      "notes": "A single-key match is treated as a pending typeahead prefix and keeps focus on the menu until it resolves."
    },
    {
      "id": "menu-button.ariakit.menu-is-owned-by-trigger",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-core-interactions/test.ts#L236",
      "upstreamTest": "https://github.com/ariakit/ariakit/issues/3342",
      "apg": "extension",
      "config": { "items": ["Edit", "Share", "Report"] },
      "steps": [
        { "event": "click", "target": "trigger" },
        { "expect": { "attrs": { "trigger": { "data-owns": "menu" } } } }
      ],
      "notes": "The rendered popup is a sibling owned by the trigger element; a library-neutral way to assert ownership is role/aria linkage."
    },
    {
      "id": "menu-button.ariakit.checkbox-item-toggles-on-click",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menu-checkbox-interactions/test.ts#L11",
      "upstreamTest": "check/uncheck menu item on click",
