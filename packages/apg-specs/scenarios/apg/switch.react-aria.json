  "scenarios": [
    {
      "id": "switch.react-aria.hover-state-and-callbacks",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L121",
      "upstreamTest": "Switch > should support hover",
      "apg": "extension",
      "config": { "part": "switch" },
      "steps": [
        { "event": "prop", "set": {} },
        { "expect": { "attrs": { "label": { "data-hovered": null } } } },
        { "event": "hover", "target": "switch" },
        {
          "expect": {
            "attrs": { "label": { "data-hovered": "true" } },
            "events": { "onHoverStart": [1], "onHoverChange": [1] }
          }
        },
        { "event": "unhover", "target": "switch" },
        {
          "expect": {
            "attrs": { "label": { "data-hovered": null } },
            "events": { "onHoverEnd": [1], "onHoverChange": [2] }
          }
        }
      ],
      "notes": "Hover state lives on the wrapping label element."
    },
    {
      "id": "switch.react-aria.focus-visible-on-tab",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L152",
      "upstreamTest": "Switch > should support focus ring",
      "apg": "extension",
      "config": { "part": "switch" },
      "steps": [
        { "event": "prop", "set": {} },
        { "expect": { "attrs": { "label": { "data-focus-visible": null } } } },
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "switch",
            "attrs": { "label": { "data-focus-visible": "true" } }
          }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "attrs": { "label": { "data-focus-visible": null } } } }
      ],
      "notes": "Keyboard focus marks the label data-focus-visible."
    },
    {
      "id": "switch.react-aria.focus-events",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L172",
      "upstreamTest": "Switch > should support focus events",
      "apg": "focus",
      "config": { "part": "switch" },
      "steps": [
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "switch",
            "events": { "onFocus": [1], "onFocusChange": [true] }
          }
        },
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "button:steal",
            "events": { "onBlur": [1], "onFocusChange": [false] }
          }
        }
      ],
      "notes": "onFocusChange mirrors focus/blur transitions."
    },
    {
      "id": "switch.react-aria.press-state-pointer",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L204",
      "upstreamTest": "Switch > should support press state",
      "apg": "extension",
      "config": { "part": "switch" },
      "steps": [
        { "event": "pointerdown", "target": "label" },
        { "expect": { "attrs": { "label": { "data-pressed": "true" } } } },
        { "event": "pointerup", "target": "label" },
        {
          "expect": {
            "attrs": { "label": { "data-pressed": null } },
            "events": { "onPress": [1], "onClick": [1], "onClickCapture": [1] }
          }
        }
      ],
      "notes": "Press feedback sits on the label while the toggle fires on release."
    },
    {
      "id": "switch.react-aria.press-state-keyboard-space",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L235",
      "upstreamTest": "Switch > should support press state with keyboard",
      "apg": "keyboard",
      "config": { "part": "switch" },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "switch" } },
        { "event": "key", "key": " ", "phase": "down", "target": "switch" },
        { "expect": { "attrs": { "label": { "data-pressed": "true" } } } },
        { "event": "key", "key": " ", "phase": "up", "target": "switch" },
        {
          "expect": {
            "attrs": { "label": { "data-pressed": null } },
            "events": { "onPress": [1], "onClick": [1] }
          }
        }
      ],
      "notes": "Space held down keeps data-pressed until keyup."
    },
    {
      "id": "switch.react-aria.disabled-state",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L264",
      "upstreamTest": "Switch > should support disabled state",
      "apg": "states",
      "config": { "part": "switch", "isDisabled": true },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": {
              "switch": { "disabled": "" },
              "label": { "data-disabled": "true" }
            }
          }
        }
      ],
      "notes": "Disabled switch is natively disabled and marks the label data-disabled."
    },
    {
      "id": "switch.react-aria.selected-state-onchange",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L279",
      "upstreamTest": "Switch > should support selected state",
      "apg": "states",
      "config": { "part": "switch", "checked": false },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": {
              "switch": { "checked": "false" },
              "label": { "data-selected": null }
            }
          }
        },
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": {
              "switch": { "checked": "true" },
              "label": { "data-selected": "true" }
            },
            "events": { "onChange": [true] }
          }
        },
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": {
              "switch": { "checked": "false" },
              "label": { "data-selected": null }
            },
            "events": { "onChange": [false] }
          }
        }
      ],
      "notes": "Checked state is the native input's checked property; onChange reports the new value."
    },
    {
      "id": "switch.react-aria.read-only-state",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Switch.test.js#L311",
      "upstreamTest": "Switch > should support read only state",
      "apg": "states",
      "config": { "part": "switch", "isReadOnly": true },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": {
              "switch": { "aria-readonly": "true" },
              "label": { "data-readonly": "" }
            }
          }
        }
      ],
      "notes": "Read-only switch exposes aria-readonly and data-readonly."
    },
    {
      "id": "switch.react-aria.s1-switch-unchecked-click",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/switch/Switch.test.js#L30",
      "upstreamTest": "Switch > Switch default unchecked can be checked",
      "apg": "states",
      "config": { "part": "switch", "nativelyWrapped": true },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": { "switch": { "value": "on", "checked": "false" } }
          }
        },
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": { "switch": { "checked": "true" } },
            "events": { "onChange": [true] }
          }
        },
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": { "switch": { "checked": "false" } },
            "events": { "onChange": [false] }
          }
        }
      ],
      "notes": "S1 switch is a labelled checkbox input with role switch; default value is 'on'."
    },
    {
      "id": "switch.react-aria.s1-switch-disabled",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/switch/Switch.test.js#L98",
      "upstreamTest": "Switch > Switch can be disabled",
      "apg": "states",
      "config": { "part": "switch", "isDisabled": true },
      "steps": [
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": { "switch": { "checked": "false" } },
            "events": { "onChange": [0] }
          }
        }
      ],
      "notes": "Disabled switch ignores clicks and fires no onChange."
    },
    {
      "id": "switch.react-aria.s1-switch-read-only",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/switch/Switch.test.js#L174",
      "upstreamTest": "Switch > Switch supports readOnly",
      "apg": "states",
      "config": { "part": "switch", "isReadOnly": true, "isSelected": true },
      "steps": [
        { "event": "click", "target": "switch" },
        {
          "expect": {
            "attrs": { "switch": { "checked": "true" } },
            "events": { "onChange": [0] }
          }
        }
      ],
      "notes": "Read-only keeps the current checked state and fires no onChange."
    },
    {
      "id": "switch.react-aria.s1-switch-aria-label",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/switch/Switch.test.js#L113",
      "upstreamTest": "Switch > Switch can have a non-visible label",
      "apg": "aria",
      "config": { "part": "switch", "aria-label": "not visible" },
      "steps": [
        { "event": "prop", "set": {} },
        { "expect": { "attrs": { "switch": { "aria-label": "not visible" } } } }
      ],
      "notes": "Accessible name can come from aria-label with no visible label."
    },
    {
      "id": "switch.react-aria.s1-switch-exclude-from-tab-order",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/switch/Switch.test.js#L164",
      "upstreamTest": "Switch > Switch supports excludeFromTabOrder",
      "apg": "keyboard",
      "config": { "part": "switch", "excludeFromTabOrder": true },
      "steps": [
        { "event": "prop", "set": {} },
        { "expect": { "attrs": { "switch": { "tabIndex": "-1" } } } }
      ],
      "notes": "excludeFromTabOrder sets tabIndex=-1."
    }
  ]
}
