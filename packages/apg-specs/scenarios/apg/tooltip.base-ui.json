    {
      "id": "tooltip.base-ui.opens-on-hover-after-open-delay",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tooltip/root/TooltipRoot.test.tsx#L87",
      "upstreamTest": "<Tooltip.Root /> > uncontrolled open > should open when the trigger is hovered",
      "apg": "pointer",
      "config": { "delay": 600 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 300 },
        { "expect": { "visible": [] } },
        { "event": "wait", "ms": 300 },
        { "expect": { "visible": ["tooltip:0"] } }
      ],
      "notes": "OPEN_DELAY is 600ms; the first wait is the pending window."
    },
