  "skipped": [
    {
      "reason": "animation and mount lifecycle (data-starting-style / data-ending-style / data-instant, getAnimations, CSS keyframes, exit-animation onOpenChangeComplete timings) - styling and timing internals"
    },
    {
      "reason": "popupConformanceTests and describeConformance suites (ref forwarding, render props, prop merging, error messages) - React-API-only"
    },
    {
      "reason": "positioning and cursor tracking (tooltip/positioner, trackCursorAxis x/both, side, sideOffset, getBoundingClientRect assertions) - placement internals"
    },
    {
      "reason": "inline style assertions (positioner pointer-events for disableHoverablePopup and trackCursorAxis, inline opacity removal)"
    },
    {
      "reason": "BaseUIChangeEventDetails API assertions (cancel(), allowPropagation(), details.reason, stopPropagation spy)"
    },
    {
      "reason": "prop: actionsRef imperative unmount/close methods and preventUnmountOnClose keep-mounted flows"
    },
    {
      "reason": "controlled prop updates (`uses the latest closeDelay after the prop updates`, `does not close when open is controlled`) that rerender with new props mid-timer"
    },
    {
      "reason": "detached-trigger and multiple-detached-trigger variants; the contained-trigger behaviour is ported once"
    },
    {
      "reason": "shadow-root and empty composedPath nested-trigger fallbacks, touch-pointer nested reopen paths, and safePolygon suppression"
    },
    {
      "reason": "rare races (`does not re-announce an open outer tooltip`, `rapidly moving back to a nested trigger`) that require fake-clock interleaving with external opens"
    },
    {
      "reason": "provider closeDelay/trigger-delay precedence variants beyond the single override scenario"
    }
  ],
