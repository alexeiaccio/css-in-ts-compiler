    {
      "id": "listbox.react-aria.replace-selection-pointer",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/ListBox.test.js#L755",
      "upstreamTest": "should perform selection with single selection (selectionBehavior replace, mouse)",
      "apg": "selection",
      "config": {
        "items": ["Cat", "Dog", "Kangaroo"],
        "selectionMode": "single",
        "selectionBehavior": "replace"
      },
      "steps": [
        { "event": "click", "target": "option:2" },
        {
          "expect": {
            "attrs": { "option:2": { "aria-selected": "true" } },
            "events": { "onSelectionChange": ["kangaroo"] }
          }
        },
        { "event": "click", "target": "option:1" },
        {
          "expect": {
            "attrs": {
              "option:1": { "aria-selected": "true" },
              "option:2": { "aria-selected": "false" }
            },
            "events": { "onSelectionChange": ["dog"] }
          }
        },
        { "event": "click", "target": "option:1" },
        {
          "expect": {
            "attrs": {
              "option:1": { "aria-selected": "false" },
              "option:2": { "aria-selected": "false" }
            },
            "events": { "onSelectionChange": [] }
          }
        }
      ],
      "notes": "Mouse/touch variant. With a keyboard interaction the initial focus selects the first row, so onSelectionChange fires an extra time; that is not restated here."
