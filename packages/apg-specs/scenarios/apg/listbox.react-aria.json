      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/listbox/ListBox.test.js#L659",
      "upstreamTest": "supports item selection using the Spacebar after search times out",
      "apg": "selection",
      "config": {
        "items": ["Foo", "Bar", "Baz", "Blah", "Bleh", "Foo Bar", "Foo Baz"],
        "selectionMode": "single",
        "autoFocus": "first"
      },
      "steps": [
        { "event": "type", "text": "F", "target": "listbox" },
        { "event": "type", "text": "O", "target": "listbox" },
        { "event": "type", "text": "O", "target": "listbox" },
        { "event": "type", "text": " ", "target": "listbox" },
        {
          "expect": {
            "focus": "option:5",
            "attrs": { "option:5": { "aria-selected": "false" } },
            "events": {}
          }
        },
        { "event": "type", "text": "B", "target": "listbox" },
        { "expect": { "focus": "option:5" } },
        { "event": "prop", "prop": "typeaheadTimeoutElapsed", "value": true },
        { "event": "key", "key": "Space", "target": "option:5" },
        {
          "expect": {
            "attrs": { "option:5": { "aria-selected": "true" } },
            "events": { "onSelectionChange": ["Foo Bar"] }
          }
        }
      ],
      "notes": "A space typed while a typeahead buffer is active is treated as search text; only after the buffer timeout is Space a selection key. typeaheadTimeoutElapsed stands in for advancing the typeahead timer."
