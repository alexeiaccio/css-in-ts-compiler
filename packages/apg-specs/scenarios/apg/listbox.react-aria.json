      "upstreamTest": "allows user to change listbox focus via up/down arrow keys",
      "apg": "keyboard",
      "config": {
        "items": ["Foo", "Bar", "Baz", "Blah", "Bleh", "Foo Bar", "Foo Baz"],
        "selectionMode": "single",
        "autoFocus": "first"
      },
      "steps": [
        { "expect": { "focus": "option:0" } },
        { "event": "key", "key": "ArrowDown", "target": "option:0" },
        { "expect": { "focus": "option:1" } },
        { "event": "key", "key": "ArrowUp", "target": "option:1" },
        { "expect": { "focus": "option:0" } }
      ]
