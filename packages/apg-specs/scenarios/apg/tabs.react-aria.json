    },
    {
      "id": "tabs.react-aria.programmatic-selected-tabindex",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L912",
      "upstreamTest": "updates the tab index of the selected tab if programmatically changed",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 2
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "tabindex": "-1" },
              "tab:1": { "tabindex": "-1" },
              "tab:2": { "tabindex": "0" }
            }
          }
        },
        { "event": "prop", "prop": "selectedKey", "value": 0 },
        {
          "expect": {
            "attrs": {
              "tab:0": { "tabindex": "0" },
              "tab:1": { "tabindex": "-1" },
              "tab:2": { "tabindex": "-1" }
            }
          }
        }
      ],
      "notes": "Changing the selected key programmatically moves the roving tab stop."
    },
    {
      "id": "tabs.react-aria.force-mount-inert",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L569",
      "upstreamTest": "should support shouldForceMount",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0,
        "forceMount": true
      },
      "steps": [
        {
          "expect": {
            "visible": ["tabpanel:0"],
            "attrs": {
              "tabpanel:1": { "inert": "true" },
              "tabpanel:2": { "inert": "true" }
            }
          }
        },
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": {
              "tabpanel:0": { "inert": "true" },
              "tabpanel:1": { "inert": null },
              "tabpanel:2": { "inert": "true" }
            }
          }
        }
      ],
      "notes": "shouldForceMount keeps all panels mounted and marks the inactive ones inert."
    },
    {
      "id": "tabs.react-aria.selection-across-interaction-types",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L509",
