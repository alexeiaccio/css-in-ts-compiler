      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowDown", "target": "tab:0" },
        { "expect": { "attrs": { "tab:1": { "aria-selected": "true" } } } },
        { "event": "key", "key": "ArrowUp", "target": "tab:1" },
        { "expect": { "attrs": { "tab:0": { "aria-selected": "true" } } } },
        { "event": "key", "key": "ArrowLeft", "target": "tab:0" },
        { "expect": { "attrs": { "tab:1": { "aria-selected": "true" } } } },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        { "expect": { "attrs": { "tab:0": { "aria-selected": "true" } } } }
