    },
    {
      "id": "tabs.react-aria.arrow-vertical-rtl",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L474",
      "upstreamTest": "allows user to change tab item selection via arrow keys with vertical tabs (rtl)",
