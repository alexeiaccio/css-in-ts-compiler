{
  "pattern": "tabs",
  "source": "react-aria",
  "commit": "99e610236887da619ad9d54a1cd87983166c043d",
  "license": "Apache-2.0",
  "scenarios": [
    {
      "id": "tabs.react-aria.arrow-horizontal",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L122",
      "upstreamTest": "allows user to change tab item select via arrow keys with horizontal tabs",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": { "tab:1": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "tab:0" },
        { "event": "key", "key": "ArrowDown", "target": "tab:0" },
        { "expect": { "attrs": { "tab:0": { "aria-selected": "true" } } } }
      ],
      "notes": "Horizontal tablists respond to Left/Right only; Up/Down are ignored (left to the browser)."
    },
    {
      "id": "tabs.react-aria.arrow-vertical",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L190",
      "upstreamTest": "allows user to change tab item select via arrow keys with vertical tabs",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowDown", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": { "tab:1": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "Vertical tablists also allow Left/Right to move selection (react-aria treats them as previous/next in a vertical stack)."
    },
    {
