      "notes": "Vertical RTL still allows Up/Down and Left/Right to move between tabs."
    },
    {
      "id": "tabs.react-aria.arrow-wraps-across-ends",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L216",
      "upstreamTest": "wraps focus from first to last/last to first item",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowLeft", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "APG optional wrapping: react-aria wraps by default."
    },
    {
      "id": "tabs.react-aria.home-end",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L235",
      "upstreamTest": "select last item via end key / select first item via home key",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "End", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "Home", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "Home/End move to the first/last tab regardless of orientation."
    },
    {
      "id": "tabs.react-aria.manual-activation-enter",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L254",
      "upstreamTest": "not select via left / right keys if keyboardActivation is manual, select on enter / spacebar",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "false" } }
          }
        },
        { "event": "key", "key": "Enter", "target": "tab:2" },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "false" },
              "tab:2": { "aria-selected": "true" }
            },
            "events": { "onSelectionChange": ["tab:2"] }
          }
        }
      ],
      "notes": "keyboardActivation=manual: arrows move focus only; Enter commits (Space is the other commit key)."
    },
    {
      "id": "tabs.react-aria.click-selects",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L286",
      "upstreamTest": "supports using click to change tab",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": { "tab:1": { "aria-selected": "true" } },
            "visible": ["tabpanel:1"],
            "events": { "onSelectionChange": ["tab:1"] }
          }
        }
      ],
      "notes": "Upstream also asserts the panel id/role/labelledby and text content; here only selection, panel visibility and the callback are restated."
    },
    {
      "id": "tabs.react-aria.tab-into-selects-selected-tab",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L348",
      "upstreamTest": "should focus the selected tab when tabbing in for the first time",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 1
      },
      "steps": [
        { "event": "key", "key": "Tab", "target": "tablist" },
        { "expect": { "focus": "tab:1" } }
      ],
      "notes": "Roving tabindex: Tab enters the tablist at the selected tab."
    },
    {
      "id": "tabs.react-aria.arrow-skips-disabled",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L351",
      "upstreamTest": "should support isDisabled prop on tab",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0,
        "disabled": [1]
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "A disabled middle tab is skipped in one keypress and never focused."
    },
    {
      "id": "tabs.react-aria.all-disabled-focuses-panel",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L399",
      "upstreamTest": "selects first tab if all tabs are disabled",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "disabled": [0, 1, 2]
      },
      "steps": [
        { "event": "key", "key": "Tab", "target": "tablist" },
        {
          "expect": {
            "focus": "tabpanel:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "When every tab is disabled react-aria still marks the first selected but moves focus to the active panel."
    },
    {
      "id": "tabs.react-aria.disabled-click-no-selection",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L385",
      "upstreamTest": "disabled tabs cannot be pressed",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0,
        "disabled": [1]
      },
      "steps": [
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            },
            "events": { "onSelectionChange": [] }
          }
        }
      ],
      "notes": "A disabled tab ignores pointer presses and fires no selection callback."
    },
    {
      "id": "tabs.react-aria.first-non-disabled-tab",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L375",
      "upstreamTest": "finds the first non-disabled tab",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "disabled": [0]
      },
      "steps": [
        { "event": "key", "key": "Tab", "target": "tablist" },
        { "expect": { "focus": "tab:1" } },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        { "expect": { "focus": "tab:2" } }
      ],
      "notes": "When the first tab is disabled, tabbing in lands on the first enabled tab."
    },
    {
      "id": "tabs.react-aria.panel-tabindex-focusable-content",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L785",
      "upstreamTest": "tabpanel should have tabIndex=0 only when there are no focusable elements",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 2,
        "selected": 0
      },
      "steps": [
        { "expect": { "attrs": { "tabpanel:0": { "tabindex": null } } } },
        { "event": "click", "target": "tab:1" },
        { "expect": { "attrs": { "tabpanel:1": { "tabindex": "0" } } } },
        { "event": "click", "target": "tab:0" },
        { "expect": { "attrs": { "tabpanel:0": { "tabindex": null } } } }
      ],
      "notes": "Panel 0 contains a focusable input (no panel tabindex); panel 1 only has a disabled input, so it gets tabindex=0."
    },
    {
      "id": "tabs.react-aria.panel-aria-relationships",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/tabs/Tabs.test.js#L300",
      "upstreamTest": "supports using click to change tab (aria-controls/aria-labelledby wiring)",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": {
              "tab:1": { "aria-controls": "tabpanel:1" },
              "tabpanel:1": { "aria-labelledby": "tab:1" }
            }
          }
        }
      ],
      "notes": "Relationship attribute values are symbolic target references (`tab:<i>` / `tabpanel:<i>`), resolved to the real element ids during replay."
    },
    {
      "id": "tabs.react-aria.aria-orientation-vertical",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Tabs.test.js#L461",
      "upstreamTest": "should support orientation",
