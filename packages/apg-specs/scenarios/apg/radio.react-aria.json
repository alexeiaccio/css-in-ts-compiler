  "scenarios": [
    {
      "id": "radio.react-aria.hover-sets-hovered",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L214",
      "upstreamTest": "RadioGroup > should support hover",
      "apg": "extension",
      "config": { "items": 3, "values": ["a", "b", "c"], "checked": null },
      "steps": [
        { "expect": { "attrs": { "radio:0": { "data-hovered": null } } } },
        { "event": "hover", "target": "radio:0" },
        {
          "expect": {
            "attrs": { "radio:0": { "data-hovered": "true" } },
            "events": {
              "onHoverStart": ["radio:0"],
              "onHoverChange": ["radio:0"]
            }
          }
        },
        { "event": "unhover", "target": "radio:0" },
        {
          "expect": {
            "attrs": { "radio:0": { "data-hovered": null } },
            "events": {
              "onHoverStart": ["radio:0"],
              "onHoverChange": ["radio:0", null],
              "onHoverEnd": ["radio:0"]
            }
          }
        }
      ],
      "notes": "Hover is not part of the APG radio contract; ported as an extension because upstream asserts it."
    },
    {
      "id": "radio.react-aria.press-pointer-sets-pressed",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L266",
      "upstreamTest": "RadioGroup > should support press state",
      "apg": "pointer",
      "config": { "items": 3, "values": ["a", "b", "c"], "checked": null },
      "steps": [
        { "expect": { "attrs": { "radio:0": { "data-pressed": null } } } },
        { "event": "pointerdown", "target": "radio:0" },
        { "expect": { "attrs": { "radio:0": { "data-pressed": "true" } } } },
        { "event": "pointerup", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "value": "a",
            "attrs": { "radio:0": { "data-pressed": null } },
            "events": { "onPress": ["a"], "onClick": ["a"] }
          }
        }
      ]
    },
    {
      "id": "radio.react-aria.press-keyboard-space",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L297",
      "upstreamTest": "RadioGroup > should support press state with keyboard",
      "apg": "keyboard",
      "config": { "items": 3, "values": ["a", "b", "c"], "checked": null },
      "steps": [
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "radio:0",
            "attrs": { "radio:0": { "data-pressed": null } }
          }
        },
        {
          "event": "key",
          "key": "Space",
          "phase": "down",
          "target": "radio:0"
        },
        { "expect": { "attrs": { "radio:0": { "data-pressed": "true" } } } },
        { "event": "key", "key": "Space", "phase": "up", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "value": "a",
            "attrs": { "radio:0": { "data-pressed": null } },
            "events": { "onPress": ["a"], "onClick": ["a"] }
          }
        }
      ]
    },
    {
