        "values": ["a", "b", "c"],
        "radioDescribedby": "test"
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "radio:0": { "aria-describedby": "test" },
              "radio:1": { "aria-describedby": "test" },
