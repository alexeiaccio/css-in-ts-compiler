            }
          }
        }
      ]
    },
    {
      "id": "radio.react-aria.focus-events-enter-leave",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L704",
      "upstreamTest": "RadioGroup > should support focus events",
      "apg": "focus",
      "config": { "items": 3, "values": ["a", "b", "c"], "checked": null },
      "steps": [
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "radio:0",
            "events": {
              "onFocus": ["radio:0"],
              "onBlur": [],
              "onFocusChange": ["radio:0"]
            }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:1",
            "events": {
              "onFocus": ["radio:0"],
              "onBlur": [],
              "onFocusChange": ["radio:0"]
            }
          }
        },
        { "event": "key", "key": "Tab", "target": "radio:1" },
        {
          "expect": {
            "focus": null,
            "events": {
              "onFocus": ["radio:0"],
              "onBlur": ["radio:1"],
              "onFocusChange": ["radio:0", null]
            }
          }
        }
      ],
      "notes": "Focus change inside the group does not fire per-radio blur/focus; leaving the group fires blur and focus-change again."
    },
    {
      "id": "radio.react-aria.arrow-skips-non-radio-children",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L794",
      "upstreamTest": "RadioGroup > should navigate within the group using ArrowRight/Left but skip non-radios",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "extraChildIn": "radio:0"
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowRight", "target": "radio:0" },
        { "expect": { "focus": "radio:1" } },
        { "event": "key", "key": "ArrowLeft", "target": "radio:1" },
        { "expect": { "focus": "radio:0" } }
      ]
    },
    {
      "id": "radio.react-aria.repeated-click-same-radio-no-focus-events",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L824",
      "upstreamTest": "RadioGroup > should not trigger onBlur/onFocus on sequential presses of a Radio",
      "apg": "focus",
      "config": { "items": 2, "values": ["a", "b"], "checked": null },
      "steps": [
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "events": { "onFocus": ["radio:0"], "onBlur": [] }
          }
        },
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "events": { "onFocus": ["radio:0"], "onBlur": [] }
          }
        }
      ]
    },
    {
      "id": "radio.react-aria.focus-moves-between-radios-fires-blur",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L854",
      "upstreamTest": "RadioGroup > should trigger onBlur when moving focus between different Radio buttons",
      "apg": "focus",
      "config": { "items": 2, "values": ["a", "b"], "checked": null },
      "steps": [
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "events": { "onFocusA": ["radio:0"], "onBlurA": [] }
          }
        },
        { "event": "click", "target": "radio:1" },
        {
          "expect": {
            "checked": "radio:1",
            "events": {
              "onFocusA": ["radio:0"],
              "onBlurA": ["radio:0"],
              "onFocusB": ["radio:1"]
            }
          }
        }
      ],
      "notes": "Unlike arrow navigation, a pointer press on another radio blurs the first one."
    },
    {
      "id": "radio.react-aria.arrow-skips-disabled-radios",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/%40react-spectrum/s2/test/RadioGroup.test.tsx#L28",
      "upstreamTest": "RadioGroup > ltr + horizontal should select the correct radio via keyboard regardless of orientation and disabled radios",
      "apg": "keyboard",
      "config": {
        "items": 5,
        "values": ["dogs", "cats", "dragons", "unicorns", "chocobo"],
        "checked": null,
        "disabled": [1, 2],
        "orientation": "horizontal",
        "direction": "ltr"
      },
      "steps": [
        {
          "expect": {
            "attrs": { "radiogroup": { "aria-orientation": "horizontal" } }
          }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:3",
            "checked": "radio:3",
            "value": "unicorns"
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "radio:3" },
        {
          "expect": {
            "focus": "radio:4",
            "checked": "radio:4",
            "value": "chocobo"
          }
        }
      ],
      "notes": "Simplified from the upstream tester sequence; the point is that arrows skip the two consecutive disabled radios."
    },
    {
      "id": "radio.react-aria.rtl-horizontal-arrow-direction",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/%40react-spectrum/s2/test/RadioGroup.test.tsx#L28",
      "upstreamTest": "RadioGroup > rtl + horizontal should select the correct radio via keyboard regardless of orientation and disabled radios",
      "apg": "keyboard",
      "config": {
        "items": 5,
        "values": ["dogs", "cats", "dragons", "unicorns", "chocobo"],
        "checked": null,
        "disabled": [1, 2],
        "orientation": "horizontal",
        "direction": "rtl"
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "ArrowLeft", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:3",
            "checked": "radio:3",
            "value": "unicorns"
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "radio:3" },
        {
          "expect": {
            "focus": "radio:0",
            "checked": "radio:0",
            "value": "dogs"
          }
        }
      ],
      "notes": "In rtl, ArrowLeft advances and ArrowRight goes back; direction is not modelled by the spec, so this is an extension."
    }
  ],
