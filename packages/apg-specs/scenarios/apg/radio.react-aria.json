    {
      "id": "radio.react-aria.help-text-describedby",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L463",
      "upstreamTest": "RadioGroup > supports help text",
      "apg": "aria",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "invalid": true,
        "descriptions": {
          "group": "Description Error",
          "radio": "Error Description"
        }
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "radiogroup": { "aria-describedby": "Description Error" },
              "radio:0": { "aria-describedby": "Error Description" }
            }
          }
        }
      ],
      "notes": "Values are the referenced elements' text in source order; react-aria assigns the group's description and error to both the group and every radio."
    },
    {
      "id": "radio.react-aria.tab-does-not-move-within-group",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L496",
      "upstreamTest": "RadioGroup > should not navigate within the group using Tab",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "flavor": "roving"
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "Tab", "target": "radio:0" },
        { "expect": { "focus": null } },
        { "event": "key", "key": "Shift+Tab" },
        { "expect": { "focus": "radio:2", "checked": null } }
      ],
      "notes": "Tab leaves the group as a single stop; upstream's Shift+Tab lands on the last radio when none is checked, diverging from the spec's enter-on-first rule."
    },
    {
      "id": "radio.react-aria.aria-describedby-on-radio",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L590",
      "upstreamTest": "RadioGroup > should support aria-describedby on a radio",
      "apg": "aria",
      "config": {
