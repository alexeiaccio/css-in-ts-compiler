    {
      "id": "radio.react-aria.orientation-attribute-and-arrows",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L444",
      "upstreamTest": "RadioGroup > should support orientation",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "orientation": "horizontal"
      },
      "steps": [
        {
          "expect": {
