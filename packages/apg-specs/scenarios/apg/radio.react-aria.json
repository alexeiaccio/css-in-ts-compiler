    {
      "id": "radio.react-aria.selected-state-on-click",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L352",
      "upstreamTest": "RadioGroup > should support selected state",
      "apg": "pointer",
      "config": { "items": 3, "values": ["a", "b", "c"], "checked": null },
      "steps": [
        { "expect": { "attrs": { "radio:0": { "data-selected": null } } } },
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "value": "a",
            "attrs": { "radio:0": { "data-selected": "true" } },
            "events": { "onChange": ["a"] }
          }
        },
        { "event": "click", "target": "radio:1" },
        {
          "expect": {
            "checked": "radio:1",
            "value": "b",
            "attrs": {
              "radio:0": { "data-selected": null },
              "radio:1": { "data-selected": "true" }
            },
            "events": { "onChange": ["a", "b"] }
          }
        }
      ]
    },
    {
      "id": "radio.react-aria.repeat-arrow-keydown-selects-next",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/RadioGroup.test.js#L383",
      "upstreamTest": "RadioGroup > should support repeat keydown events when holding an arrow key",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "holdArrow": true
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "event": "key",
          "key": "ArrowDown",
          "repeat": true,
          "target": "radio:1"
        },
        {
          "expect": {
            "checked": "radio:2",
            "value": "c",
            "events": { "onChange": ["c"] }
          }
        }
      ],
      "notes": "A repeated (held) arrow key keeps moving and selects; two ArrowDown presses from the first radio land on the third."
    },
