  "scenarios": [
    {
      "id": "breadcrumb.react-aria.list-and-current-link",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Breadcrumbs.test.js#L34",
      "upstreamTest": "Breadcrumbs > should render with default class",
      "apg": "aria",
      "config": { "items": 3 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "breadcrumb": { "role": "list" },
              "item:0": { "role": "listitem" },
              "item:1": { "role": "listitem" },
              "item:2": { "role": "listitem" },
              "link:0": { "aria-current": null },
              "link:2": { "aria-current": "page" }
            }
          }
        }
      ],
      "notes": "Only the last (current) item carries aria-current=page; ancestors must not."
    },
    {
      "id": "breadcrumb.react-aria.label-on-list-and-items",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Breadcrumbs.test.js#L63",
