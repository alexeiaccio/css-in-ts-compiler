    },
    {
      "id": "meter.react-aria.adobe-clamps-high",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/meter/Meter.test.js#L48",
      "upstreamTest": "Meter > clamps values to 100",
      "apg": "aria",
      "config": { "value": 1000 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "meter": { "aria-valuenow": "100", "aria-valuetext": "100%" }
            }
          }
        }
      ]
    },
    {
      "id": "meter.react-aria.adobe-negative-range",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/meter/Meter.test.js#L61",
      "upstreamTest": "Meter > can handle negative values",
      "apg": "aria",
      "config": { "value": 0, "minValue": -5, "maxValue": 5 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "meter": {
                "role": "meter",
                "aria-valuenow": "0",
                "aria-valuetext": "50%"
              }
            }
          }
        }
      ]
    },
    {
      "id": "meter.react-aria.adobe-aria-label",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/meter/Meter.test.js#L69",
      "upstreamTest": "Meter > supports aria-label",
      "apg": "aria",
      "config": { "aria-label": "Meter" },
      "steps": [
        {
          "expect": {
            "attrs": { "meter": { "aria-label": "Meter" } }
          }
        }
