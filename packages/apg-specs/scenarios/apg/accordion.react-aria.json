    {
      "id": "accordion.react-aria.tab-moves-focus-between-headers",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/accordion/Accordion.test.js#L106",
      "upstreamTest": "Accordion > allows users to navigate accordion headers through the tab key",
      "apg": "keyboard",
      "config": {
        "items": 3
      },
      "steps": [
        {
          "event": "focus",
          "target": "trigger:0"
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:0"
        },
        {
          "expect": {
            "focus": "trigger:1"
          }
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:1",
          "modifiers": ["Shift"]
        },
        {
          "expect": {
            "focus": "trigger:0"
          }
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:0"
        },
        {
          "expect": {
            "focus": "trigger:1"
          }
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:1"
        },
        {
          "expect": {
            "focus": "trigger:2"
          }
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:2"
        },
        {
          "expect": {
            "focus": null
          }
        },
        {
          "event": "key",
          "key": "Tab",
          "target": "trigger:2",
          "modifiers": ["Shift"]
        },
        {
          "expect": {
            "focus": "trigger:2"
          }
        }
      ],
      "notes": "focus:null means focus left the accordion; all triggers are independently tabbable (no roving tabindex)."
    },
