    {
      "id": "accordion.react-aria.group-nested",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Disclosure.test.js#L586",
      "upstreamTest": "DisclosureGroup > should support nested DisclosureGroups",
      "apg": "extension",
      "config": {
        "items": 2,
        "nested": true
      },
      "steps": [
        {
          "expect": {
            "visible": []
          }
        },
        {
          "event": "click",
          "target": "trigger:0"
        },
        {
          "expect": {
            "visible": ["panel:0"]
          }
        },
        {
          "event": "click",
          "target": "trigger:1"
        },
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "true"
              },
              "trigger:1": {
                "aria-expanded": "true"
              }
            },
            "visible": ["panel:0", "panel:1"]
          }
        },
        {
          "event": "click",
          "target": "trigger:1"
        },
        {
          "expect": {
            "attrs": {
              "trigger:1": {
                "aria-expanded": "false"
              }
            },
            "visible": ["panel:0"]
          }
        }
      ],
      "notes": "Nested DisclosureGroup lives inside the panel of item 1 and expands independently."
    }
  ]
}
