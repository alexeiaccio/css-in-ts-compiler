  "scenarios": [
    {
      "id": "accordion.react-aria.aria-expanded-and-region",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/accordion/Accordion.test.js#L52",
      "upstreamTest": "Accordion > renders properly",
      "apg": "aria",
      "config": {
        "items": 3,
        "itemValues": ["one", "two", "three"],
        "defaultExpanded": ["one"]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "true",
                "aria-controls": "panel:0"
              },
              "trigger:1": {
                "aria-expanded": "false"
              },
              "trigger:2": {
                "aria-expanded": "false"
              },
              "panel:0": {
                "role": "region",
                "aria-labelledby": "trigger:0"
              }
            },
            "visible": ["panel:0"]
          }
        }
      ],
      "notes": "Auto-generated ids are normalised to part tokens (trigger:0 / panel:0). All accordion callbacks take a single argument; in events a sub-array is an array-valued argument."
    },
    {
      "id": "accordion.react-aria.click-toggles",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/accordion/Accordion.test.js#L72",
      "upstreamTest": "Accordion > toggle accordion on mouse click",
      "apg": "pointer",
      "config": {
        "items": 3
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "false"
              }
            },
            "visible": []
          }
        },
        {
          "event": "click",
          "target": "trigger:0"
        },
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "true"
              }
            },
            "visible": ["panel:0"],
            "events": {
              "onExpandedChange": [["one"]]
            }
          }
        },
        {
          "event": "click",
          "target": "trigger:0"
        },
        {
          "expect": {
            "attrs": {
              "trigger:0": {
                "aria-expanded": "false"
              }
            },
            "visible": [],
            "events": {
              "onExpandedChange": [["one"], []]
            }
          }
        }
      ],
      "notes": "APG specifies Enter/Space only; pointer toggle recorded as an extension."
    },
