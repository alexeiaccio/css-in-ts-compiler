    {
      "id": "landmarks.react-aria.tabindex-only-on-focused",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L1002",
      "upstreamTest": "LandmarkManager > landmark has tabIndex=\"-1\" when focused",
      "apg": "aria",
      "config": { "landmarks": ["navigation", "main"] },
      "steps": [
        {
          "expect": {
            "attrs": {
              "navigation": { "tabindex": null },
              "main": { "tabindex": null }
            }
          }
        },
        { "event": "key", "key": "F6" },
        {
          "expect": {
            "attrs": {
              "navigation": { "tabindex": "-1" },
              "main": { "tabindex": null }
            }
          }
        },
        { "event": "key", "key": "F6" },
        {
          "expect": {
            "attrs": {
              "navigation": { "tabindex": null },
              "main": { "tabindex": "-1" }
            }
          }
        }
      ],
      "notes": "Only the currently focused landmark is made programmatically focusable."
    },
    {
      "id": "landmarks.react-aria.tabindex-cleared-on-blur",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L1133",
      "upstreamTest": "LandmarkManager > loses the tabIndex=-1 if something else is focused",
      "apg": "aria",
      "config": { "landmarks": ["navigation", "main"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "attrs": { "navigation": { "tabindex": "-1" } } } },
        { "event": "key", "key": "Tab" },
        {
          "expect": {
            "focus": "link:0",
            "attrs": { "navigation": { "tabindex": null } }
          }
        }
      ]
    },
    {
