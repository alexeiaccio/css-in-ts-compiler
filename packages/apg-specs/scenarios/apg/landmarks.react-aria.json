      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L1412",
      "upstreamTest": "LandmarkManager > skips over aria-hidden landmarks",
      "apg": "extension",
      "config": { "landmarks": ["main", "region", "region"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "main" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "region:1" } },
        { "event": "key", "key": "Shift+F6" },
        { "expect": { "focus": "main" } }
      ],
      "notes": "The first region sits inside an aria-hidden subtree and is skipped."
    },
    {
      "id": "landmarks.react-aria.reclick-landmark-keeps-focus",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L1291",
      "upstreamTest": "LandmarkManager > focus restores to previously focused landmark after blur and F6",
      "apg": "extension",
      "config": { "landmarks": ["navigation", "main"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } },
        { "event": "blur", "target": "navigation" },
        { "expect": { "focus": null } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } }
      ]
    },
    {
      "id": "landmarks.react-aria.duplicate-roles-must-be-labelled",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L593",
      "upstreamTest": "LandmarkManager > Should allow 2+ landmarks with same role if they are labelled",
      "apg": "aria",
      "config": {
        "landmarks": ["navigation", "navigation"],
        "labels": ["First nav", "Second nav"]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "navigation:0": { "aria-label": "First nav" },
              "navigation:1": { "aria-label": "Second nav" }
            }
          }
        }
      ],
      "notes": "Warn-free when repeated landmark roles have unique labels."
    },
    {
      "id": "landmarks.react-aria.unlabelled-duplicate-warns",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L634",
      "upstreamTest": "LandmarkManager > Should warn if 2+ landmarks with same role are used but not labelled",
      "apg": "aria",
      "config": { "landmarks": ["navigation", "navigation"] },
      "steps": [
        {
          "expect": {
            "attrs": {
              "navigation:0": { "aria-label": null },
              "navigation:1": { "aria-label": null }
            }
          }
        }
      ],
      "notes": "React-aria emits a console warning here; the accessible-name gap is the modelled contract."
    },
    {
      "id": "landmarks.react-aria.added-landmark-is-reachable",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L777",
      "upstreamTest": "LandmarkManager > Should navigate to a landmark that has been added to the DOM",
      "apg": "extension",
      "config": { "landmarks": ["navigation", "main"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "main" } },
        {
          "event": "prop",
          "target": "region:0",
          "prop": "mounted",
          "value": true
        },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "region:0" } }
      ],
      "notes": "A region mounted later joins the F6 cycle in DOM order."
    },
    {
      "id": "landmarks.react-aria.removed-landmark-is-skipped",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L725",
      "upstreamTest": "LandmarkManager > Should not navigate to a landmark that has been removed from the DOM",
      "apg": "extension",
      "config": { "landmarks": ["navigation", "region", "main"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "region:0" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "main" } },
        {
          "event": "prop",
          "target": "region:0",
          "prop": "mounted",
          "value": false
        },
        { "event": "key", "key": "Shift+F6" },
        { "expect": { "focus": "navigation" } }
      ]
    }
