      "id": "landmarks.react-aria.f6-cycles-landmarks",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/landmark/useLandmark.test.tsx#L149",
      "upstreamTest": "LandmarkManager > can F6 to a landmark region",
      "apg": "extension",
      "config": { "landmarks": ["navigation", "main"] },
      "steps": [
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "main" } },
        { "event": "key", "key": "F6" },
        { "expect": { "focus": "navigation" } }
      ],
      "notes": "F6 landmark cycling is a react-aria extension, not part of the APG landmarks pattern."
