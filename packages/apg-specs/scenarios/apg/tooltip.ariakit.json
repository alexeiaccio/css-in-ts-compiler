      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/tooltip-interactions/test.ts#L53",
      "upstreamTest": "waits again after keyboard focus is lost",
      "apg": "extension",
      "config": { "delay": 20, "closeDelay": 20 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        { "expect": { "visible": ["tooltip:0"] } },
