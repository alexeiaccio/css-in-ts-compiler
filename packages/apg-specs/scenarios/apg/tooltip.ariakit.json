        { "expect": { "visible": ["tooltip:0"] } },
        { "event": "focus", "target": "trigger:0" },
        { "event": "unhover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        { "expect": { "visible": ["tooltip:0"], "focus": "trigger:0" } }
      ],
      "notes": "Keyboard focus keeps the tooltip engaged after the pointer leaves (WCAG 1.4.13 persistent)."
    },
    {
