  "scenarios": [
    {
      "id": "tooltip.ariakit.hover-shows-hide-outside-reopens",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/tooltip-interactions/test.ts#L10",
      "upstreamTest": "shows on hover, hides outside, and immediately reopens",
      "apg": "pointer",
      "config": { "delay": 20, "closeDelay": 20 },
      "steps": [
        {
          "expect": {
            "visible": [],
            "attrs": { "trigger:0": { "aria-describedby": null } }
          }
        },
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        {
          "expect": {
            "visible": ["tooltip:0"],
            "attrs": { "trigger:0": { "aria-describedby": "*" } }
          }
        },
        { "event": "unhover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        {
          "expect": {
            "visible": [],
            "attrs": { "trigger:0": { "aria-describedby": null } }
          }
        },
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        { "expect": { "visible": ["tooltip:0"] } }
      ],
      "notes": "aria-describedby value \"*\" means any non-empty IDREF matching the tooltip; the spec removes it while hidden."
    },
    {
      "id": "tooltip.ariakit.hover-then-focus-stays-open",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/tooltip-interactions/test.ts#L23",
      "upstreamTest": "stays open when hover is followed by keyboard focus",
      "apg": "extension",
      "config": { "delay": 20, "closeDelay": 20 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
