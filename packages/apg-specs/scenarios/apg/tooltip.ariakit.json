    {
      "id": "tooltip.ariakit.escape-from-content-restores-anchor",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/tooltip-interactions/test.ts#L72",
      "upstreamTest": "Escape from tooltip content restores its anchor",
