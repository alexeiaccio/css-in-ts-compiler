      "config": { "delay": 20, "closeDelay": 20 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        { "expect": { "visible": ["tooltip:0"] } },
        { "event": "click", "target": "tooltip:0" },
        { "event": "key", "key": "Escape", "target": "tooltip:0" },
        { "expect": { "visible": [], "focus": "trigger:0" } }
      ],
      "notes": "Ariakit's tooltip content can take focus; APG says tooltips never take focus. Divergence from APG, ported as the upstream test states."
    },
    {
      "id": "tooltip.ariakit.escape-keeps-closed-on-pointer-focus",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/tooltip-interactions/test.ts#L84",
      "upstreamTest": "Escape keeps the tooltip closed when the anchor has pointer focus",
      "apg": "keyboard",
      "config": { "delay": 20, "closeDelay": 20 },
      "steps": [
        { "event": "hover", "target": "trigger:0" },
        { "event": "wait", "ms": 600 },
        {
          "expect": {
            "visible": ["tooltip:0"],
            "attrs": { "trigger:0": { "data-focus-visible": null } }
          }
        },
        { "event": "click", "target": "trigger:0" },
        { "expect": { "focus": "trigger:0", "visible": ["tooltip:0"] } },
        { "event": "key", "key": "Escape", "target": "trigger:0" },
        {
          "expect": {
            "visible": [],
            "attrs": { "trigger:0": { "data-focus-visible": "true" } }
          }
        }
      ],
      "notes": "Escape makes the anchor focus-visible, which must not reopen the dismissed tooltip (ariakit issue 7622). The data-focus-visible attribute is Ariakit-specific, not APG."
    },
