    {
      "id": "menu-button.react-aria.submenu-trigger-aria-and-open-on-hover",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L931",
      "upstreamTest": "should support a submenu trigger",
      "apg": "keyboard",
      "config": {
        "items": ["Open", "Rename…", "Duplicate", "Share…", "Delete…"],
        "submenu": { "at": 3, "items": ["Email", "SMS", "X"] }
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "menuitem:3": {
                "aria-haspopup": "menu",
                "aria-expanded": "false",
                "data-has-submenu": "true"
              }
            }
          }
        },
        { "event": "hover", "target": "menuitem:3" },
        {
          "expect": {
            "attrs": {
              "menuitem:3": { "aria-expanded": "true", "data-open": "true" }
            },
            "visible": ["submenu:1"]
          }
        },
        { "event": "click", "target": "menuitem:3/0" },
        {
          "expect": {
            "hidden": ["menu", "submenu:1"],
            "events": { "onAction": ["menuitem:3/0"] }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.nested-submenu-triggers",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L998",
      "upstreamTest": "should support nested submenu triggers",
      "apg": "keyboard",
      "config": {
        "items": ["Open", "Rename…", "Duplicate", "Share…", "Delete…"],
        "submenu": {
          "at": 3,
          "items": ["Email…", "SMS", "X"],
          "nestedSubmenu": { "at": 0, "items": ["Work", "Personal"] }
        }
      },
      "steps": [
        { "event": "hover", "target": "menuitem:3" },
        { "expect": { "visible": ["submenu:1"] } },
        { "event": "hover", "target": "menuitem:3/0" },
        { "expect": { "visible": ["submenu:1/1"] } },
        { "event": "click", "target": "menuitem:3/0/0" },
        {
          "expect": {
            "hidden": ["submenu:1/1", "submenu:1"],
            "events": { "onAction": ["menuitem:3/0/0"] }
          }
        }
      ]
    },
