{
  "pattern": "menu-button",
  "source": "react-aria",
  "commit": "99e610236887da619ad9d54a1cd87983166c043d",
  "license": "Apache-2.0",
  "scenarios": [
    {
      "id": "menu-button.react-aria.menu-trigger-opens-and-activates",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L624",
      "upstreamTest": "should support menu trigger",
      "apg": "keyboard",
      "config": {
        "items": ["Open", "Rename…", "Duplicate", "Share…", "Delete…"]
      },
      "steps": [
        { "expect": { "attrs": { "trigger": { "data-pressed": null } } } },
        { "event": "click", "target": "trigger" },
        {
          "expect": {
            "visible": ["menu"],
            "attrs": { "trigger": { "data-pressed": "true" } }
          }
        },
        { "event": "click", "target": "menuitem:1" },
        {
          "expect": {
            "hidden": ["menu"],
            "events": { "onAction": ["menuitem:1"] }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.trigger-aria-haspopup-and-expanded",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/menu/useMenuTrigger.test.js#L46",
      "upstreamTest": "should return default props for menu and menu trigger / proper aria props if menu is open",
      "apg": "aria",
      "config": { "items": ["One", "Two"] },
      "steps": [
        {
          "expect": {
            "attrs": {
              "trigger": { "aria-haspopup": "true", "aria-expanded": null }
            }
          }
        },
        { "event": "click", "target": "trigger" },
        {
          "expect": {
            "attrs": {
              "trigger": { "aria-haspopup": "true", "aria-expanded": "true" }
            }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.trigger-disabled-does-not-toggle",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/menu/useMenuTrigger.test.js#L89",
      "upstreamTest": "doesn't toggle the menu if isDisabled",
      "apg": "extension",
      "config": { "items": ["One", "Two"], "triggerDisabled": true },
      "steps": [
        { "event": "click", "target": "trigger" },
        { "expect": { "hidden": ["menu"] } }
      ]
    },
    {
      "id": "menu-button.react-aria.arrow-down-opens-and-focuses-first",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/menu/MenuTrigger.test.js#L604",
      "upstreamTest": "should focus the first item on Alt+ArrowDown if no selectedKeys specified",
      "apg": "keyboard",
      "config": { "items": ["One", "Two", "Three"] },
      "steps": [
        { "event": "focus", "target": "trigger" },
        { "event": "key", "key": "Alt+ArrowDown", "target": "trigger" },
        { "expect": { "visible": ["menu"], "focus": "menuitem:0" } }
      ]
    },
    {
      "id": "menu-button.react-aria.arrow-up-opens-and-focuses-last",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/menu/MenuTrigger.test.js#L597",
      "upstreamTest": "should focus the last item on Alt+ArrowUp if no selectedKeys specified",
      "apg": "keyboard",
      "config": { "items": ["One", "Two", "Three"] },
      "steps": [
        { "event": "focus", "target": "trigger" },
        { "event": "key", "key": "Alt+ArrowUp", "target": "trigger" },
        { "expect": { "visible": ["menu"], "focus": "menuitem:2" } }
      ]
    },
    {
      "id": "menu-button.react-aria.opens-on-long-press-not-short-press",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/menu/MenuTrigger.test.js#L471",
      "upstreamTest": "should open the menu on longPress / short press does not open",
      "apg": "extension",
      "config": { "items": ["One", "Two"], "longPress": true },
      "steps": [
        { "event": "pointerdown", "pointerType": "touch", "target": "trigger" },
        { "event": "wait", "ms": 500 },
        { "event": "pointerup", "pointerType": "touch", "target": "trigger" },
        { "expect": { "visible": ["menu"] } }
      ],
      "notes": "Short-press and plain click paths are asserted by the click scenarios; longPress is an extension."
    },
    {
      "id": "menu-button.react-aria.long-press-alt-arrow-opens-and-focuses-selected",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/@adobe/react-spectrum/test/menu/MenuTrigger.test.js#L563",
      "upstreamTest": "should focus the selected item on menu open",
      "apg": "extension",
      "config": {
        "variant": "radio-items",
        "items": ["Foo", "Bar"],
        "selected": 1
      },
      "steps": [
        { "event": "focus", "target": "trigger" },
        { "event": "key", "key": "Alt+ArrowDown", "target": "trigger" },
        {
          "expect": {
            "focus": "menuitem:1",
            "attrs": { "menuitem:1": { "aria-checked": "true" } }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.disabled-items-skipped-in-keyboard-navigation",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L570",
      "upstreamTest": "should support isDisabled prop on items",
      "apg": "keyboard",
      "config": { "items": ["Cat", "Dog", "Kangaroo"], "disabled": [1] },
      "steps": [
        { "event": "focus", "target": "menuitem:0" },
        { "event": "key", "key": "ArrowDown", "target": "menuitem:0" },
        {
          "expect": {
            "focus": "menuitem:2",
            "attrs": { "menuitem:1": { "aria-disabled": "true" } }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.selection-toggle-multiple-on-click",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L450",
      "upstreamTest": "should support selection state",
      "apg": "keyboard",
      "config": {
        "variant": "checkbox-items",
        "selectionMode": "multiple",
        "items": ["Cat", "Dog", "Kangaroo"]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "menuitem:0": {
                "role": "menuitemcheckbox",
                "aria-checked": "false"
              }
            }
          }
        },
        { "event": "click", "target": "menuitem:0" },
        { "expect": { "attrs": { "menuitem:0": { "aria-checked": "true" } } } },
        { "event": "click", "target": "menuitem:0" },
        { "expect": { "attrs": { "menuitem:0": { "aria-checked": "false" } } } }
      ]
    },
    {
      "id": "menu-button.react-aria.section-level-selection-modes",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L469",
      "upstreamTest": "should support section-level selection",
      "apg": "keyboard",
      "config": {
        "groups": [
          {
            "selectionMode": "multiple",
            "items": ["Lettuce", "Tomato", "Onion"],
            "selected": [0]
          },
          {
            "selectionMode": "single",
            "items": ["Ham", "Tuna", "Tofu"],
            "selected": [0]
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "menuitem:0": {
                "role": "menuitemcheckbox",
                "aria-checked": "true"
              },
              "menuitem:1": {
                "role": "menuitemcheckbox",
                "aria-checked": "false"
              }
            }
          }
        },
        { "event": "click", "target": "menuitem:1" },
        {
          "expect": {
            "attrs": {
              "menuitem:0": { "aria-checked": "true" },
              "menuitem:1": { "aria-checked": "true" }
            }
          }
        },
        {
          "expect": {
            "attrs": {
              "menuitem:3": { "role": "menuitemradio", "aria-checked": "true" }
            }
          }
        },
        { "event": "click", "target": "menuitem:4" },
        {
          "expect": {
            "attrs": {
              "menuitem:3": { "aria-checked": "false" },
              "menuitem:4": { "aria-checked": "true" }
            }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "menuitem:4" },
        { "event": "key", "key": "ArrowUp", "target": "menuitem:3" },
        { "event": "key", "key": "ArrowUp", "target": "menuitem:2" },
        { "event": "key", "key": "ArrowUp", "target": "menuitem:1" },
        { "expect": { "focus": "menuitem:0" } }
      ]
    },
    {
      "id": "menu-button.react-aria.escape-key-behavior-none-keeps-selection",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L546",
      "upstreamTest": "should prevent Esc from clearing selection if escapeKeyBehavior is none",
