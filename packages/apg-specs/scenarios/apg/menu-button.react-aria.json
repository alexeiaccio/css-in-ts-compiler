    {
      "id": "menu-button.react-aria.context-menu-right-click-opens",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Menu.test.tsx#L658",
      "upstreamTest": "should support a context menu trigger",
      "apg": "extension",
      "config": {
        "variant": "context-menu",
        "items": ["Open", "Rename…", "Duplicate", "Share…", "Delete…"]
      },
      "steps": [
        {
          "expect": {
            "hidden": ["menu"],
            "attrs": {
              "trigger": { "aria-haspopup": null, "aria-expanded": null }
            }
          }
        },
        { "event": "click", "target": "trigger" },
        { "expect": { "hidden": ["menu"] } },
        { "event": "contextmenu", "target": "trigger" },
        { "expect": { "visible": ["menu"] } },
        { "event": "click", "target": "menuitem:1" },
        {
          "expect": {
            "hidden": ["menu"],
            "events": { "onAction": ["menuitem:1"] }
          }
        }
      ]
    },
    {
      "id": "menu-button.react-aria.context-menu-right-click-outside-closes",
