  "scenarios": [
    {
      "id": "menubar.ariakit.click-opens-menu-and-focuses-menu",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/menubar-interactions/test.ts#L4",
      "upstreamTest": "show/hide on click",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "expect": { "hidden": ["menu:0"] } },
        { "event": "click", "target": "menuitem:0" },
        {
          "expect": {
            "visible": ["menu:0"],
            "focus": "menu:0",
            "attrs": { "menuitem:0": { "aria-expanded": "true" } }
          }
        },
        { "event": "click", "target": "menuitem:0/0" },
        { "expect": { "hidden": ["menu:0"], "focus": "menuitem:0" } }
      ],
      "notes": "The popup itself receives focus on pointer open (ariakit keeps focus on the menu container, not the first item)."
    },
