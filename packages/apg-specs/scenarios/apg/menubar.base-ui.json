{
  "pattern": "menubar",
  "source": "base-ui",
  "commit": "19511bb171f3b360b006c94cf6d07e53cb446505",
  "license": "MIT",
  "scenarios": [
    {
      "id": "menubar.base-ui.click-trigger-toggles-menu",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L165",
      "upstreamTest": "within click interactions: should open the menu after clicking on its trigger and close it when clicking again",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "click", "target": "menuitem:0" },
        {
          "expect": {
            "visible": ["menu:0"],
            "attrs": {
              "menuitem:0": { "aria-expanded": "true", "data-popup-open": "" }
            }
          }
        },
        { "event": "click", "target": "menuitem:0" },
        { "expect": { "hidden": ["menu:0"] } }
      ]
    },
    {
      "id": "menubar.base-ui.hover-does-not-open-without-open-submenu",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L190",
      "upstreamTest": "should not open submenus on hover when no submenu is already open",
      "apg": "mouse",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "hover", "target": "menuitem:0" },
        { "expect": { "hidden": ["menu:0"] } }
      ]
    },
    {
      "id": "menubar.base-ui.hover-switches-open-menu-when-submenu-open",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L204",
      "upstreamTest": "should open submenus on hover when another submenu is already open",
      "apg": "mouse",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "click", "target": "menuitem:0" },
        {
          "expect": {
            "visible": ["menu:0"],
            "attrs": { "menubar": { "data-has-submenu-open": "" } }
          }
        },
        { "event": "hover", "target": "menuitem:1" },
        { "expect": { "visible": ["menu:1"], "hidden": ["menu:0"] } },
        { "event": "hover", "target": "menuitem:2" },
        { "expect": { "visible": ["menu:2"], "hidden": ["menu:1"] } }
      ]
    },
    {
      "id": "menubar.base-ui.hover-opens-nested-submenu",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L244",
      "upstreamTest": "should open nested submenus on hover when parent menu is open",
      "apg": "mouse",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "click", "target": "menuitem:0" },
        { "event": "hover", "target": "menuitem:0/2" },
        {
          "expect": {
            "visible": ["submenu:1"],
            "attrs": {
              "menuitem:0/2": { "aria-expanded": "true", "data-popup-open": "" }
            }
          }
        }
      ]
    },
    {
      "id": "menubar.base-ui.hover-nested-submenu-then-another-menu-closes-tree",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L273",
      "upstreamTest": "should open another menu on hover when a nested submenu is open",
      "apg": "mouse",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "click", "target": "menuitem:0" },
        { "event": "hover", "target": "menuitem:0/2" },
        { "event": "hover", "target": "menuitem:0/2/0" },
        { "expect": { "visible": ["menu:0", "submenu:1"] } },
        { "event": "hover", "target": "menuitem:1" },
        {
          "expect": { "visible": ["menu:1"], "hidden": ["menu:0", "submenu:1"] }
        }
      ]
    },
    {
      "id": "menubar.base-ui.focus-does-not-open-menu-enter-opens",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L316",
      "upstreamTest": "focuses a menubar item without immediately opening the menu",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
