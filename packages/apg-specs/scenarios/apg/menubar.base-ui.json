        { "event": "key", "key": "ArrowDown", "target": "menuitem:0/0" },
        { "event": "key", "key": "ArrowDown", "target": "menuitem:0/1" },
        { "event": "key", "key": "ArrowRight", "target": "menuitem:0/1" },
        { "expect": { "visible": ["submenu:1"] } },
        { "event": "key", "key": "ArrowRight", "target": "menuitem:0/1/0" },
        {
          "expect": {
            "hidden": ["submenu:1", "menu:0"],
            "visible": ["menu:1"],
            "events": {
