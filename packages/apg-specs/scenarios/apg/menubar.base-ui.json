        { "expect": { "focus": "menuitem:2" } },
        { "event": "key", "key": "Home", "target": "menuitem:2" },
        { "expect": { "focus": "menuitem:0" } }
      ]
    },
    {
      "id": "menubar.base-ui.space-opens-menu",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L445",
