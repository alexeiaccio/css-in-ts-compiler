    {
      "id": "menubar.base-ui.touch-outside-closes-whole-tree",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L785",
      "upstreamTest": "closes the entire tree on a single outside press after opening a submenu",
      "apg": "extension",
      "config": { "orientation": "horizontal", "items": ["File", "Edit"] },
      "steps": [
        {
          "event": "pointerdown",
          "pointerType": "touch",
          "target": "menuitem:0"
        },
        { "event": "click", "target": "menuitem:0" },
        { "expect": { "visible": ["menu:0"] } },
        {
          "event": "pointerdown",
          "pointerType": "touch",
          "target": "menuitem:0/2"
        },
        { "event": "click", "target": "menuitem:0/2" },
        { "expect": { "visible": ["submenu:1"] } },
        { "event": "pointerdown", "pointerType": "touch", "target": "outside" },
        { "event": "click", "target": "outside" },
        { "expect": { "hidden": ["submenu:1", "menu:0"] } }
