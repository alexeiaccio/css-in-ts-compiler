      "steps": [
        { "event": "focus", "target": "menuitem:0" },
        { "expect": { "hidden": ["menu:0"] } },
        { "event": "key", "key": "Enter", "target": "menuitem:0" },
        { "expect": { "visible": ["menu:0"] } }
      ]
    },
    {
      "id": "menubar.base-ui.arrow-right-moves-between-triggers",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L399",
