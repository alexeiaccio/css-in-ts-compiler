        { "expect": { "focus": "menuitem:1", "hidden": ["menu:1"] } }
      ]
    },
    {
      "id": "menubar.base-ui.home-end-move-between-triggers",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/menubar/Menubar.test.tsx#L424",
      "upstreamTest": "moves focus to the first and last triggers with Home and End",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "items": ["File", "Edit", "View"]
      },
      "steps": [
        { "event": "focus", "target": "menuitem:0" },
