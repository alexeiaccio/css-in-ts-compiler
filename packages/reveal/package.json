{
  "name": "@cssints/reveal",
  "version": "0.25.0",
  "description": "Scroll-driven and scroll-triggered entrance animations for cssints: motion's presets on animation-timeline: view() (reveal) or on CSS animation triggers (appear), with a tiny IntersectionObserver fallback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/reveal"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/runtime.ts",
    "./dist/runtime.mjs"
  ],
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "development": {
        "types": "./src/runtime.ts",
        "default": "./src/runtime.ts"
      },
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./runtime": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/reveal.mjs",
    "test:browsers": "node test/browsers.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "@cssints/motion": "workspace:*"
  },
  "devDependencies": {
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
