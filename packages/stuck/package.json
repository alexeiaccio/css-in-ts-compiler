{
  "name": "@cssints/stuck",
  "version": "0.14.0",
  "description": "Style a sticky element while it is stuck: @container scroll-state(stuck) natively, an IntersectionObserver fallback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/stuck"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/observer.ts",
    "./dist/observer.mjs",
    "./test/fixtures/*"
  ],
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./observer": {
      "development": {
        "types": "./src/observer.ts",
        "default": "./src/observer.ts"
      },
      "types": "./dist/observer.d.mts",
      "default": "./dist/observer.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./observer": {
        "types": "./dist/observer.d.mts",
        "default": "./dist/observer.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/stuck.mjs",
    "test:browsers": "node test/browsers.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.14.0"
  },
  "engines": {
    "node": ">=22"
  }
}
