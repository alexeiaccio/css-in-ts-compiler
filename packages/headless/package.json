{
  "name": "@cssints/headless",
  "version": "0.11.0",
  "description": "Headless APG widgets on Solid 2: state plus attribute objects, no elements, no styling, each conformance-checked against its Quint spec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/headless"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "@cssints/apg-specs": "workspace:*",
    "@quint-machine/core": "0.1.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "@vitest/browser-playwright": "5.0.5",
    "effect": "4.0.6",
    "playwright": "1.64.1",
    "solid-js": "2.0.0-rc.13",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.13"
  },
  "engines": {
    "node": ">=22"
  }
}
