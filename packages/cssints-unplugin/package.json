{
	"name": "@cssints/unplugin",
	"version": "1.0.0",
	"description": "Vite plugin for CSS-in-TS macro transformation with LightningCSS",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@parcel/macros": "^2.12.0",
		"effect": "^4.0.0-beta.30",
		"lightningcss": "^1.32.0",
		"unplugin": "^2.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/rollup": "^0.54.0",
		"rollup": "^4.59.0",
		"typescript": "^5.0.0",
		"vite": "^7.3.1",
		"vitest": "^3.0.0"
	},
	"peerDependencies": {
		"vite": "^5.0.0 || ^6.0.0"
	}
}
