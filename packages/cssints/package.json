{
  "name": "cssints",
  "version": "1.0.0",
  "description": "Type-safe CSS-in-TS compiler with Parcel macros and LightningCSS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "import": "./dist/ast/index.js"
    },
    "./variants": {
      "types": "./dist/variants.d.ts",
      "import": "./dist/variants.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cssints/unplugin": "workspace:*",
    "effect": "^4.0.0-beta.30",
    "lightningcss": "^1.32.0"
  },
  "peerDependencies": {
    "unplugin-parcel-macros": "^0.2.0"
  },
  "devDependencies": {
    "@parcel/macros": "^2.12.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
