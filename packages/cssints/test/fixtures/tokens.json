{
  "brand": {
    "$type": "color",
    "bg": { "$value": "#ffffff" },
    "accent": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.19, 264] } },
    "hover": { "$value": "color-mix(in oklab, {brand.accent}, black 15%)" }
  },
  "gap": { "$type": "dimension", "md": { "$value": { "value": 16, "unit": "px" } } }
}
