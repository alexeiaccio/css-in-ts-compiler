{
	"name": "@cssints/lightningcss-napi",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build:native": "./node_modules/.bin/napi build --platform --release",
		"build:native:debug": "./node_modules/.bin/napi build --platform",
		"build:types": "node scripts/generate-all.mjs",
		"build:schemas": "node scripts/generate-schemas.mjs",
		"build:all": "node scripts/generate-all.mjs && node scripts/generate-schemas.mjs",
		"build:ts": "tsc",
		"build": "bun run build:native && bun run build:all && bun run build:ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"effect": "^4.0.0-beta.36"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.5.1",
		"typescript": "^5.7.0",
		"vitest": "^4.1.0"
	},
	"napi": {
		"binaryName": "lightningcss-napi",
		"targets": [
			"aarch64-apple-darwin",
			"x86_64-apple-darwin",
			"aarch64-unknown-linux-gnu",
			"x86_64-unknown-linux-gnu"
		]
	}
}
