{
  "name": "@cssints/color-names",
  "version": "0.3.1",
  "description": "The Color Name List for cssints: named(\"tangerine\") as a hex colour, in hue sectors so completion stays short",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/color-names"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./nearest": {
      "development": {
        "types": "./src/nearest.ts",
        "default": "./src/nearest.ts"
      },
      "types": "./dist/nearest.d.mts",
      "default": "./dist/nearest.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./nearest": {
        "types": "./dist/nearest.d.mts",
        "default": "./dist/nearest.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "generate": "node scripts/generate.ts",
    "test": "node test/color-names.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "color-name-list": "14.61.0",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
