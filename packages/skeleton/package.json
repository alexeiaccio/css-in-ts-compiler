{
  "name": "@cssints/skeleton",
  "version": "0.13.1",
  "description": "Skeleton loaders for cssints whose shimmer is in phase across the page: one animation on :root, read by every skeleton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/skeleton"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/skeleton.mjs",
    "test:browsers": "node test/browsers.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
