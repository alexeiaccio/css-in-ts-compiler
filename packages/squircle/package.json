{
  "name": "@cssints/squircle",
  "version": "0.1.0",
  "private": true,
  "description": "Squircle corners for cssints: native corner-shape: squircle, a CSS mask where a target lacks it",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/squircle.mjs",
    "test:browsers": "node test/browsers.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit && effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "pack:tgz": "node ../../scripts/pack.mjs"
  },
  "devDependencies": {
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
