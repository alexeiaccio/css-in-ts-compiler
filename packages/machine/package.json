{
  "name": "@cssints/machine",
  "version": "0.25.0",
  "description": "A minimal, dependency-free, type-safe state machine for UI protocols: effects as data, a stale effect cannot complete, debounce with a flush, an injectable clock and a harness that proves it without a browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/machine"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./solid": {
      "development": {
        "types": "./src/solid.ts",
        "default": "./src/solid.ts"
      },
      "types": "./dist/solid.d.mts",
      "default": "./dist/solid.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./solid": {
        "types": "./dist/solid.d.mts",
        "default": "./dist/solid.mjs"
      }
    },
    "access": "public",
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/machine.mjs && node --conditions=browser --conditions=development test/store.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "solid-js": "2.0.0-rc.13",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.13"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
