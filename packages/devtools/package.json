{
  "name": "@cssints/devtools",
  "version": "0.12.0",
  "description": "A dev overlay inspector for cssints: an element's classes by the call that made them, the cascade of the sheet, checked against the browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src/core"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/opencode.js",
    "./overlay": "./dist/overlay.js",
    "./opencode": "./dist/opencode.js",
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./model": {
      "types": "./src/core/model.ts",
      "default": "./src/core/model.ts"
    },
    "./inject": "./src/core/inject.ts"
  },
  "scripts": {
    "build": "vp build",
    "test": "node test/core.mjs && node test/opencode.mjs && node test/opencode-plugin.mjs && node test/build.mjs",
    "test:browsers": "vp build && node test/browsers.mjs && node test/ask-browser.mjs && node test/names-browser.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "dependencies": {
    "@cssints/css-grammar": "workspace:*",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "cssints": "workspace:*",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.32.0",
    "solid-js": "2.0.0-rc.13",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.12.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "directory": ".publish"
  }
}
