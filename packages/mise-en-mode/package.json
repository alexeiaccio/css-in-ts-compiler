{
  "name": "@cssints/mise-en-mode",
  "version": "0.8.0",
  "description": "Mise en Mode for cssints: looks are themes in the layers app < author < viewer, set on data-mode scopes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeiaccio/css-in-ts-compiler.git",
    "directory": "packages/mise-en-mode"
  },
  "homepage": "https://cssints.dev",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "directory": ".publish"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node test/mise-en-mode.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "pack:tgz": "node ../../scripts/pack.mjs",
    "prepublishOnly": "echo 'publish through the root release script: see RELEASING.md' && exit 1"
  },
  "devDependencies": {
    "cssints": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cssints": "^0.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
