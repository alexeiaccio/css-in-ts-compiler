      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:1",
            "checked": "radio:1",
            "value": "orange"
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "radio:1" },
        {
          "expect": {
            "focus": "radio:2",
            "checked": "radio:2",
            "value": "watermelon",
            "attrs": { "radio:1": { "aria-checked": "false" } }
          }
        }
      ]
    },
    {
      "id": "radio.ariakit.arrow-left-wraps-to-last",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/radio-selection-events/test.ts#L46",
      "upstreamTest": "moves backward and wraps with ArrowLeft",
      "apg": "keyboard",
      "config": {
        "items": 3,
