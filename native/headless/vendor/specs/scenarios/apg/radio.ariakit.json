  "scenarios": [
    {
      "id": "radio.ariakit.tab-focuses-first-radio",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/form-radio/test.ts#L6",
      "upstreamTest": "focus on the first radio button by tabbing",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["red", "green", "blue"],
        "checked": null,
        "flavor": "roving"
      },
      "steps": [
        { "expect": { "focus": null } },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0", "checked": null } }
      ],
      "notes": "Entering the group never checks a radio; Tab lands on the first radio when none is checked."
    },
    {
      "id": "radio.ariakit.space-checks-focused-radio",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/radio-selection-events/test.ts#L22",
      "upstreamTest": "focuses and selects the first radio with Tab and Space",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["apple", "orange", "watermelon"],
        "checked": null
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0", "checked": null } },
        { "event": "key", "key": "Space", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:0",
            "checked": "radio:0",
            "attrs": {
              "radio:0": { "checked": "true", "aria-checked": "true" }
            }
          }
        }
      ]
    },
    {
      "id": "radio.ariakit.arrow-right-moves-and-checks",
      "upstream": "https://github.com/ariakit/ariakit/blob/404c72257b879569feb08465da4ff9915fd873da/app/src/sandbox/radio-selection-events/test.ts#L33",
      "upstreamTest": "moves forward with ArrowRight",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["apple", "orange", "watermelon"],
        "checked": null
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowRight", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:1",
            "checked": "radio:1",
            "value": "orange"
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "radio:1" },
        {
          "expect": {
            "focus": "radio:2",
            "checked": "radio:2",
            "value": "watermelon",
            "attrs": { "radio:1": { "aria-checked": "false" } }
          }
        }
      ],
      "notes": "ArrowRight moves focus and checks the next radio."
    },
    {
      "id": "radio.ariakit.arrow-down-moves-and-checks",
