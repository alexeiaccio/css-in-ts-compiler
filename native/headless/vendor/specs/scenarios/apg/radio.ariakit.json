        "checked": null
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "event": "key", "key": "ArrowLeft", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:2",
            "checked": "radio:2",
            "value": "watermelon"
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "radio:2" },
        {
