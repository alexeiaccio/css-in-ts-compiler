    {
      "id": "toolbar.react-aria.role-toolbar",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria/test/actiongroup/useActionGroup.test.ts#L26",
      "upstreamTest": "useActionGroup > handles defaults",
      "apg": "aria",
      "config": { "selectionMode": "none", "items": 3 },
      "steps": [
        {
          "expect": {
            "attrs": {
              "toolbar": { "role": "toolbar", "aria-orientation": "horizontal" }
