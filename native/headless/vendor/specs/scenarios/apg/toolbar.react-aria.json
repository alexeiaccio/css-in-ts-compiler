    {
      "id": "toolbar.react-aria.arrow-horizontal",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Toolbar.test.tsx#L195",
      "upstreamTest": "Toolbar > supports keyboard navigation",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "items": [
          "button",
          "button",
          "button",
          "separator",
          "button",
          "button"
        ],
        "groups": [
          [0, 1, 2],
          [4, 5]
        ]
      },
      "steps": [
        { "event": "key", "key": "Tab", "target": "toolbar" },
        { "expect": { "focus": "item:0" } },
        { "event": "key", "key": "ArrowRight", "target": "item:0" },
        { "expect": { "focus": "item:1" } },
        { "event": "key", "key": "ArrowDown", "target": "item:1" },
        { "expect": { "focus": "item:1" } },
        { "event": "key", "key": "ArrowRight", "target": "item:1" },
        { "expect": { "focus": "item:2" } },
        { "event": "key", "key": "ArrowRight", "target": "item:2" },
        { "expect": { "focus": "item:4" } },
        { "event": "key", "key": "ArrowLeft", "target": "item:4" },
        { "expect": { "focus": "item:2" } },
        { "event": "key", "key": "Tab", "target": "item:2" },
        { "expect": { "focus": null } },
        { "event": "key", "key": "Tab", "modifiers": ["Shift"] },
        { "expect": { "focus": "item:2" } },
        { "event": "blur", "target": "item:0" },
        { "event": "key", "key": "Tab", "target": "toolbar" },
        { "expect": { "focus": "item:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "item:0" },
        { "expect": { "focus": "item:0" } },
        { "event": "click", "target": "item:5" },
        { "expect": { "focus": "item:5" } },
        { "event": "key", "key": "ArrowRight", "target": "item:5" },
        { "expect": { "focus": "item:5" } },
        { "event": "key", "key": "Enter", "target": "item:5" },
        { "expect": { "focus": "item:5" } }
      ],
      "notes": "Orthogonal arrow does nothing; arrows cross group separators; Shift+Tab re-entry remembers the last focused item; arrows do not wrap."
    },
