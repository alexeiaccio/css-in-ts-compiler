        { "event": "click", "target": "checkbox:parent" },
        {
          "expect": {
            "attrs": {
              "checkbox:0": { "aria-checked": "true" },
              "checkbox:1": { "aria-checked": "false" }
            }
          }
        }
      ],
      "notes": "A disabled checked child is not unchecked by the parent's clear pass."
    }
