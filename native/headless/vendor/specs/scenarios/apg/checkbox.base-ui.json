      "id": "checkbox.base-ui.aria-attributes",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/checkbox/root/CheckboxRoot.test.tsx#L24",
      "upstreamTest": "ARIA attributes > sets the correct aria attributes",
      "apg": "aria",
      "config": { "part": "checkbox", "required": false },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": {
              "checkbox": { "role": "checkbox", "aria-checked": "false" }
            }
          }
        },
        { "event": "prop", "set": { "required": true } },
        { "expect": { "attrs": { "checkbox": { "aria-required": "true" } } } }
      ],
      "notes": "Required adds aria-required to the exposed checkbox."
    },
