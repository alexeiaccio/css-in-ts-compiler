        {
          "expect": {
            "attrs": {
              "checkbox": { "aria-checked": "true" },
              "input:hidden": { "checked": "true" }
            }
          }
        },
        { "event": "click", "target": "checkbox" },
        {
          "expect": {
            "attrs": {
              "checkbox": { "aria-checked": "false" },
              "input:hidden": { "checked": "false" }
            }
          }
        }
      ],
      "notes": "Exposed aria-checked and hidden input checked stay in sync."
