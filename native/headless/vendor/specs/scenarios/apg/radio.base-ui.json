{
  "pattern": "radio",
  "source": "base-ui",
  "commit": "19511bb171f3b360b006c94cf6d07e53cb446505",
  "license": "MIT",
  "scenarios": [
    {
      "id": "radio.base-ui.click-selects-and-fires-change",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L39",
      "upstreamTest": "<RadioGroup /> prop: onValueChange > should call onValueChange when an item is clicked",
      "apg": "pointer",
      "config": { "items": 1, "values": ["a"], "checked": null },
      "steps": [
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "value": "a",
            "events": { "onValueChange": ["a"] },
            "attrs": { "radio:0": { "aria-checked": "true" } }
          }
        }
      ]
    },
    {
      "id": "radio.base-ui.space-selects-on-keyup",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L74",
      "upstreamTest": "<RadioGroup /> prop: onValueChange > should select an item with Space on keyup",
      "apg": "keyboard",
      "config": { "items": 1, "values": ["a"], "checked": null },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        {
          "event": "key",
          "key": "Space",
          "phase": "down",
          "target": "radio:0"
        },
        { "expect": { "checked": null, "events": { "onValueChange": [] } } },
        { "event": "key", "key": "Space", "phase": "up", "target": "radio:0" },
        {
          "expect": {
            "checked": "radio:0",
            "events": { "onValueChange": ["a"] }
          }
        }
      ],
      "notes": "Space commits on keyup; the keydown alone must not change the value."
    },
    {
      "id": "radio.base-ui.enter-does-not-select",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L98",
      "upstreamTest": "<RadioGroup /> prop: onValueChange > should not select an item with Enter",
      "apg": "extension",
      "config": { "items": 1, "values": ["a"], "checked": null },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "Enter", "target": "radio:0" },
        {
          "expect": {
            "checked": null,
            "attrs": { "radio:0": { "aria-checked": "false" } },
            "events": { "onValueChange": [] }
          }
        }
      ],
      "notes": "Enter is not a selection key for radios; only Space (keyup) selects."
    },
    {
      "id": "radio.base-ui.cancel-click-keeps-unchecked",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L118",
      "upstreamTest": "<RadioGroup /> prop: onValueChange > does not change state when canceled via a root click",
      "apg": "extension",
      "config": {
        "items": 1,
        "values": ["a"],
        "checked": null,
        "cancelOnChange": true
      },
      "steps": [
        { "event": "click", "target": "radio:0" },
        {
          "expect": {
            "checked": null,
            "attrs": {
              "radio:0": { "aria-checked": "false" },
              "radiogroup": {
                "data-touched": null,
                "data-dirty": null,
                "data-filled": null
              }
            }
          }
        }
      ],
      "notes": "An onValueChange handler calling eventDetails.cancel() leaves the radio unchecked and the field pristine."
    },
    {
      "id": "radio.base-ui.cancel-arrow-moves-focus-without-checking",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L167",
      "upstreamTest": "<RadioGroup /> prop: onValueChange > does not change state when canceled via arrow key navigation",
      "apg": "extension",
      "config": {
        "items": 2,
        "values": ["a", "b"],
        "checked": null,
        "cancelOnChange": true
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:1",
            "checked": null,
            "attrs": {
              "radio:0": { "aria-checked": "false" },
              "radio:1": { "aria-checked": "false" }
            }
          }
        }
      ],
      "notes": "Cancelling the change on arrow navigation still moves focus but checks nothing."
    },
    {
      "id": "radio.base-ui.disabled-group-aria",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L200",
      "upstreamTest": "<RadioGroup /> prop: disabled > should have the `aria-disabled` attribute",
      "apg": "extension",
      "config": { "items": 1, "values": ["a"], "groupDisabled": true },
      "steps": [
        {
          "expect": {
            "attrs": {
              "radiogroup": { "aria-disabled": "true" },
              "radio:0": {
                "aria-disabled": "true",
                "data-disabled": "true",
                "disabled": "true"
              }
            }
          }
        }
      ],
      "notes": "The disabled group marks itself and each radio aria-disabled and disables the hidden native input."
    },
