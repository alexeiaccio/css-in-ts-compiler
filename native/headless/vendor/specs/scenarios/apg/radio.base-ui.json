    {
      "id": "radio.base-ui.name-on-inputs",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L310",
      "upstreamTest": "<RadioGroup /> should set the name attribute on each radio input",
      "apg": "extension",
      "config": { "items": 1, "values": ["a"], "name": "radio-group" },
