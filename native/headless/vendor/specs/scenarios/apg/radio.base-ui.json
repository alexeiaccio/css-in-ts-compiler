    },
    {
      "id": "radio.base-ui.arrow-navigation-selects",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L757",
      "upstreamTest": "<RadioGroup /> should automatically select radio upon navigation",
      "apg": "keyboard",
      "config": {
        "items": 2,
        "values": ["a", "b"],
        "checked": null,
        "fieldTracking": true
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        {
          "expect": {
            "checked": null,
            "attrs": {
              "radio:0": { "aria-checked": "false" },
              "radiogroup": { "data-touched": null }
            }
          }
        },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:1",
            "checked": "radio:1",
            "attrs": {
              "radio:0": { "aria-checked": "false" },
              "radio:1": { "aria-checked": "true" },
              "radiogroup": { "data-touched": "true" }
            }
          }
        }
      ]
    },
    {
      "id": "radio.base-ui.arrow-to-disabled-does-not-select",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L788",
      "upstreamTest": "<RadioGroup /> should manage arrow key navigation > does not select on refocus after an ignored arrow (single)",
      "apg": "extension",
      "config": {
        "items": 2,
        "values": ["a", "b"],
        "checked": null,
        "disabled": [1]
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        {
          "expect": {
            "focus": "radio:0",
            "checked": null,
            "attrs": { "radio:0": { "aria-checked": "false" } }
          }
        },
        { "event": "key", "key": "Tab", "target": "radio:0" },
        { "event": "key", "key": "Shift+Tab" },
        {
          "expect": {
            "focus": "radio:0",
            "checked": null,
            "attrs": { "radio:0": { "aria-checked": "false" } },
            "events": { "onValueChange": [] }
          }
        }
      ],
      "notes": "The only arrow target is disabled, so the arrow is ignored and no selection is committed on refocus."
    },
    {
      "id": "radio.base-ui.ltr-arrow-navigation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L833",
      "upstreamTest": "<RadioGroup /> ltr > should manage arrow key navigation (ltr)",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "direction": "ltr"
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        { "expect": { "focus": "radio:1" } },
        { "event": "key", "key": "ArrowDown", "target": "radio:1" },
        { "expect": { "focus": "radio:2" } },
        { "event": "key", "key": "ArrowDown", "target": "radio:2" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowUp", "target": "radio:0" },
        { "expect": { "focus": "radio:2" } },
        { "event": "key", "key": "ArrowUp", "target": "radio:2" },
        { "expect": { "focus": "radio:1" } },
        { "event": "key", "key": "ArrowUp", "target": "radio:1" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "radio:0" },
        { "expect": { "focus": "radio:2" } },
        { "event": "key", "key": "ArrowRight", "target": "radio:2" },
        { "expect": { "focus": "radio:0" } }
      ],
      "notes": "Vertical arrows always work; in ltr ArrowLeft moves back and ArrowRight moves forward, both wrapping."
    },
    {
      "id": "radio.base-ui.rtl-arrow-navigation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L833",
      "upstreamTest": "<RadioGroup /> rtl > should manage arrow key navigation (rtl)",
      "apg": "keyboard",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "direction": "rtl"
      },
      "steps": [
        { "event": "focus", "target": "radio:0" },
        { "event": "key", "key": "ArrowDown", "target": "radio:0" },
        { "expect": { "focus": "radio:1" } },
        { "event": "key", "key": "ArrowDown", "target": "radio:1" },
        { "expect": { "focus": "radio:2" } },
        { "event": "key", "key": "ArrowUp", "target": "radio:2" },
        { "expect": { "focus": "radio:1" } },
        { "event": "key", "key": "ArrowUp", "target": "radio:1" },
        { "expect": { "focus": "radio:0" } },
        { "event": "key", "key": "ArrowRight", "target": "radio:0" },
        { "expect": { "focus": "radio:2" } },
        { "event": "key", "key": "ArrowLeft", "target": "radio:2" },
        { "expect": { "focus": "radio:0" } }
      ],
      "notes": "In rtl the horizontal arrows invert: ArrowRight moves back and ArrowLeft moves forward."
    },
    {
      "id": "radio.base-ui.shift-arrow-moves-focus",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/radio-group/RadioGroup.test.tsx#L909",
      "upstreamTest": "<RadioGroup /> modifier keys > when Shift is pressed arrow keys move focus normally",
      "apg": "extension",
      "config": {
        "items": 3,
        "values": ["a", "b", "c"],
        "checked": null,
        "direction": "ltr"
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "radio:0" } },
        {
          "event": "key",
          "key": "ArrowRight",
          "target": "radio:0",
          "modifiers": ["Shift"]
        },
        { "expect": { "focus": "radio:1" } },
        {
          "event": "key",
          "key": "ArrowDown",
          "target": "radio:1",
          "modifiers": ["Shift"]
        },
        { "expect": { "focus": "radio:2" } }
      ],
      "notes": "Shift does not suppress arrow navigation."
    },
