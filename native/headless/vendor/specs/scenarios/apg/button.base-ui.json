    {
      "id": "button.base-ui.keeps-focus-after-becoming-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/button/Button.test.tsx#L243",
