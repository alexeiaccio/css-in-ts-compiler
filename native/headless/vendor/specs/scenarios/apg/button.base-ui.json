            "attrs": { "button:0": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "button:0" },
        {
          "expect": {
            "focus": "button:1",
            "attrs": { "button:1": { "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "button:1" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "ArrowRight", "target": "button:2" },
        { "expect": { "focus": "button:0" } },
        { "event": "key", "key": "ArrowLeft", "target": "button:0" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "ArrowDown", "target": "button:2" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "ArrowUp", "target": "button:2" },
        { "expect": { "focus": "button:2" } }
      ],
      "notes": "Roving tabindex wraps around; the other axis is ignored. rtl/vertical matrix variants omitted for brevity."
    },
    {
      "id": "button.base-ui.toggle-group-keyboard-vertical",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L380",
      "upstreamTest": "keyboard interactions > ltr > orientation: vertical",
      "apg": "keyboard",
      "config": {
        "group": true,
        "direction": "ltr",
        "orientation": "vertical",
        "items": 3
      },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button:0" } },
        { "event": "key", "key": "ArrowDown", "target": "button:0" },
        { "expect": { "focus": "button:1" } },
        { "event": "key", "key": "ArrowDown", "target": "button:1" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "ArrowDown", "target": "button:2" },
        { "expect": { "focus": "button:0" } },
        { "event": "key", "key": "ArrowUp", "target": "button:0" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "ArrowRight", "target": "button:2" },
        { "expect": { "focus": "button:2" } }
      ],
      "notes": "Vertical orientation uses ArrowDown/ArrowUp; horizontal arrows are ignored."
    },
    {
      "id": "button.base-ui.toggle-group-home-key",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L438",
      "upstreamTest": "keyboard interactions > Home key moves focus to the first item",
      "apg": "keyboard",
      "config": { "group": true, "items": 3 },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button:0" } },
        { "event": "key", "key": "ArrowRight", "target": "button:0" },
        { "event": "key", "key": "ArrowRight", "target": "button:1" },
        { "expect": { "focus": "button:2" } },
        { "event": "key", "key": "Home", "target": "button:2" },
        {
          "expect": {
            "focus": "button:0",
            "attrs": { "button:0": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "Home moves roving focus to the first item."
    },
    {
      "id": "button.base-ui.toggle-group-end-key",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L467",
      "upstreamTest": "keyboard interactions > End key moves focus to the last item",
      "apg": "keyboard",
      "config": { "group": true, "items": 3 },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button:0" } },
        { "event": "key", "key": "End", "target": "button:0" },
        {
          "expect": {
            "focus": "button:2",
            "attrs": { "button:2": { "tabindex": "0" } }
          }
        }
      ],
      "notes": "End moves roving focus to the last item."
    },
    {
      "id": "button.base-ui.toggle-group-enter-space-toggles",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L494",
      "upstreamTest": "keyboard interactions > key: Enter/Space toggles the pressed state",
      "apg": "keyboard",
      "config": { "group": true, "key": "Space" },
      "steps": [
        { "event": "focus", "target": "button:0" },
        { "expect": { "attrs": { "button:0": { "aria-pressed": "false" } } } },
        { "event": "key", "key": " ", "target": "button:0" },
        { "expect": { "attrs": { "button:0": { "aria-pressed": "true" } } } },
        { "event": "key", "key": " ", "target": "button:0" },
        { "expect": { "attrs": { "button:0": { "aria-pressed": "false" } } } }
      ],
      "notes": "Enter behaves the same (upstream runs the assertion for both keys)."
    },
    {
      "id": "button.base-ui.toggle-group-on-value-change-click",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L522",
      "upstreamTest": "prop: onValueChange > fires when an Item is clicked",
      "apg": "extension",
      "config": { "group": true },
      "steps": [
        { "event": "click", "target": "button:0" },
        { "expect": { "events": { "onValueChange": [["one"]] } } },
        { "event": "click", "target": "button:1" },
        { "expect": { "events": { "onValueChange": [["two"]] } } }
      ],
      "notes": "Fires with the new value array after each click."
    },
    {
      "id": "button.base-ui.toggle-group-cancel-value-change",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L547",
      "upstreamTest": "prop: onValueChange > does not change the value when the event is canceled",
      "apg": "extension",
      "config": { "group": true, "cancelOnValueChange": true },
      "steps": [
        { "event": "click", "target": "button:0" },
        {
          "expect": {
            "attrs": { "button:0": { "aria-pressed": "false" } },
            "events": { "onValueChange": [["one"]] }
          }
        }
      ],
      "notes": "The callback still fires, but cancel() leaves the state untouched."
    },
    {
      "id": "button.base-ui.toggle-group-on-value-change-keyboard",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/toggle-group/ToggleGroup.test.tsx#L568",
      "upstreamTest": "prop: onValueChange > fires when the Enter/Space is pressed",
      "apg": "keyboard",
      "config": { "group": true, "key": "Space" },
      "steps": [
        { "event": "focus", "target": "button:0" },
        { "event": "key", "key": " ", "target": "button:0" },
        { "expect": { "events": { "onValueChange": [["one"]] } } },
        { "event": "focus", "target": "button:1" },
        { "event": "key", "key": " ", "target": "button:1" },
        { "expect": { "events": { "onValueChange": [["two"]] } } }
      ],
      "notes": "Enter is covered by the same upstream forEach."
    }
  ]
