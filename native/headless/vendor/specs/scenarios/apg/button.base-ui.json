  "scenarios": [
    {
      "id": "button.base-ui.custom-link-space-activates-without-scroll",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/button/Button.test.tsx#L17",
      "upstreamTest": "prop: nativeButton > custom link element: Space activates the link without scrolling the page",
      "apg": "keyboard",
      "config": { "nativeButton": false, "render": "a", "href": "#target" },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button" } },
        { "event": "key", "key": " ", "target": "button" },
        { "expect": { "events": { "onClick": [1] } } },
        { "event": "key", "key": " ", "target": "button", "phase": "up" }
      ],
      "notes": "Space keydown must call preventDefault (no page scroll); only the click callback is asserted here."
    },
    {
      "id": "button.base-ui.custom-element-keyboard-activation",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/button/Button.test.tsx#L42",
      "upstreamTest": "prop: nativeButton > custom element: applies button semantics and dispatches real clicks from keyboard activation",
      "apg": "keyboard",
      "config": { "nativeButton": false, "render": "span" },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": { "button": { "role": "button", "tabindex": "0" } }
          }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button" } },
        { "event": "key", "key": "Enter", "target": "button" },
        { "event": "key", "key": " ", "target": "button" },
        { "expect": { "events": { "onClick": [2], "onClickCapture": [2] } } }
      ],
      "notes": "Both Enter and Space dispatch a real click that bubbles to render/capture and ancestor handlers."
    },
    {
      "id": "button.base-ui.custom-element-keyboard-click-modifiers",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/button/Button.test.tsx#L78",
      "upstreamTest": "prop: nativeButton > custom element: keyboard activation clicks carry modifier key state",
      "apg": "keyboard",
      "config": { "nativeButton": false, "render": "span" },
      "steps": [
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": "button" } },
        {
          "event": "key",
          "key": "Enter",
          "target": "button",
          "modifiers": ["Shift"]
        },
        { "expect": { "events": { "onClick": [{ "shiftKey": true }] } } }
      ],
      "notes": "Synthetic click from keyboard retains the modifier keys held during activation."
    },
    {
      "id": "button.base-ui.native-disabled-attribute-and-no-events",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/button/Button.test.tsx#L100",
      "upstreamTest": "prop: disabled > native button: uses the disabled attribute and is not focusable",
      "apg": "states",
      "config": { "disabled": true, "nativeButton": true },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": { "button": { "disabled": "", "aria-disabled": null } }
          }
        },
        { "event": "key", "key": "Tab" },
        { "expect": { "focus": null } },
        { "event": "click", "target": "button" },
        { "event": "key", "key": " ", "target": "button" },
        { "event": "key", "key": "Enter", "target": "button" },
        {
          "expect": {
            "events": {
              "onClick": [0],
              "onMouseDown": [0],
              "onPointerDown": [0],
              "onKeyDown": [0]
            }
          }
        }
      ],
      "notes": "Native disabled button is removed from tab order and swallows click/mouse/pointer/key handlers."
    },
