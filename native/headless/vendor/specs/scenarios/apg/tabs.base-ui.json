{
  "pattern": "tabs",
  "source": "base-ui",
  "commit": "19511bb171f3b360b006c94cf6d07e53cb446505",
  "license": "MIT",
  "scenarios": [
    {
      "id": "tabs.base-ui.selected-prop-drives-aria",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L236",
      "upstreamTest": "should pass selected prop to children",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 2,
        "selected": 1
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "true" }
            }
          }
        }
      ],
      "notes": "Controlled value 1 marks only the second tab selected."
    },
    {
      "id": "tabs.base-ui.first-enabled-skipping-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L286",
      "upstreamTest": "should select the second tab when the first one is disabled",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 2,
        "disabled": [0]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "true" }
            },
            "visible": ["tabpanel:1"]
          }
        }
      ],
      "notes": "With no explicit value the first enabled tab becomes selected; the disabled panel stays hidden."
    },
    {
      "id": "tabs.base-ui.third-enabled-when-first-two-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L314",
      "upstreamTest": "should select the third tab when first two tabs are disabled",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 4,
        "disabled": [0, 1]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "false" },
              "tab:2": { "aria-selected": "true" },
              "tab:3": { "aria-selected": "false" }
            }
          }
        }
      ],
      "notes": "The first non-disabled tab (index 2) is auto-selected."
    },
    {
      "id": "tabs.base-ui.explicit-value-points-at-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L404",
      "upstreamTest": "should still honor explicit value prop even if it points to a disabled tab",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0,
        "disabled": [0]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" },
              "tab:2": { "aria-selected": "false" }
            }
          }
        }
      ],
      "notes": "An explicit selection wins even when it names a disabled tab; auto-fallback applies only to implicit defaults."
    },
    {
      "id": "tabs.base-ui.no-selection-all-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L467",
      "upstreamTest": "does not select any tab when all tabs are disabled",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "disabled": [0, 1, 2]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "false" },
              "tab:2": { "aria-selected": "false" }
            },
            "visible": []
          }
        }
      ],
      "notes": "All panels hidden when no tab can be selected."
    },
    {
      "id": "tabs.base-ui.disabled-selected-tab-keeps-tabindex-on-previous",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L432",
      "upstreamTest": "does not set tabIndex=0 on disabled tabs when they are programmatically selected",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 1,
        "disabled": [0]
      },
      "steps": [
        {
          "expect": {
            "attrs": {
              "tab:0": { "tabindex": "-1" },
              "tab:1": { "tabindex": "0" },
              "tab:2": { "tabindex": "-1" }
            }
          }
        },
        { "event": "prop", "prop": "selectedKey", "value": 0 },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "true", "tabindex": "-1" },
              "tab:1": { "tabindex": "0" }
            }
          }
        }
      ],
      "notes": "Programmatically selecting a disabled tab marks it selected but leaves the roving tab stop on the previously highlighted enabled tab."
    },
    {
      "id": "tabs.base-ui.arrow-next-activates",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1637",
      "upstreamTest": "moves focus to the next tab while activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 1
      },
      "steps": [
        { "event": "focus", "target": "tab:1" },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } },
            "events": { "onValueChange": ["tab:2"] }
          }
        }
      ],
      "notes": "activateOnFocus=true: arrow moves focus and commits the selection."
    },
    {
      "id": "tabs.base-ui.arrow-next-focus-only",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1528",
      "upstreamTest": "moves focus to the next tab without activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            },
            "events": { "onValueChange": [] }
          }
        }
      ],
      "notes": "activateOnFocus=false: arrow moves focus without selecting and without firing onValueChange."
    },
    {
      "id": "tabs.base-ui.arrow-previous-activates",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1427",
      "upstreamTest": "moves focus to the previous tab while activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 1
      },
      "steps": [
        { "event": "focus", "target": "tab:1" },
        { "event": "key", "key": "ArrowLeft", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } },
            "events": { "onValueChange": ["tab:0"] }
          }
        }
      ],
      "notes": "activateOnFocus=true previous direction."
    },
    {
      "id": "tabs.base-ui.arrow-wraps-across-ends",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1291",
      "upstreamTest": "moves focus to the last tab while activating it if focus is on the first tab",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowLeft", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "APG allows optional wrapping; base-ui wraps by default."
    },
    {
      "id": "tabs.base-ui.rtl-arrow-mapping",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1281",
      "upstreamTest": "when focus is on a tab element in a horizontal rtl tablist ArrowRight moves focus to the previous tab while activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 1,
        "direction": "rtl"
      },
      "steps": [
        { "event": "focus", "target": "tab:1" },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowLeft", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": { "tab:1": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "In RTL the horizontal previous/next keys are mirrored."
    },
    {
      "id": "tabs.base-ui.vertical-arrow-mapping",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1282",
      "upstreamTest": "when focus is on a tab element in a vertical tablist ArrowDown moves focus to the next tab while activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "activation": "automatic",
        "items": 3,
        "selected": 1
      },
      "steps": [
        { "event": "focus", "target": "tab:1" },
        { "event": "key", "key": "ArrowDown", "target": "tab:1" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } }
          }
        },
        { "event": "key", "key": "ArrowUp", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": { "tab:1": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "Vertical tablists use ArrowUp/ArrowDown."
    },
    {
      "id": "tabs.base-ui.arrow-focuses-disabled-without-activating",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1673",
      "upstreamTest": "ArrowRight moves focus to a disabled tab without activating it",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0,
        "disabled": [1]
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            },
            "events": { "onValueChange": [] }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        { "expect": { "focus": "tab:2" } }
      ],
      "notes": "A disabled tab is focusable for roving focus but is never activated; the next arrow moves on to the following tab."
    },
    {
      "id": "tabs.base-ui.home-end-activates",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1784",
      "upstreamTest": "when `activateOnFocus = true`, moves focus to the first tab while activating it (Home)",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "End", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "true" } },
            "events": { "onValueChange": ["tab:2"] }
          }
        },
        { "event": "key", "key": "Home", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } },
            "events": { "onValueChange": ["tab:2", "tab:0"] }
          }
        }
      ],
      "notes": "Home/End always move focus to the first/last tab regardless of orientation; automatic activation commits them."
    },
    {
      "id": "tabs.base-ui.home-end-focus-only",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1756",
      "upstreamTest": "when `activateOnFocus = false`, moves focus to the first tab without activating it (Home)",
      "apg": "keyboard",
      "config": {
        "orientation": "vertical",
        "activation": "manual",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "End", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:2",
            "attrs": { "tab:2": { "aria-selected": "false" } },
            "events": { "onValueChange": [] }
          }
        },
        { "event": "key", "key": "Home", "target": "tab:2" },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        }
      ],
      "notes": "Manual activation: Home/End move focus only."
    },
    {
      "id": "tabs.base-ui.modifier-keys-do-not-navigate",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1714",
      "upstreamTest": "does not move focus when modifier key: Shift is pressed",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        {
          "event": "key",
          "key": "ArrowRight",
          "value": { "modifiers": ["Shift"] },
          "target": "tab:0"
        },
        {
          "expect": {
            "focus": "tab:0",
            "attrs": { "tab:0": { "aria-selected": "true" } },
            "events": { "onValueChange": [] }
          }
        }
      ],
      "notes": "Arrow keys with any modifier (Shift/Control/Alt/Meta) are left to the browser."
    },
    {
      "id": "tabs.base-ui.aria-orientation-default-absent",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1189",
      "upstreamTest": "does not add aria-orientation by default",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 1,
        "selected": 0
      },
      "steps": [
        { "expect": { "attrs": { "tablist": { "aria-orientation": null } } } }
      ],
      "notes": "Horizontal is the implicit ARIA default, so aria-orientation is omitted."
    },
    {
      "id": "tabs.base-ui.aria-orientation-vertical",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1201",
      "upstreamTest": "adds the proper aria-orientation when vertical",
      "apg": "aria",
      "config": {
        "orientation": "vertical",
        "activation": "automatic",
        "items": 1,
        "selected": 0
      },
      "steps": [
        {
          "expect": {
            "attrs": { "tablist": { "aria-orientation": "vertical" } }
          }
        }
      ],
      "notes": "Vertical orientation is exposed on the tablist."
    },
    {
      "id": "tabs.base-ui.click-selects",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1215",
      "upstreamTest": "selects the clicked tab",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": { "tab:1": { "aria-selected": "true" } },
            "visible": ["tabpanel:1"]
          }
        }
      ],
      "notes": "Pointer click selects even with activateOnFocus=false."
    },
    {
      "id": "tabs.base-ui.click-disabled-does-not-select",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L1245",
      "upstreamTest": "does not select the clicked disabled tab",
      "apg": "aria",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 3,
        "selected": 0,
        "disabled": [1]
      },
      "steps": [
        { "event": "click", "target": "tab:1" },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            },
            "visible": ["tabpanel:0"]
          }
        }
      ],
      "notes": "Disabled tabs ignore pointer activation."
    },
    {
      "id": "tabs.base-ui.keyboard-activation-enter-space",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/tab/TabsTab.test.tsx#L218",
      "upstreamTest": "activates the focused tab with Enter/Space when `activateOnFocus` is false",
      "apg": "keyboard",
      "config": {
        "orientation": "horizontal",
        "activation": "manual",
        "items": 2,
        "selected": 0
      },
      "steps": [
        { "event": "focus", "target": "tab:0" },
        { "event": "key", "key": "ArrowRight", "target": "tab:0" },
        {
          "expect": {
            "focus": "tab:1",
            "attrs": { "tab:1": { "aria-selected": "false" } }
          }
        },
        { "event": "key", "key": "Enter", "target": "tab:1" },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "false" },
              "tab:1": { "aria-selected": "true" }
            }
          }
        },
        { "event": "key", "key": "ArrowRight", "target": "tab:1" },
        { "event": "key", "key": " ", "target": "tab:0" },
        {
          "expect": {
            "attrs": {
              "tab:0": { "aria-selected": "true" },
              "tab:1": { "aria-selected": "false" }
            }
          }
        }
      ],
      "notes": "Manual activation is committed with either Enter or Space."
    },
    {
      "id": "tabs.base-ui.onvaluechange-initial-and-pointer",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L622",
      "upstreamTest": "calls onValueChange when auto-selecting the first tab on mount",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3
      },
      "steps": [
        {
          "expect": {
            "attrs": { "tab:0": { "aria-selected": "true" } },
            "events": { "onValueChange": ["tab:0"] }
          }
        },
        {
          "event": "pointerdown",
          "value": { "button": "primary" },
          "target": "tab:1"
        },
        { "expect": { "events": { "onValueChange": ["tab:0", "tab:1"] } } }
      ],
      "notes": "Implicit first-tab selection fires onValueChange with reason 'initial'; activateOnFocus makes pointerdown commit too."
    },
    {
      "id": "tabs.base-ui.onvaluechange-not-repeated",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L560",
      "upstreamTest": "should not call onValueChange when already active",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 2,
        "selected": 0
      },
      "steps": [
        { "event": "click", "target": "tab:0" },
        {
          "expect": {
            "events": { "onValueChange": [] },
            "attrs": { "tab:0": { "aria-selected": "true" } }
          }
        },
        {
          "event": "click",
          "value": { "button": "secondary" },
          "target": "tab:1"
        },
        { "expect": { "events": { "onValueChange": [] } } }
      ],
      "notes": "Re-clicking the active tab and non-primary button clicks do not change value."
    },
    {
      "id": "tabs.base-ui.disabled-selected-becomes-disabled",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/tabs/root/TabsRoot.test.tsx#L872",
      "upstreamTest": "calls onValueChange when the selected tab becomes disabled",
      "apg": "extension",
      "config": {
        "orientation": "horizontal",
        "activation": "automatic",
        "items": 3,
        "selected": 0
      },
      "steps": [
        { "event": "prop", "prop": "disabled", "value": [0] },
        {
