    {
      "id": "switch.base-ui.click-toggles-aria-checked",
      "upstream": "https://github.com/mui/base-ui/blob/19511bb171f3b360b006c94cf6d07e53cb446505/packages/react/src/switch/root/SwitchRoot.test.tsx#L36",
      "upstreamTest": "interactions > should change its state when clicked",
      "apg": "aria",
      "config": { "part": "switch", "checked": false },
      "steps": [
        { "event": "prop", "set": {} },
        {
          "expect": {
            "attrs": { "switch": { "role": "switch", "aria-checked": "false" } }
          }
        },
        { "event": "click", "target": "switch" },
        { "expect": { "attrs": { "switch": { "aria-checked": "true" } } } }
      ],
      "notes": "Click toggles aria-checked on the exposed switch element."
    },
    {
      "id": "switch.base-ui.controlled-updates-from-outside",
