    {
      "id": "disclosure.react-aria.repeat-keydown-single-toggle",
      "upstream": "https://github.com/adobe/react-spectrum/blob/99e610236887da619ad9d54a1cd87983166c043d/packages/react-aria-components/test/Disclosure.test.js#L345",
      "upstreamTest": "Disclosure > should not expand or collapse on repeat keydown events",
      "apg": "keyboard",
      "config": { "initialOpen": false },
      "steps": [
        { "event": "focus", "target": "trigger:0" },
        { "expect": { "visible": [], "focus": "trigger:0" } },
        {
          "event": "key",
          "key": "Enter",
          "target": "trigger:0",
          "repeat": true
        },
        {
          "event": "key",
          "key": "Enter",
          "target": "trigger:0",
          "repeat": true
        },
        {
          "expect": {
            "visible": ["panel:0"],
            "events": { "onExpandedChange": [true] }
          }
        },
        {
          "event": "key",
          "key": "Enter",
          "target": "trigger:0",
          "repeat": true
        },
        {
          "event": "key",
          "key": "Enter",
          "target": "trigger:0",
          "repeat": true
        },
        {
          "expect": {
            "visible": [],
            "events": { "onExpandedChange": [true, false] }
          }
        }
      ],
      "notes": "One physical key press that emits multiple repeated keydown events toggles the disclosure only once."
    },
