{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  // Shared by the packages with Effect code (cssints, css-grammar, icons): every Effect language service diagnostic as an
  // error (the off-by-default ones and the suggestions too), the rest left off for the reasons below. `bun run typecheck`
  // runs them through `tsc-rs` (scripts/typecheck.mjs), the Rust port of tsc 7 with these diagnostics built in.
  "compilerOptions": {
    "customConditions": ["development"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectSuggestionsInTscExitCode": false,
        // @opencode/client (the devtools' OpenCode prompt box, an optional peer of cssints) pins effect 4.0.0-rc.112 for its own
        // schemas; its Promise client shares no value with ours
        "allowedDuplicatedPackages": ["effect"],
        "diagnosticSeverity": {
          "abortControllerInEffect": "error",
          "acquireReleaseDisposable": "error",
          "allOfMapToForEach": "error",
          // tsc-rs 0.7.0 reports TS2590 (no file, no position) while running this rule: it walks the error types of every
          // Effect, and over the recognizer's unions and the variadic-property types (css-grammar/src/api-typed.ts,
          // cssints/test/types/errors.ts) that walk ends in a union too complex to represent. @effect/tsgo 0.48.0 and
          // 0.51.1 report nothing with the same config, so it is a port bug; a per-file override did not silence it. Off
          // until a tsc-rs release fixes it (nothing in the repo has an `any` in an error channel today).
          "anyUnknownInErrorContext": "off",
          "asyncFunction": "error",
          "catchAllTagDispatchToCatchTag": "error",
          "catchAllToMapError": "error",
          "catchChainToFirstSuccessOf": "error",
          "catchConditionalRefailToCatchIf": "error",
          "catchDieToOrDie": "error",
          "catchTagToCatchReason": "error",
          "catchToIgnore": "error",
          "catchToOrElseSucceed": "error",
          "catchUnfailableEffect": "error",
          "classSelfMismatch": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "deterministicKeys": "error",
          "duplicatePackage": "error",
          "effectDoNotation": "error",
          "effectFnIife": "error",
          "effectFnImplicitAny": "error",
          "effectFnOpportunity": "error",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "effectMapFlatten": "error",
          "effectMapVoid": "error",
          "effectSucceedWithVoid": "error",
          "extendsNativeError": "error",
          // 53 reports, all in @cssints/mcp: effect/http and effect/ai are unstable APIs in effect 4; the repo's stance on
          // them is not decided yet, and these two rules arrive with the 0.51.1 rule set that tsc-rs ports (the 0.48.0 one
          // has neither). `tsc-rs` also counts a warning as a failure (upstream exits 0), so a warning would turn the
          // typecheck red. Decide with the policy, then allow effect/http and effect/ai or fix the calls.
          "experimentalApiUsage": "off",
          "flatMapConditionalToFilterOrFail": "error",
          "flatMapToMap": "error",
          "floatingEffect": "error",
          "floatingEffectInVitest": "error",
          "genericEffectServices": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "instanceOfSchema": "error",
          "layerMergeAllWithDependencies": "error",
          "lazyEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "leakingRequirements": "error",
          "mapSomeToAsSome": "error",
          "matchEffectToMapBoth": "error",
          "matchEffectToMatch": "error",
          "missedPipeableOpportunity": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingEffectServiceDependency": "error",
          "missingLayerContext": "error",
          // 52 reports: asks for dual (pipeable) overloads on exported functions; the engine is called data-first, nothing pipes its functions
          "missingPipeableSignature": "off",
          "missingReturnYieldStar": "error",
          "missingStarInYieldEffectGen": "error",
          "multipleCatchTag": "error",
          "multipleEffectProvide": "error",
          "nestedEffectGenYield": "error",
          "newPromise": "error",
          "newSchemaClass": "error",
          // 12 reports: node:fs, node:path, node:crypto in the Node-only Vite plugin and the generator scripts; the Effect counterparts need @effect/platform-node, a dependency for no gain here
          "nodeBuiltinImport": "off",
          "nonObjectEffectServiceType": "error",
          "obsoleteMatchImport": "error",
          "obsoleteSchemaImport": "error",
          "optionMatchToFromOption": "error",
          "outdatedApi": "error",
          "overriddenSchemaConstructor": "error",
          "preferSchemaOverJson": "error",
          "preferSchemaTypeProperty": "error",
          "preferSucceedSomeOrNone": "error",
          "preferTypedSchemaDecoder": "error",
          "preferUnsafeConstructor": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "promiseInEffectSuccess": "error",
          "provideLayerSucceedToProvideService": "error",
          "raceFirstWithSleepToTimeout": "error",
          "redundantMapError": "error",
          "redundantOrDie": "error",
          "redundantSchemaTagIdentifier": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "runOfExitToRunExit": "error",
          "schemaLiteralNonFinite": "error",
          "schemaNumber": "error",
          "schemaOpaqueInstanceMember": "error",
          "schemaStructWithTag": "error",
          "schemaSync": "error",
          "schemaSyncInEffect": "error",
          "schemaUnionOfLiterals": "error",
          "scopeInLayerEffect": "error",
          "serviceNotAsClass": "error",
          // 918 reports: the engine, hot paths included, tests truthiness (`if (!m)`, `!!x`, `a ?? b || c`) throughout; the rule asks for explicit comparisons everywhere
          "strictBooleanExpressions": "off",
          "strictEffectProvide": "error",
          "syncToSucceed": "error",
          "timeoutCatchTagToTimeoutOrElse": "error",
          "tryCatchInEffectGen": "error",
          "unknownInEffectCatch": "error",
          "unnecessaryArrowBlock": "error",
          "unnecessaryEffectGen": "error",
          "unnecessaryFailYieldableError": "error",
          "unnecessaryPipe": "error",
          "unnecessaryPipeChain": "error",
          "unnecessaryTypeofType": "error",
          // see experimentalApiUsage above
          "unstableApiUsage": "off",
          "unsafeEffectTypeAssertion": "error"
        },
        "overrides": [
          {
            // Tests, benches and generator scripts are node scripts: they print and read the environment.
            "include": ["**/test/*.ts", "**/bench/*.ts", "**/scripts/*.ts"],
            "options": { "diagnosticSeverity": { "globalConsole": "off", "processEnv": "off" } }
          }
        ]
      }
    ]
  }
}
