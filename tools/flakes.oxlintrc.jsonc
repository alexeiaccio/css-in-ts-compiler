// The flake pass: the testing rules over the files the main lint leaves out (`**/test/**`, `apps/**`), because a test that
// waits on the clock instead of on a signal is exactly what the main pass cannot see. Run with `bun run lint:flakes`.
//
// `no-test-doubles` and `strict-msw` are not on: our doubles are fixtures of a protocol (a fake dev server, a fake clock, a
// fake terminal palette), not stubs of the thing under test, and we do not use MSW.
//
// Every allowlist here is a ratchet with exact per-file counts: a file may keep what it has, and a file that improves
// reports itself as stale until its entry is lowered. What is left is a delay that IS the subject — a toast's own
// timeout, a real 200 ms carousel interval, a 300 ms tooltip grace, a velocity window, a page-side task in the vitals
// test — plus the exploration timeouts the repo documents. `flakes/no-test-sleep` is ours: landmines reports the `await`,
// and 125 sleeps hid behind a `settle()` helper it cannot follow. A zero delay is not reported at all: a task boundary is
// the browser's own turn, not a race with the clock.
{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": { "correctness": "off" },
  "jsPlugins": [
    { "name": "landmines-testing", "specifier": "@interfere/landmines/testing" },
    { "name": "flakes", "specifier": "./ai-automation/scripts/flakes/plugin.ts" },
  ],
  "rules": {
    "landmines-testing/no-fixed-sleep": [
      "warn",
      {
        "allow": {
          "apps/ui/src/registry/carousel/carousel.browser.test.tsx": 1,
          "apps/ui/src/registry/drawer/drawer.browser.test.tsx": 1,
          "apps/ui/src/registry/tooltip/tooltip.browser.test.tsx": 1,
        },
      },
    ],
    "landmines-testing/no-unsignaled-poll": "warn",
    "landmines-testing/no-flake-masking": [
      "warn",
      {
        "allow": {
          "apps/ui/vitest.browser.config.ts": 1,
          "packages/apg-specs/test/apg/listbox-multi.test.ts": 1,
          "packages/apg-specs/test/apg/listbox-rearrangeable.test.ts": 1,
          "packages/apg-specs/test/apg/listbox-single.test.ts": 1,
          "packages/apg-specs/test/apg/listbox-typeahead.test.ts": 1,
          "packages/apg-specs/vite.config.ts": 1,
          "packages/headless/vite.config.ts": 1,
          "tools/ai-automation/vite.config.ts": 1,
        },
      },
    ],
    "flakes/no-test-sleep": [
      "warn",
      {
        "allow": {
          "apps/csssky-tui/test/screens.mjs": 1,
          "apps/ui/src/registry/carousel/carousel.browser.test.tsx": 1,
          "apps/ui/src/registry/drawer/drawer.browser.test.tsx": 2,
          "apps/ui/src/registry/panzoom/panzoom.browser.test.tsx": 1,
          "apps/ui/src/registry/toast/toast.browser.test.tsx": 1,
          "apps/ui/src/registry/tooltip/tooltip.browser.test.tsx": 1,
          "apps/ui/test/vitals.mjs": 1,
          "packages/cssints/test/browsers.mjs": 1,
          "packages/cssints/test/fixtures/eval-timeout-wait.ts": 1,
          "packages/devtools/test/vitals-browser.mjs": 3,
          "packages/headless/test/canvas.content-visibility.browser.test.tsx": 1,
          "packages/headless/test/toast.browser.test.tsx": 1,
          "packages/reveal/test/browsers.mjs": 1,
          "packages/tui/test/render.ts": 1,
        },
      },
    ],
  },
}
