{
	"name": "@cssints/monorepo",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*",
		"tools/*"
	],
	"scripts": {
		"prepare": "effect-language-service patch && effect-tsgo patch --typescript",
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp run -r --cache test",
		"bench": "vp run -r bench",
		"typecheck": "vp run --filter \"./packages/*\" --filter \"./tools/*\" --filter ./apps/demo --filter ./apps/sky typecheck",
		"diff:check": "node tools/ai-automation/scripts/diff-check/src/main.ts --config tools/ai-automation/scripts/diff-check/diff-check.config.json",
		"check": "vp check && bun run typecheck",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check"
	},
	"devDependencies": {
		"@effect/language-service": "^0.81.0",
		"@effect/tsgo": "^0.45.0",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.2.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"@typescript/native-preview": "^7.0.0-dev.20260212.1",
		"eslint-plugin-playwright": "^2.5.1",
		"typescript": "^5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"packageManager": "bun@1.3.1",
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0"
	}
}
