{
  "name": "@cssints/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "native",
    "native/headless"
  ],
  "scripts": {
    "prepare": "effect-language-service patch && effect-tsgo patch --typescript",
    "build": "vp run -r build",
    "build:packages": "vp run --filter \"./packages/*\" build",
    "changeset": "changeset",
    "version-packages": "node scripts/changelog.mjs && bun install --lockfile-only",
    "release:check": "bun run build:packages && node scripts/release.mjs",
    "release:publish": "changeset publish",
    "release": "bun run release:check && bun run release:publish",
    "dev": "vp run -r --parallel dev",
    "test": "vp run -r --cache test",
    "bench": "vp run -r bench",
    "test:native": "sh native/test.sh",
    "typecheck": "vp run --filter \"./packages/*\" --filter \"./tools/*\" --filter ./apps/demo --filter ./apps/csssky --filter ./apps/csssky-tui --filter ./apps/docs typecheck",
    "diff:check": "node tools/ai-automation/scripts/diff-check/src/main.ts --config tools/ai-automation/scripts/diff-check/diff-check.config.json",
    "check": "vp check && bun run typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "^0.57.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/native-preview": "^7.0.0-dev.20260212.1",
    "@yielded/effect-tsrs": "^0.2.2",
    "eslint-plugin-playwright": "^2.12.1",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.1",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}
