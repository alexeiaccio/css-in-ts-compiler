{
	"name": "@cssints/monorepo",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"prepare": "effect-language-service patch",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"bench": "turbo run bench",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"lint:check": "oxlint --type-aware --type-check",
		"fmt": "oxfmt --write",
		"fmt:check": "oxfmt --check"
	},
	"devDependencies": {
		"@effect/language-service": "^0.81.0",
		"@effect/tsgo": "^0.0.15",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260212.1",
		"eslint-plugin-playwright": "^2.5.1",
		"oxfmt": "^0.31.0",
		"oxlint": "1.56.0",
		"oxlint-tsgolint": "^0.12.0",
		"turbo": "latest",
		"typescript": "^5.9.3"
	},
	"packageManager": "bun@1.3.1"
}
