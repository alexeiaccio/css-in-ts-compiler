# dependencies (bun install)
node_modules

# output
out
dist
*.tgz
# the publishable copy of a package (scripts/stage.mjs)
.publish

# The four publishable packages are consumed over git: their exports default to
# dist (src is the `development` condition), so the built dist is tracked.
!packages/cssints/dist/
!packages/cssints/dist/**
!packages/css-grammar/dist/
!packages/css-grammar/dist/**
!packages/icons/dist/
!packages/icons/dist/**
!packages/mise-en-mode/dist/
!packages/mise-en-mode/dist/**
# the apps (demo, csssky, docs) call reset(): CI builds them without building the package first
!packages/reset/dist/
!packages/reset/dist/**
# the docs site's overlay: CI deploys it without a build
!packages/devtools/dist/
!packages/devtools/dist/**

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# git worktrees
.worktrees

# docs/API.md, copied into the cssints package when it is packed (its "prepack" script)
packages/cssints/docs/

# packages/cssints/test/spec/harness.mjs temp apps
packages/cssints/test/.tmp-*
.alchemy
