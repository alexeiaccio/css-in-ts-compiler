{
  "name": "cssints-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "node scripts/tokens-types.mjs --check && node ../../scripts/typecheck.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node test/search.mjs && node test/settings.mjs && node test/contrast.mjs && node test/pds.mjs && node test/build.mjs && node test/browser.mjs && node test/frames.mjs && node test/playground.mjs && node test/tui.mjs",
    "tokens:types": "node scripts/tokens-types.mjs",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "@cssints/headless": "workspace:*",
    "@cssints/icons": "workspace:*",
    "@cssints/reset": "workspace:*",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.13",
    "cssints": "workspace:*",
    "solid-js": "2.0.0-rc.13"
  },
  "devDependencies": {
    "@atcute/bluesky": "^4.0.22",
    "@atcute/client": "^5.1.2",
    "@bomb.sh/tty": "0.9.0",
    "@cssints/devtools": "workspace:*",
    "@cssints/rybitten": "workspace:*",
    "@cssints/tui": "workspace:*",
    "@effect/platform-bun": "4.0.0",
    "@iconify-json/ph": "^1.2.2",
    "@opencode/client": "2.0.26",
    "@oxc-parser/binding-wasm32-wasi": "0.149.0",
    "@oxc-transform/binding-wasm32-wasi": "0.149.0",
    "@shikijs/twoslash": "^3.0.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@wasm-fmt/oxc_fmt": "0.2.9",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.6",
    "ghostty-web": "0.4.0",
    "lightningcss": "^1.32.0",
    "lightningcss-wasm": "1.33.0",
    "magic-string": "^0.30.0",
    "marked": "^16.0.0",
    "monaco-editor": "0.57.0",
