{
  "name": "cssints-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run catalog && vp build",
    "deploy": "bun alchemy deploy --stage prod --yes",
    "destroy": "bun alchemy destroy --stage prod",
    "dev": "vp dev",
    "preview": "vp preview",
    "test": "vp test run --config vitest.browser.config.ts",
    "typecheck": "node ../../scripts/typecheck.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "theme:check": "node --experimental-strip-types scripts/theme-css.ts --check",
    "skin:check": "node --experimental-strip-types scripts/skin-check.ts",
    "test:site": "node test/site.mjs",
    "test:vitals": "node test/vitals.mjs",
    "catalog": "node scripts/catalog.ts"
  },
  "dependencies": {
    "@cssints/css-grammar": "workspace:*",
    "@cssints/headless": "workspace:*",
    "@cssints/machine": "workspace:*",
    "@cssints/mise-en-mode": "workspace:*",
    "@cssints/reset": "workspace:*",
    "@cssints/reveal": "workspace:*",
    "@cssints/stories": "workspace:*",
    "@solidjs/web": "2.0.0-rc.21",
    "cssints": "workspace:*",
    "perfect-arrows": "0.3.5",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@cssints/apg-specs": "workspace:*",
    "@cssints/devtools": "workspace:*",
    "@quint-machine/core": "0.1.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@vitest/browser-playwright": "5.0.5",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.6",
    "lightningcss": "^1.32.0",
    "playwright": "1.64.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
