{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cssints",
  "homepage": "https://ui.cssints.dev",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "theme",
      "type": "registry:file",
      "title": "Neutral theme",
      "description": "The neutral theme as plain custom properties, derived from React Aria's starter (Apache-2.0)",
      "files": [
        {
          "path": "theme.css",
          "target": "src/components/ui/theme.css",
          "type": "registry:file"
        }
      ]
    },
    {
