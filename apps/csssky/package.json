    "test:browser": "node test/browser.mjs",
    "test:old-browser": "node test/old-browser.mjs",
    "test:safari": "node test/safari.mjs",
    "test:posts": "node test/posts-browser.mjs",
    "test:home": "node test/home-browser.mjs",
    "test:profile": "node test/profile-browser.mjs",
    "test:thread": "node test/thread-browser.mjs",
    "test:dev": "node test/dev-browser.mjs",
    "test:coverage": "node test/coverage.mjs",
    "preview": "vp preview",
    "tokens:types": "node scripts/tokens-types.mjs"
