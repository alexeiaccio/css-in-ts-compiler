{
  "hue": {
    "$type": "number",
    "$description": "Degrees of OKLCH hue. accent is the one input of the colour palette: set --hue-accent on <html> (Witchsky's slider is the offset from 345, -180 to 180).",
    "accent": { "$value": 345 }
  },
  "color": {
    "$type": "color",
    "$description": "Mu light theme. The neutrals are Mu's contrast ramp (src/config/brand.json), the accent family is Mu pink (primary ramp) with its OKLCH lightness and chroma and the hue from hue.accent.",
    "bg": { "$value": "#ffffff", "$description": "contrast_0" },
    "bgSubtle": { "$value": "#f7f7f2", "$description": "contrast_25" },
    "bgMuted": { "$value": "#edebe5", "$description": "contrast_50" },
    "border": { "$value": "#e0ded9", "$description": "contrast_100, border_contrast_low" },
    "borderStrong": { "$value": "#c5c4bf", "$description": "contrast_200" },
    "borderStronger": { "$value": "#abaaa6", "$description": "contrast_300" },
    "textLow": { "$value": "#92918e", "$description": "contrast_400" },
    "textMedium": { "$value": "#4b4a49", "$description": "contrast_700" },
    "textHigh": { "$value": "#2a2a2a", "$description": "contrast_900" },
    "text": { "$value": "#000000", "$description": "contrast_1000" },
    "textInverted": { "$value": "{color.bg}" },
    "accent": {
      "$value": "oklch(0.637 0.203 {hue.accent})",
      "$description": "primary_500, the same in every theme"
    },
    "accentHover": {
      "$value": "oklch(0.58 0.182 {hue.accent})",
      "$description": "primary_600"
    },
    "accentStrong": {
      "$value": "oklch(0.47 0.164 {hue.accent})",
      "$description": "primary_700 (Mu: 0.525) darkened: accent text on accentSoft and on bg holds 4.5 at every hue"
    },
    "accentSoft": {
      "$value": "oklch(0.926 0.056 {hue.accent})",
      "$description": "primary_50"
    },
    "onAccent": {
      "$value": "lab(from color(from {color.accent} srgb-linear clamp(0, r, 1) clamp(0, g, 1) clamp(0, b, 1)) clamp(0, (49.4 - l) * 1e6, 100) 0 0)",
      "$description": "black or white, whichever reads better on accent: white under CIE L* 49.4 (relative luminance 0.179, where both give 4.58), black over it. Read from the accent clipped to sRGB, so a theme that overrides accent gets its own pick"
    },
    "link": {
      "$value": "{color.accentStrong}",
      "$description": "text_link: Mu's primary_500 is 3.8 on white, so light uses accentStrong; dim and dark set it to primary_600"
    },
    "positive": { "$value": "#09b35e", "$description": "positive_500, not hue-driven" },
    "positiveSoft": { "$value": "#d3fde8", "$description": "positive_50" },
    "negative": { "$value": "#e91646", "$description": "negative_500, not hue-driven" },
    "negativeSoft": { "$value": "#fee7ec", "$description": "negative_50" },
    "like": { "$value": "#ec4899", "$description": "palette.pink" },
    "shadow": {
      "$value": "oklch(0 0 0 / 0.1)",
      "$description": "alpha(black, 0.1); 0.4 in dim and dark"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "alf tokens.space",
    "2xs": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 20, "unit": "px" } },
    "2xl": { "$value": { "value": 24, "unit": "px" } },
    "3xl": { "$value": { "value": 28, "unit": "px" } },
    "4xl": { "$value": { "value": 32, "unit": "px" } },
    "5xl": { "$value": { "value": 40, "unit": "px" } }
  },
  "gutter": {
    "$type": "dimension",
    "$description": "useGutters: compact, base and wide at the phone size; a theme under (width >= 800px) raises them to 12, 20 and 28.",
    "compact": { "$value": "{space.sm}" },
    "base": { "$value": "{space.lg}" },
    "wide": { "$value": "{space.xl}" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "alf tokens.borderRadius; button and avatar are the ones Witchsky's square options change",
    "2xs": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 20, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } },
    "button": { "$value": "{radius.full}", "$description": "square buttons: radius.sm" },
    "avatar": { "$value": "{radius.full}", "$description": "square avatars over 32px: 8px" },
    "avatarSmall": {
      "$value": "{radius.full}",
      "$description": "square avatars of 32px and less: 3px"
    }
  },
  "font": {
    "scale": {
      "$type": "number",
      "$description": "Bluesky's font size setting: 0.9375, 1 or 1.0625",
      "$value": 1
    }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "alf tokens.fontSize times font.scale",
    "2xs": { "$value": "calc(9.4px * {font.scale})" },
    "xs": { "$value": "calc(11.3px * {font.scale})" },
    "sm": { "$value": "calc(13.1px * {font.scale})" },
    "md": { "$value": "calc(15px * {font.scale})" },
    "lg": { "$value": "calc(16.9px * {font.scale})" },
    "xl": { "$value": "calc(18.8px * {font.scale})" },
    "2xl": { "$value": "calc(20.6px * {font.scale})" },
    "3xl": { "$value": "calc(24.3px * {font.scale})" },
    "4xl": { "$value": "calc(30px * {font.scale})" },
    "5xl": { "$value": "calc(37.5px * {font.scale})" }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.15 },
    "snug": { "$value": 1.3 },
    "relaxed": { "$value": 1.5 }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "normal": { "$value": 400 },
    "medium": { "$value": 500 },
    "semiBold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "border": {
    "$type": "dimension",
    "width": { "$value": { "value": 1, "unit": "px" } }
  },
  "layout": {
    "$type": "dimension",
    "$description": "Mu web shell (src/components/Layout/const.ts, src/view/shell/desktop)",
    "centerWidth": { "$value": { "value": 600, "unit": "px" } },
    "centerOffset": {
      "$value": { "value": -105, "unit": "px" },
      "$description": "the column moves left between 1100 and 1300px"
    },
    "leftNavWidth": { "$value": { "value": 240, "unit": "px" } },
    "leftNavMinimalWidth": { "$value": { "value": 80, "unit": "px" } },
    "rightRailWidth": { "$value": { "value": 300, "unit": "px" } },
    "rightRailNarrowWidth": { "$value": { "value": 250, "unit": "px" } },
    "headerHeight": {
      "$value": { "value": 52, "unit": "px" },
      "$description": "web; 48 on native"
    },
    "headerSlot": { "$value": { "value": 33, "unit": "px" } },
    "navItem": { "$value": { "value": 48, "unit": "px" } },
    "navIcon": { "$value": { "value": 28, "unit": "px" } }
  },
  "avatar": {
    "$type": "dimension",
    "feed": { "$value": { "value": 42, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Data only: a custom property cannot sit inside @media, write css.media(\"(width >= 800px)\")",
    "phone": { "$value": { "value": 500, "unit": "px" } },
    "mobile": { "$value": { "value": 800, "unit": "px" } },
    "rightRail": { "$value": { "value": 1100, "unit": "px" } },
    "tablet": { "$value": { "value": 1300, "unit": "px" } }
  }
}
